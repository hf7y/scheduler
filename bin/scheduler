#!/usr/bin/env bash
# scheduler -- quick navigation into the scheduler's own tracking files, so
# "what's going on / what needs me" doesn't require hunting through nested
# project folders. No args = one-screen glance; subcommands jump straight
# into a file in $EDITOR (vim if unset). Read-only glance, editor commands
# open real files (or symlinks into each project's real .claude/ files) --
# this is a thin wrapper, not a parser/database; see
# .claude/scheduler/FOCUS.md item 3 for the fuller "glance command" design
# this is a first cut of.
set -uo pipefail

SCHED_ROOT="/home/zach/Documents/Project Archive/scheduler"
REPORTS_ROOT="$HOME/reports"
EDITOR="${EDITOR:-vim}"
PACED_LOG="$HOME/.local/share/scheduler-paced-runner/run.log"
PACED_CONF="$SCHED_ROOT/schedule/_paced.conf"
PACED_PTR="$HOME/.local/share/scheduler-paced-runner/rotation.idx"

# load_paced_pool -- parses PACED_CONF the exact same way
# bin/usage-paced-runner.sh does (name|enabled|[weight|]command, weight
# defaults to 1, repeated N times in the pool for a weight-N participant)
# so `scheduler next`/`run`/`weight` stay in lockstep with what the real
# runner will actually do -- no second source of truth for this parsing.
# Populates the global arrays POOL_NAMES/POOL_CMDS.
load_paced_pool() {
  POOL_NAMES=(); POOL_CMDS=()
  [ -f "$PACED_CONF" ] || return 1
  local name enabled rest weight maybe_weight cmd _w
  while IFS='|' read -r name enabled rest; do
    case "$name" in ''|\#*) continue ;; esac
    [ "${enabled// /}" = "1" ] || continue
    name="${name// /}"
    rest="${rest#"${rest%%[![:space:]]*}"}"
    weight=1
    case "$rest" in
      [0-9]*'|'*)
        maybe_weight="${rest%%|*}"
        if [[ "$maybe_weight" =~ ^[0-9]+$ ]] && [ "$maybe_weight" -ge 1 ]; then
          weight="$maybe_weight"
          rest="${rest#*|}"
          rest="${rest#"${rest%%[![:space:]]*}"}"
        fi
        ;;
    esac
    cmd="$rest"
    for ((_w=0; _w<weight; _w++)); do
      POOL_NAMES+=("$name"); POOL_CMDS+=("$cmd")
    done
  done < "$PACED_CONF"
  [ "${#POOL_NAMES[@]}" -gt 0 ]
}

# paced_conf_line <proj> -- raw schedule/_paced.conf line for a project, or
# empty + nonzero exit if it isn't a paced participant (enabled or not).
paced_conf_line() {
  grep -E "^${1}\|" "$PACED_CONF" 2>/dev/null
}

# project_cadence_seconds <proj> -- average real wall-clock gap between this
# project's last few DISPATCH lines in the paced runner's log (see
# bin/usage-paced-runner.sh). This is the ONLY timing signal available:
# there's no scheduled clock to read an ETA off of (paced projects run
# whenever usage-gate.sh reports spare quota, not on a fixed cadence), so an
# estimate has to come from how often this project has actually gotten a
# turn recently. Returns nothing (and a nonzero exit) if there aren't at
# least 2 samples yet -- callers must treat that as "no estimate", not 0.
project_cadence_seconds() {
  local proj="$1"
  [ -f "$PACED_LOG" ] || return 1
  local stamps=() ts
  while IFS= read -r ts; do stamps+=("$ts"); done < <(
    grep -E "DISPATCH \[[0-9]+/[0-9]+\] ${proj} ->" "$PACED_LOG" | awk '{print $1}' | tail -8
  )
  [ "${#stamps[@]}" -ge 2 ] || return 1
  local prev="" cur total=0 count=0
  for ts in "${stamps[@]}"; do
    cur="$(date -d "$ts" +%s 2>/dev/null)" || continue
    if [ -n "$prev" ]; then
      total=$(( total + (cur - prev) ))
      count=$(( count + 1 ))
    fi
    prev="$cur"
  done
  [ "$count" -gt 0 ] || return 1
  echo $(( total / count ))
}

# fmt_duration <seconds> -- human-readable, capped at day/hour/minute
# granularity (this is a rough estimate, not a precise countdown).
fmt_duration() {
  local secs="${1:-0}"
  [ "$secs" -lt 0 ] 2>/dev/null && secs=0
  local days=$(( secs / 86400 )) hours=$(( (secs % 86400) / 3600 )) mins=$(( (secs % 3600) / 60 ))
  if [ "$days" -gt 0 ]; then printf '%dd %dh' "$days" "$hours"
  elif [ "$hours" -gt 0 ]; then printf '%dh %dm' "$hours" "$mins"
  else printf '%dm' "$mins"
  fi
}

usage() {
  cat <<'EOF'
usage: scheduler [command] [project]

  (no args)             one-screen glance: every registered project,
                         sorted by open question/blocker count (most
                         pressing first), a `*` marking anything changed
                         since you last opened it via this tool. Also
                         shows a rough per-project ETA (FOCUS.md backlog
                         size x that project's own recent paced-dispatch
                         cadence) and an overall "time to burn down every
                         backlog" estimate -- real history, not a promise.
  blockers [project] [n], -b
                         open BLOCKERS.md; with a project + number, jump vim
                         straight to that project's Nth open blocker bullet
  focus [project], -f   open a project's FOCUS.md (list projects if omitted)
  questions [project] [n], -q
                         open a project's QUESTIONS.md (list if omitted);
                         with a number, jump vim straight to that bullet
                         instead of opening at the top of the file
  report [project], -r  open a project's latest report (LATEST.md)
  next [n], -n           what usage-paced-runner.sh will actually dispatch
                         next, in real rotation order (reads its rotation
                         pointer + this session's _paced.conf weights --
                         same round-robin math the runner itself uses, no
                         new state). Defaults to the next 8 slots.
  run <project>          dispatch one project's paced wrapper right now,
                         bypassing usage-gate.sh (each wrapper is already
                         self-contained: own flock + logging). Works even
                         if the project is currently disabled in
                         _paced.conf -- runs it once, doesn't re-enable it.
  overview <project>, -o
                         one screen: that project's `## Stability
                         milestone` checklist straight out of FOCUS.md (if
                         it has one). For git/questions/blockers detail see
                         `scheduler status <project>`.
  weight <project> [n]  show (no n) or set (with n) a project's
                         schedule/_paced.conf pace weight. Setting it also
                         drops a `.idea` note in realisateur's inbox so its
                         next pass knows a human overrode its last-set
                         value (see docs/priority-weight.md -- the number
                         itself is realisateur's judgment call, this
                         command only edits + flags, never silently).
  paced, -p              open schedule/_paced.conf directly (enable/disable
                         participants, reorder round-robin tie-breaks)
  pacing [show] [-h]     usage-paced-runner.sh's tick interval + max
                         dispatches/tick, the live usage-gate.sh verdict, and
                         a drift check between repo bin/*.sh and their
                         deployed ~/.local/bin copies (defaults to `show`).
                         -h/--human: plain-English translation of the gate
                         numbers instead of the raw util/burnline/slack line
  pacing tick '<cron>'  set schedule/_runner.conf's RUNNER_CRON (how often
                         the dispatcher ticks), re-sync + apply the real
                         crontab, and commit
  pacing max <n>         set PACED_MAX_PER_TICK (dispatches allowed per tick
                         before yielding back to cron even if usage-gate.sh
                         still says RUN), re-sync + apply, and commit
  pacing deploy [script] copy drifted repo bin/*.sh over their stale
                         ~/.local/bin/ counterpart (all drifted scripts if
                         no name given) -- the manual step `pacing show`'s
                         DRIFT lines are telling you to take
  idea <project> "text", -i
                         drop a new idea/feature-request for a project
                         without opening an editor. realisateur gets a new
                         .idea file (its own real inbox convention); every
                         other project gets a timestamped line inserted
                         into its FOCUS.md backlog/feature-request section
                         (or a new "Ideas" section, created if the project
                         has no FOCUS.md yet)
  sweep, -s              reactive backstop for the vim auto-commit hook --
                         scans every registered repo (+ scheduler itself)
                         for uncommitted/unpushed/diverged state the hook
                         may have missed (e.g. a long-running vim session
                         that predates a ~/.vimrc change never fires new
                         autocmds). Safely auto-commits AND pushes dirty
                         *.md files one at a time (same tested logic as
                         `-i`; auto-push skipped and left local-only if
                         behind origin); never
                         touches non-.md files or attempts to resolve a
                         genuine ahead+behind divergence -- those are only
                         ever reported, never auto-resolved.
  explain, -e            print a plain-English walkthrough of how the
                         whole system actually works right now (paced vs.
                         cron dispatch, the review/push/merge gates,
                         where scope + questions live and how a reply
                         round-trips) -- for YOUR understanding, not
                         another design doc for an agent to read.
  status <project>, -c  offline (no AI) deep-dive on one project: git
                         health (dirty/ahead/behind/diverged, + dedicated
                         clone divergence), pending %%TAG/`> ` feedback
                         (via collect-feedback.sh), each FOCUS.md backlog
                         item with a rough cumulative ETA off this
                         project's own recent paced-dispatch cadence, open
                         QUESTIONS.md entries, and the last scheduled run's
                         outcome from its log. Append --claude for a one-shot
                         read-only `claude -p` narrated summary of the
                         same report, or --interactive (-I) to drop into
                         a live `claude` session in the project's repo
                         preloaded with it as starting context.

Examples: scheduler -b   |   scheduler focus crt   |   scheduler report wtul
          scheduler -i realisateur "a browser extension that ..."
          scheduler -i wtul "add a --dry-run flag to wtul-rip"
          scheduler -s
          scheduler status realisateur
          scheduler status realisateur --claude
          scheduler status realisateur --interactive
EOF
}

cmd_explain() {
  # A "here's what happens when you do X" walkthrough for the human, not
  # another design doc for an agent -- see FOCUS.md "Current focus" item 2
  # (2026-07-20): "write a clear, honest explainer of how the current
  # system actually works, for the user's own understanding". Describes
  # the system AS IT EXISTS TODAY only -- no AUTONOMY_TIER, no merged
  # report/questions file, no scheduler-owned scope; those are roadmap
  # items in FOCUS.md, not built yet, and don't belong here until they are.
  cat <<'EOF'
scheduler -- how it actually works today

WHAT RUNS, AND WHEN
  Each registered project has a schedule/<project>.conf. A project's jobs
  fall into one of two dispatch shapes:
    - cron-timed: a fixed crontab entry (see `crontab -l`, installed from
      schedule/*.conf by bin/sync-crontab.sh -- never edit crontab by hand).
    - paced: no fixed time. bin/usage-paced-runner.sh rotates through every
      paced project on a short interval and asks bin/usage-gate.sh "do I
      have spare weekly/5-hour quota right now?" (a live probe against
      YOUR real account-wide usage, not a guess). If yes, the next project
      in rotation gets its turn; if no, nothing runs until quota frees up.
      This is why paced projects show "NEXT: paced (#N/M)" in `scheduler`
      instead of a clock time -- there isn't one.
  Either way, the actual job is one call to bin/scheduler-run
  <project> <sweep|batch>, which sources that project's conf and hands off
  to lib/sweep-loop-common.sh -- ONE shared engine every project runs
  through, not a bespoke script per project. (A project can still pin a
  legacy <TIER>_SCRIPT wrapper instead; scheduler-run refuses to run
  for that tier and says so, rather than silently double-running it.)

WHAT A RUN ACTUALLY DOES
  The engine clones (or reuses a dedicated local clone of) the project's
  REPO_URL fresh, resets hard to origin, reads that project's own
  FOCUS.md/QUESTIONS.md from the checkout it just made (not from any
  symlink you might have open), and runs `claude -p` with that project's
  own prompt. Whatever it changes, it commits there, in that checkout --
  never anywhere else.

REVIEW GATES -- WHO PUSHES, WHO MERGES
  This differs per project and is controlled by each conf, not a single
  global rule:
    - PUSH to the remote: most projects commit locally only, for a human
      to review and push by hand. A project can be explicitly upgraded to
      push its own commits straight to origin (scheduler itself has been,
      since 2026-07-18) -- but even then, every such push MUST be flagged
      in that run's report (what, why, how to `git revert` it). Pushing
      is never silent just because it's allowed.
    - MERGE into local main: separately, bin/scheduler-dev-cycle.sh can
      merge a finished paced cycle's branch into local main right after
      the cycle, controlled by a toggle file
      (~/.local/share/scheduler-paced-dev/merge_mode: "merge" or
      "branch"), independent of whether anything ever reaches origin.
  Bottom line: "committed" does NOT mean "pushed", and "pushed" does NOT
  mean "some other project got auto-merged into" -- check the specific
  project's own policy notes in FOCUS.md before assuming either.

WHERE SCOPE AND QUESTIONS LIVE, AND HOW A REPLY ROUND-TRIPS
  Each project owns its own FOCUS.md (scope + backlog, one file, no
  separate TODO.md) and QUESTIONS.md (append-only log of things needing a
  human decision) inside its own repo, today. `scheduler`'s focus/ and
  questions/ folders are symlinks INTO each project's checkout for your
  convenience -- editing through the symlink edits the real file, but a
  clone-based run never reads through the symlink; it reads its own fresh
  clone of the same repo, so your edit still has to be committed (and, if
  that project doesn't auto-push, pushed) before the next run's clone
  will see it.
  To answer a question: open it (`scheduler questions <project>`), write
  a `> ` reply directly under the entry, save. The next run of that
  project is expected to call bin/collect-feedback.sh --consume against
  its own QUESTIONS.md, which reads your `> ` reply and deletes that
  question's entry -- if a project's own nightly-batch command skips that
  step, your reply sits there unread indefinitely (a real, previously-hit
  bug class; FOCUS.md's backlog tracks which projects still need this
  audited).

WHAT `scheduler` (THIS TOOL) DOES AND DOESN'T DO
  It is a thin, read-only-by-default navigation wrapper around the real
  files above -- `scheduler` with no args prints one glance screen built
  fresh from questions/*.md, BLOCKERS.md, and each project's FOCUS.md
  every time you run it (no cache, no daemon); `scheduler <verb>
  [project]` just execs $EDITOR on the real file. `scheduler sweep` is
  the one exception that writes on its own: a reactive backstop that
  auto-commits (and, where safe, auto-pushes) dirty *.md files a vim
  autocmd hook may have missed -- it never touches non-.md files and
  never resolves a genuine ahead+behind divergence itself, only reports
  it. Nothing this tool does merges a branch or deploys anything.

WHAT'S NOT BUILT YET (don't assume these exist)
  - AUTONOMY_TIER (a per-project push/merge/deploy trust dial) is
    designed in FOCUS.md but no conf sets it yet -- push/merge policy
    today lives only in each project's prose + the toggle file above.
  - A single merged report+questions file per project, and a `scheduler
    blockers` that's a live aggregated view instead of a hand-maintained
    BLOCKERS.md, are both designed but not built -- BLOCKERS.md today is
    a real separate file someone has to remember to update.
  - No project has moved off having a local checkout; the
    "scheduler owns scope, runs from anywhere" design is groundwork only.
EOF
}

projects() {
  for conf in "$SCHED_ROOT"/schedule/*.conf; do
    b="$(basename "$conf" .conf)"
    [[ "$b" == _* ]] && continue
    echo "$b"
  done
}

SEEN_FILE="$HOME/.local/share/scheduler-glance/seen.tsv"

mark_seen() {
  # Records "you looked at this" per project/key so cmd_glance can flag
  # what changed since your last look with `*` (2026-07-22, addressing
  # "questions/blockers view is meaningless to me" -- a bare open count
  # doesn't say whether it's something you've never seen or something
  # you already know about and haven't gotten to). Deliberately a plain
  # tsv, not a database -- same style as everything else here.
  local key="$1" now
  now="${2:-$(date +%s)}"
  mkdir -p "$(dirname "$SEEN_FILE")"
  touch "$SEEN_FILE"
  grep -v "^${key}	" "$SEEN_FILE" > "$SEEN_FILE.tmp" 2>/dev/null || true
  { cat "$SEEN_FILE.tmp" 2>/dev/null; printf '%s\t%s\n' "$key" "$now"; } > "$SEEN_FILE"
  rm -f "$SEEN_FILE.tmp"
}

get_seen() {
  local key="$1"
  [ -f "$SEEN_FILE" ] && awk -F'\t' -v k="$key" '$1==k{print $2; found=1} END{if(!found) print 0}' "$SEEN_FILE" || echo 0
}

open_file() {
  local path="$1"
  if [ ! -e "$path" ]; then
    echo "scheduler: no file yet at $path" >&2
    exit 1
  fi
  exec "$EDITOR" "$path"
}

require_project() {
  local kind="$1" proj="${2:-}"
  if [ -z "$proj" ]; then
    echo "available projects:"
    projects | sed 's/^/  /'
    echo
    echo "usage: scheduler $kind <project>"
    exit 1
  fi
}

conf_field() {
  local proj="$1" field="$2"
  local conf="$SCHED_ROOT/schedule/$proj.conf"
  [ -f "$conf" ] || return 1
  grep -E "^${field}=" "$conf" | head -1 | cut -d= -f2- | tr -d '"'
}

resolve_focus_path() {
  local proj="$1"
  local repo_path subdir
  repo_path="$(conf_field "$proj" PROJECT_REPO_PATH)"
  if [ -z "$repo_path" ]; then
    echo "scheduler: no such project '$proj', or it has no PROJECT_REPO_PATH set" >&2
    return 1
  fi
  subdir="$(conf_field "$proj" SCHEDULER_SUBDIR)"
  echo "$repo_path/${subdir:-.claude}/FOCUS.md"
}

cmd_idea() {
  local proj="${1:-}" text="${2:-}"
  if [ -z "$proj" ] || [ -z "$text" ]; then
    echo "usage: scheduler idea <project> \"idea text\""
    echo
    echo "available projects:"
    projects | sed 's/^/  /'
    exit 1
  fi

  if [ "$proj" = "realisateur" ]; then
    local repo_path
    repo_path="$(conf_field realisateur PROJECT_REPO_PATH)"
    if [ -z "$repo_path" ]; then
      echo "scheduler: realisateur has no PROJECT_REPO_PATH set" >&2
      exit 1
    fi
    local slug ts file
    ts="$(date +%Y%m%d-%H%M%S)"
    slug="$(printf '%s' "$text" | tr -c 'a-zA-Z0-9' '-' | tr -s '-' | cut -c1-30 | sed 's/^-*//; s/-*$//')"
    [ -n "$slug" ] || slug="idea"
    file="$repo_path/${slug}-${ts}.idea"
    printf '%s\n' "$text" > "$file"
    echo "dropped: $file"
    echo "(realisateur's own inbox convention -- picked up + archived by its next nightly-batch cycle)"
    cmd_commit_file "$file" "Idea added via \`scheduler -i\`: $(basename "$file")"
    return
  fi

  local focus_path
  focus_path="$(resolve_focus_path "$proj")" || exit 1
  local ts="$(date '+%Y-%m-%d %H:%M')"
  local line="- **$ts (via \`scheduler -i\`):** $text"

  if [ ! -f "$focus_path" ]; then
    mkdir -p "$(dirname "$focus_path")"
    {
      echo "<!-- Per-project scope marker -- this file was CREATED by"
      echo "     \`scheduler -i\` from a dropped idea. It's just that idea,"
      echo "     not a real scope doc yet -- flesh this out properly, or at"
      echo "     least confirm it before the next unattended run treats it"
      echo "     as gospel. -->"
      echo
      echo "## Ideas (added via \`scheduler -i\`)"
      echo
      echo "$line"
    } > "$focus_path"
    echo "created: $focus_path"
    cmd_commit_file "$focus_path" "Idea added via \`scheduler -i\`: $(basename "$focus_path")"
    return
  fi

  if awk -v IGNORECASE=1 '/^#+.*(backlog|feature request)/{f=1} END{exit !f}' "$focus_path"; then
    awk -v IGNORECASE=1 -v line="$line" '
      { print }
      !done && /^#+.*(backlog|feature request)/ { print ""; print line; done=1 }
    ' "$focus_path" > "$focus_path.tmp" && mv "$focus_path.tmp" "$focus_path"
    echo "inserted into backlog/feature-request section: $focus_path"
  else
    {
      echo
      echo "## Ideas (added via \`scheduler -i\`)"
      echo
      echo "$line"
    } >> "$focus_path"
    echo "appended new section to: $focus_path"
  fi
  cmd_commit_file "$focus_path" "Idea added via \`scheduler -i\`: $(basename "$focus_path")"
}

RUNNER_CONF="$SCHED_ROOT/schedule/_runner.conf"

runner_conf_field() {
  local field="$1"
  [ -f "$RUNNER_CONF" ] || return 1
  grep -E "^${field}=" "$RUNNER_CONF" | tail -1 | cut -d= -f2- | tr -d '"'
}

# deployable_scripts -- every repo bin/ file that also exists as a REAL
# (non-symlinked) file at the same basename under ~/.local/bin. Those are
# the ones that can drift: a manual `cp` deploy step, not the live
# symlink `scheduler` itself uses. Shared by `pacing`'s drift report and
# its `deploy` action so there's one definition of "in scope".
deployable_scripts() {
  local f b dep
  for f in "$SCHED_ROOT"/bin/*.sh "$SCHED_ROOT/bin/scheduler"; do
    b="$(basename "$f")"
    dep="$HOME/.local/bin/$b"
    [ -e "$dep" ] || continue
    [ -L "$dep" ] && continue
    echo "$b"
  done
}

# pacing_show_human -- translate usage-gate.sh's key=val + summary lines
# into plain English. Takes the gate's stdout+stderr as $1.
pacing_show_human() {
  local out="$1" verdict window
  verdict="$(printf '%s\n' "$out" | grep -oE 'verdict=[A-Z]+' | cut -d= -f2)"
  if [ "$verdict" = "RUN" ]; then
    echo "Jobs are allowed to run right now -- you're using less than your fair"
    echo "share of quota for this point in the billing window."
  elif [ "$verdict" = "HOLD" ]; then
    echo "Jobs are paused right now -- either you're on pace to spend the"
    echo "window's quota already, or a safety ceiling/rejection kicked in."
  else
    echo "Couldn't read live usage (probe failed) -- treated as paused, just in case."
  fi
  echo
  while IFS= read -r window; do
    [ -n "$window" ] || continue
    local label util burnline slack resets
    label="$(printf '%s\n' "$window" | grep -oE '^window=\S+' | cut -d= -f2)"
    util="$(printf '%s\n' "$window" | grep -oE 'util=[0-9.]+' | cut -d= -f2)"
    burnline="$(printf '%s\n' "$window" | grep -oE 'burnline=[0-9.]+' | cut -d= -f2)"
    slack="$(printf '%s\n' "$window" | grep -oE 'slack=[-+0-9.]+' | cut -d= -f2)"
    resets="$(printf '%s\n' "$window" | grep -oE 'resets_in_min=[0-9]+' | cut -d= -f2)"
    [ -n "$label" ] || continue
    local util_pct burnline_pct verb amount
    util_pct="$(awk -v u="$util" 'BEGIN{printf "%.0f", u*100}')"
    burnline_pct="$(awk -v b="$burnline" 'BEGIN{printf "%.0f", b*100}')"
    if awk -v s="$slack" 'BEGIN{exit !(s>=0)}'; then verb="under"; else verb="over"; fi
    amount="$(awk -v s="$slack" 'BEGIN{v=s; if(v<0)v=-v; printf "%.0f", v*100}')"
    local win_name="$label window"
    [ "$label" = "5h" ] && win_name="rolling 5-hour window"
    [ "$label" = "7d" ] && win_name="rolling 7-day window"
    echo "  $win_name: ${util_pct}% used, expected ~${burnline_pct}% by now -- ${amount}pts $verb pace"
    [ -n "$resets" ] && echo "    resets in ${resets} min"
  done < <(printf '%s\n' "$out" | grep '^window=')
  local drift
  drift="$(printf '%s\n' "$out" | grep '^hold_reasons=')"
  [ -n "$drift" ] && { echo; echo "  ($drift)"; }
}

cmd_pacing_show() {
  local human=0
  case "${1:-}" in -h|--human) human=1 ;; esac
  local cron env max
  cron="$(runner_conf_field RUNNER_CRON)"
  env="$(runner_conf_field RUNNER_ENV)"
  max="$(printf '%s\n' "$env" | grep -oE 'PACED_MAX_PER_TICK=[0-9]+' | cut -d= -f2)"
  [ -n "$max" ] || max="8 (default -- not overridden in RUNNER_ENV)"
  echo "scheduler pacing -- usage-paced-runner.sh dispatch cadence"
  echo
  if [ "$human" = 1 ]; then
    echo "  Background jobs get checked every ${cron:-<unset -- no tick installed>} for whether"
    echo "  they're allowed to run, and up to $max can fire per check."
  else
    echo "  tick interval:       ${cron:-<unset -- no _runner.conf tick installed>}"
    echo "  max dispatches/tick: $max"
  fi
  echo
  echo "live gate (usage-gate.sh, account-wide):"
  if [ -x "$HOME/.local/bin/usage-gate.sh" ]; then
    local gate_out
    gate_out="$("$HOME/.local/bin/usage-gate.sh" 2>&1)"
    if [ "$human" = 1 ]; then
      pacing_show_human "$gate_out" | sed 's/^/  /'
    else
      printf '%s\n' "$gate_out" | sed 's/^/  /'
    fi
  else
    echo "  (no ~/.local/bin/usage-gate.sh -- not deployed)"
  fi
  echo
  echo "deployed-copy drift (repo bin/ vs ~/.local/bin/, real files only):"
  local b any=0
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    any=1
    if diff -q "$SCHED_ROOT/bin/$b" "$HOME/.local/bin/$b" >/dev/null 2>&1; then
      echo "  OK    $b"
    else
      echo "  DRIFT $b   (repo has changes not deployed -- \`scheduler pacing deploy $b\`)"
    fi
  done < <(deployable_scripts)
  [ "$any" = 1 ] || echo "  (nothing deployable found)"
}

cmd_pacing_tick() {
  local newcron="$*"
  [ -n "$newcron" ] || { echo "usage: scheduler pacing tick '<cron-expr>'" >&2; exit 1; }
  local nf; nf="$(awk '{print NF}' <<<"$newcron")"
  [ "$nf" -eq 5 ] || { echo "scheduler: cron expr needs exactly 5 fields, got: $newcron" >&2; exit 1; }
  [ -f "$RUNNER_CONF" ] || { echo "scheduler: no $RUNNER_CONF -- pacing isn't set up" >&2; exit 1; }
  local old; old="$(runner_conf_field RUNNER_CRON)"
  if [ "$old" = "$newcron" ]; then
    echo "RUNNER_CRON already $newcron -- nothing to change"
    return 0
  fi
  sed -i "s|^RUNNER_CRON=.*|RUNNER_CRON=\"$newcron\"|" "$RUNNER_CONF"
  echo "RUNNER_CRON: ${old:-<unset>} -> $newcron"
  "$SCHED_ROOT/bin/sync-crontab.sh" --apply
  cmd_commit_file "$RUNNER_CONF" "scheduler pacing: tick interval ${old:-<unset>} -> $newcron"
}

cmd_pacing_max() {
  local n="${1:-}"
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] || { echo "usage: scheduler pacing max <positive integer>" >&2; exit 1; }
  [ -f "$RUNNER_CONF" ] || { echo "scheduler: no $RUNNER_CONF -- pacing isn't set up" >&2; exit 1; }
  local old_env old_max
  old_env="$(runner_conf_field RUNNER_ENV)"
  old_max="$(printf '%s\n' "$old_env" | grep -oE 'PACED_MAX_PER_TICK=[0-9]+' | cut -d= -f2)"
  [ -n "$old_max" ] || old_max="8 (default)"
  if [ "$old_max" = "$n" ]; then
    echo "PACED_MAX_PER_TICK already $n -- nothing to change"
    return 0
  fi
  if grep -q '^RUNNER_ENV=' "$RUNNER_CONF"; then
    sed -i "s|^RUNNER_ENV=.*|RUNNER_ENV=\"PACED_MAX_PER_TICK=$n\"|" "$RUNNER_CONF"
  else
    sed -i "/^RUNNER_CRON=/a RUNNER_ENV=\"PACED_MAX_PER_TICK=$n\"" "$RUNNER_CONF"
  fi
  echo "PACED_MAX_PER_TICK: $old_max -> $n"
  "$SCHED_ROOT/bin/sync-crontab.sh" --apply
  cmd_commit_file "$RUNNER_CONF" "scheduler pacing: max dispatches/tick $old_max -> $n"
}

cmd_pacing_deploy() {
  local target="${1:-}" b any=0
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    [ -n "$target" ] && [ "$b" != "$target" ] && continue
    if diff -q "$SCHED_ROOT/bin/$b" "$HOME/.local/bin/$b" >/dev/null 2>&1; then
      continue
    fi
    cp "$SCHED_ROOT/bin/$b" "$HOME/.local/bin/$b"
    chmod +x "$HOME/.local/bin/$b"
    echo "deployed $b -> $HOME/.local/bin/$b"
    any=1
  done < <(deployable_scripts)
  if [ "$any" = 0 ]; then
    if [ -n "$target" ]; then
      echo "scheduler: '$target' not drifted (or not a deployable script) -- nothing done"
    else
      echo "nothing to deploy -- all installed copies already match repo"
    fi
  fi
}

cmd_pacing() {
  case "${1:-}" in
    ""|-h|--human) cmd_pacing_show "${1:-}" ;;
    show) shift; cmd_pacing_show "${1:-}" ;;
    tick) shift; cmd_pacing_tick "$@" ;;
    max) cmd_pacing_max "${2:-}" ;;
    deploy) cmd_pacing_deploy "${2:-}" ;;
    *)
      echo "usage: scheduler pacing [show|-h|tick '<cron-expr>'|max <n>|deploy [script]]" >&2
      exit 1
      ;;
  esac
}

cmd_commit_file() {
  # THE single implementation of "safely auto-commit one file, with a
  # staleness warning first" -- shared by `scheduler -i` (calls this
  # directly, in-process) AND the vim auto-commit hook (shells out to
  # `scheduler _commit-file`, backgrounded, instead of re-implementing
  # this same git logic a second time in vimscript). Change behavior
  # here once, both callers get it. (Renamed from cmd_idea_push_reminder
  # 2026-07-20 when this stopped being idea-specific.)
  #
  # Auto-COMMITS and, as of 2026-07-22, auto-PUSHES too (changed from
  # "never automatic" -- Zach's own call: every commit through this path
  # is a single markdown file, exactly the "trivially revertible" class
  # already named in FOCUS.md's auto-push backlog note, and every
  # registered project's scheduled jobs run against a dedicated clone
  # that resets hard to origin before each dispatch -- a commit sitting
  # local-only is exactly as invisible to that clone as an uncommitted
  # edit, so withholding the push bought no real safety, just latency).
  # Still safe by construction: push is only attempted when NOT behind
  # origin (a real fast-forward), and a push failure here never forces or
  # rewrites anything -- it just falls back to the old "commit locally,
  # push by hand" message.
  local path="$1" msg="${2:-}" repo
  repo="$(git -C "$(dirname "$path")" rev-parse --show-toplevel 2>/dev/null)"
  [ -n "$repo" ] || return 0
  # `git diff --quiet` only sees changes to ALREADY-TRACKED files -- it is
  # silent (exit 0, "no differences") for a brand-new untracked file, which
  # made this bail out and skip committing entirely for exactly the case
  # (a freshly dropped .idea file) it most needed to handle. `git status
  # --porcelain` catches both untracked and modified.
  if [ -z "$(git -C "$repo" status --porcelain -- "$path" 2>/dev/null)" ]; then
    return 0
  fi
  # Freshness check BEFORE committing -- the actual fix for "do I need to
  # git fetch && git status by hand before every edit" (2026-07-20): no,
  # the tool checks instead. Doesn't block the commit (the file content is
  # always safe to keep locally regardless), just warns loudly if this
  # commit is about to land on a stale base, which is exactly the failure
  # mode that caused a real divergence (home-assistant, same day). `git
  # fetch` against a local bare remote (~/git-remotes/*.git, most projects
  # here) is effectively instant; against a real GitHub remote it's a
  # normal network round-trip -- worth it for what it catches.
  local branch behind
  branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  git -C "$repo" fetch --quiet 2>/dev/null
  behind="$(git -C "$repo" rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)"
  if [ "${behind:-0}" -gt 0 ] 2>/dev/null; then
    echo "NOTE: $repo is $behind commit(s) behind origin/$branch -- committing anyway (your edit is safe), but pull/merge before pushing to avoid a real divergence"
  fi
  [ -n "$msg" ] || msg="Human edit via scheduler: $(basename "$path") ($(date '+%Y-%m-%dT%H:%M'))"
  if git -C "$repo" add -- "$path" && git -C "$repo" commit -q -m "$msg" -- "$path"; then
    if [ "${behind:-0}" -eq 0 ] 2>/dev/null && git -C "$repo" push --quiet 2>/dev/null; then
      echo "committed + pushed in $repo"
    else
      echo "committed locally in $repo -- run 'git -C \"$repo\" push' by hand (auto-push skipped: $([ "${behind:-0}" -gt 0 ] 2>/dev/null && echo "behind origin, resolve divergence first" || echo "push failed, check credentials/network"))"
    fi
  else
    echo "(auto-commit failed -- left as an uncommitted edit at $path; commit by hand)" >&2
  fi
}

cmd_next() {
  local count="${1:-8}"
  case "$count" in ''|*[!0-9]*) count=8 ;; esac
  load_paced_pool || { echo "scheduler: no enabled participants in $PACED_CONF" >&2; exit 1; }
  local n="${#POOL_NAMES[@]}"
  local last=-1
  [ -f "$PACED_PTR" ] && last="$(cat "$PACED_PTR" 2>/dev/null || echo -1)"
  case "$last" in ''|*[!0-9-]*) last=-1 ;; esac
  echo "scheduler next -- real usage-paced-runner.sh rotation order (dispatched whenever"
  echo "usage-gate.sh reports spare weekly quota, NOT a fixed clock -- see run.log for when)"
  echo
  local i idx
  for ((i=1; i<=count && i<=n; i++)); do
    idx=$(( (last + i) % n ))
    printf '  %2d. %s\n' "$i" "${POOL_NAMES[$idx]}"
  done
  echo
  echo "(rotation pool size $n, incl. weight-repeats -- see schedule/_paced.conf/scheduler weight;"
  echo " last actually dispatched pool slot: $last -- see ~/.local/share/scheduler-paced-runner/run.log)"
}

cmd_run() {
  local proj="${1:-}"
  if [ -z "$proj" ]; then
    echo "usage: scheduler run <project>"
    echo
    echo "paced participants:"
    awk -F'|' '$1!~/^#/ && $1!="" {print "  "$1}' "$PACED_CONF" 2>/dev/null
    exit 1
  fi
  local line
  line="$(paced_conf_line "$proj")"
  if [ -z "$line" ]; then
    echo "scheduler: '$proj' is not a participant in $PACED_CONF" >&2
    exit 1
  fi
  local name enabled rest maybe_weight cmd
  IFS='|' read -r name enabled rest <<<"$line"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  case "$rest" in
    [0-9]*'|'*)
      maybe_weight="${rest%%|*}"
      if [[ "$maybe_weight" =~ ^[0-9]+$ ]]; then rest="${rest#*|}"; fi
      ;;
  esac
  cmd="${rest%%#*}"
  cmd="$(printf '%s' "$cmd" | sed -e 's/[[:space:]]*$//')"
  if [ "${enabled// /}" != "1" ]; then
    echo "NOTE: $proj is disabled (enabled=0) in _paced.conf -- running it once anyway;"
    echo "it stays out of the automatic rotation until you re-enable it there."
  fi
  echo "scheduler run: dispatching $proj -> $cmd (bypassing usage-gate.sh, one cycle, right now)"
  # shellcheck disable=SC2086
  exec $cmd
}

cmd_overview() {
  local proj="$1"
  local ffile="$SCHED_ROOT/focus/$proj.md"
  echo "scheduler overview: $proj -- $(date '+%Y-%m-%d %H:%M')"
  echo
  if [ ! -f "$ffile" ]; then
    echo "no FOCUS.md at $ffile yet"
    return
  fi
  if grep -q '^## Stability milestone' "$ffile"; then
    awk '
      /^## Stability milestone/ { p=1; print; next }
      p && /^## / { exit }
      p { print }
    ' "$ffile"
  else
    echo "no \"## Stability milestone\" section in $ffile yet -- this project hasn't had"
    echo "one drafted (see realisateur/STABILITY-MILESTONES.md for the convention)"
  fi
  echo
  echo "-> scheduler status $proj   for git/questions/blockers/run-log detail"
}

cmd_weight() {
  local proj="${1:-}" newval="${2:-}"
  if [ -z "$proj" ]; then
    echo "usage: scheduler weight <project> [n]"
    exit 1
  fi
  local line
  line="$(paced_conf_line "$proj")"
  if [ -z "$line" ]; then
    echo "scheduler: '$proj' is not a participant in $PACED_CONF" >&2
    exit 1
  fi
  local name enabled rest maybe_weight cur_weight=1 tail_field
  IFS='|' read -r name enabled rest <<<"$line"
  tail_field="${rest#"${rest%%[![:space:]]*}"}"
  case "$tail_field" in
    [0-9]*'|'*)
      maybe_weight="${tail_field%%|*}"
      if [[ "$maybe_weight" =~ ^[0-9]+$ ]]; then
        cur_weight="$maybe_weight"
        tail_field="${tail_field#*|}"
      fi
      ;;
  esac

  if [ -z "$newval" ]; then
    echo "$proj: weight=$cur_weight enabled=$enabled"
    return
  fi
  if ! [[ "$newval" =~ ^[0-9]+$ ]] || [ "$newval" -lt 1 ]; then
    echo "scheduler: weight must be a positive integer" >&2
    exit 1
  fi
  if [ "$newval" = "$cur_weight" ]; then
    echo "$proj: weight already $cur_weight, nothing to change"
    return
  fi

  local newline="${name}|${enabled}|${newval}|${tail_field}"
  awk -v proj="$proj" -v newline="$newline" -F'|' '
    $1==proj { print newline; next } { print }
  ' "$PACED_CONF" > "$PACED_CONF.tmp" && mv "$PACED_CONF.tmp" "$PACED_CONF"
  echo "set $proj weight: $cur_weight -> $newval"
  cmd_commit_file "$PACED_CONF" "scheduler weight: $proj $cur_weight -> $newval (human override via \`scheduler weight\`)"

  # Flag the override for realisateur -- same .idea inbox convention as
  # `scheduler idea realisateur "..."` (see docs/priority-weight.md: the
  # weight VALUE is realisateur's judgment call, this command only edits +
  # flags, never silently overrides its next pass without a trace).
  local repo_path
  repo_path="$(conf_field realisateur PROJECT_REPO_PATH)"
  if [ -n "$repo_path" ]; then
    local ts idea_file
    ts="$(date +%Y%m%d-%H%M%S)"
    idea_file="$repo_path/weight-override-${proj}-${ts}.idea"
    printf 'Human set %s pace weight %s -> %s directly in _paced.conf via `scheduler weight` on %s. FYI, not a request to revert it -- just flagging the override so your next pass has the full picture instead of assuming its own last-set value still holds.\n' \
      "$proj" "$cur_weight" "$newval" "$(date '+%Y-%m-%d %H:%M')" > "$idea_file"
    echo "flagged for realisateur: $idea_file"
  fi
}

cmd_questions_jump() {
  local proj="$1" idx="$2"
  local qfile="$SCHED_ROOT/questions/$proj.md"
  [ -f "$qfile" ] || { echo "scheduler: no file yet at $qfile" >&2; exit 1; }
  local lineno
  lineno="$(awk -v want="$idx" '
    BEGIN{infence=0; n=0}
    /^```/ { infence=!infence; next }
    infence { next }
    /^- \*\*/ { n++; if (n==want) { print NR; exit } }
  ' "$qfile")"
  if [ -z "$lineno" ]; then
    echo "scheduler: no question #$idx in $qfile" >&2
    exit 1
  fi
  exec "$EDITOR" "+$lineno" "$qfile"
}

cmd_blockers_jump() {
  local proj="$1" idx="$2"
  [ -f "$SCHED_ROOT/BLOCKERS.md" ] || { echo "scheduler: no BLOCKERS.md yet" >&2; exit 1; }
  local lineno
  lineno="$(awk -v want_proj="$proj" -v want="$idx" '
    BEGIN{insec=0; n=0}
    /^##[ \t]/ { insec = (tolower($0) ~ ("## *" tolower(want_proj) "$")); next }
    insec && /^- \*\*/ { n++; if (n==want) { print NR; exit } }
  ' "$SCHED_ROOT/BLOCKERS.md")"
  if [ -z "$lineno" ]; then
    echo "scheduler: no blocker #$idx for '$proj' in BLOCKERS.md" >&2
    exit 1
  fi
  exec "$EDITOR" "+$lineno" "$SCHED_ROOT/BLOCKERS.md"
}

cmd_glance() {
  echo "scheduler — $(date '+%Y-%m-%d %H:%M') (paced rotation, dispatched whenever usage-gate.sh has spare quota)"
  echo
  printf '  %-16s %-10s %-9s %-10s %-10s %s\n' "PROJECT" "QUESTIONS" "BLOCKERS" "LAST RUN" "ETA" "NEXT UP"
  echo "  (* = changed since you last opened it here. QUESTIONS is unopened/total --"
  echo "  total includes ones you've already replied to inline but whose project run"
  echo "  hasn't processed yet; see 'scheduler questions <project>' or the man-page-ish"
  echo "  notes in \`scheduler\` usage/docs/feedback-tags.md for what 'total' counts."
  echo "  LAST RUN is the age of that project's ~/reports/<project>/LATEST.md (a"
  echo "  proxy for its last completed run, not a scheduler-tracked timestamp)."
  echo "  NEXT UP is 1/<FOCUS.md backlog size>: <top item's title> -- just what the"
  echo "  next run reads first, may reprioritize instead of clearing it outright."
  echo "  ETA is FOCUS.md backlog size x this project's own average recent gap"
  echo "  between paced dispatches (from usage-paced-runner.sh's log) -- a rough"
  echo "  projection off real history, NOT a promise: assumes 1 backlog item"
  echo "  clears per cycle, backlog size stays fixed, and recent pace holds."
  echo "  'no history' = fewer than 2 recorded dispatches yet for that project.)"
  local any_blockers=0
  local global_eta_secs=0 global_eta_proj="" any_unknown_eta=0
  local any_unpushed=0
  local unpushed_list=""
  # Rows are collected as "<score>\t<rendered line>" and sorted by score
  # descending after the loop, so projects with open questions/blockers
  # float to the top instead of showing in registration/conf-file order
  # (flagged 2026-07-22: "why hasn't anything run" shouldn't require
  # reading top-to-bottom hunting for the one row that needs you). Score
  # is just q_unanswered + bn -- a rough stand-in for the fuller
  # quota/ETA-aware ordering still queued in FOCUS.md's backlog.
  local rows=""
  while IFS= read -r proj; do
    local qfile="$SCHED_ROOT/questions/$proj.md"
    local qlabel="-"
    if [ -f "$qfile" ]; then
      # Distinguishes genuinely unanswered questions from ones you've
      # already replied to inline but the project's next run hasn't yet
      # processed -- added 2026-07-20 so the glance count reflects your
      # own inline edits instead of only updating once a run clears the
      # block. A bullet counts as answered if a real `> ` reply (not the
      # "(answer inline here)" placeholder) appears before the next
      # bullet/heading; RESOLVED/ACKNOWLEDGED bullets are excluded
      # entirely either way (case-insensitive via tolower(), not just
      # the first letter -- a plain-ASCII "resolved|acknowledged" regex
      # match silently missed full-caps "RESOLVED" during testing).
      # Real question bullets always start `- **YYYY-MM-DD` (the format
      # every command is told to append) -- requiring that date prefix,
      # plus skipping fenced ``` code blocks, excludes the template's own
      # "How to answer" boilerplate (an example bullet inside a code
      # fence, plus prose bullets like "- **`/nightly-batch` owns
      # answer-processing.**") which a bare `/^- \*\*/` match was
      # wrongly counting as real open questions on every project using
      # the standard QUESTIONS.md template (found 2026-07-22: every
      # project showed 2-4 phantom "open questions" from this).
      read -r q_unanswered q_answered <<<"$(awk '
        BEGIN{unanswered=0; answered=0; is_resolved=0; has_reply=0; started=0; infence=0}
        /^```/ { infence = !infence; next }
        infence { next }
        /^- \*\*[0-9]{4}-[0-9]{2}-[0-9]{2}/ {
          if (started) { if (!is_resolved) { if (has_reply) answered++; else unanswered++ } }
          started=1
          is_resolved = (tolower($0) ~ /resolved|acknowledged/) ? 1 : 0
          has_reply=0
          next
        }
        started && /^[ \t]*>[ \t]?/ {
          line=$0
          sub(/^[ \t]*>[ \t]?/, "", line)
          if (line !~ /^\(answer inline here\)/) has_reply=1
        }
        END { if (started) { if (!is_resolved) { if (has_reply) answered++; else unanswered++ } }
              print unanswered, answered }
      ' "$qfile" 2>/dev/null)"
      q_unanswered="${q_unanswered:-0}"; q_answered="${q_answered:-0}"
      local q_total=$(( q_unanswered + q_answered ))
      if [ "$q_total" -gt 0 ] 2>/dev/null; then
        qlabel="$q_unanswered/$q_total"
      fi
      # `*` = this file changed since you last opened it via `scheduler
      # questions`/`status` -- added 2026-07-22 so an open count doesn't
      # read the same whether it's brand new or something you've already
      # seen and just haven't gotten to. Approximate (file mtime vs a
      # per-project "last opened" timestamp), not a real read-receipt.
      if [ "$q_unanswered" -gt 0 ] 2>/dev/null; then
        local qmtime qseen
        qmtime="$(stat -c %Y "$qfile" 2>/dev/null || echo 0)"
        qseen="$(get_seen "$proj")"
        [ "$qmtime" -gt "$qseen" ] 2>/dev/null && qlabel="*$qlabel"
      fi
    fi

    # Excludes bullets already marked RESOLVED/PARKED inline (BLOCKERS.md's
    # own convention -- e.g. crt's "- **OctoPrint** — **RESOLVED
    # 2026-07-20**: ...") -- a bare bullet count was showing crt as "7"
    # blockers when most of that section was already resolved/parked,
    # same "meaningless count" bug class as the questions fix above
    # (found 2026-07-22).
    local bn=0 bsection=""
    if [ -f "$SCHED_ROOT/BLOCKERS.md" ]; then
      bn="$(awk -v want="$proj" '
        BEGIN{c=0; insec=0}
        /^##[ \t]/ { insec = (tolower($0) ~ ("## *" tolower(want) "$")); next }
        insec && /^- \*\*/ { if (tolower($0) !~ /resolved|parked/) c++ }
        END { print c }
      ' "$SCHED_ROOT/BLOCKERS.md")"
      # Hashed per-project (not whole-file mtime, fixed 2026-07-22): the old
      # check flagged EVERY project with `*` whenever anyone's blocker entry
      # was edited anywhere in BLOCKERS.md -- e.g. updating crt's "DAC
      # arriving Tuesday" ETA note used to mark aedile's row stale too, even
      # though aedile's own section hadn't changed. Only this project's own
      # section content now drives its `*`.
      bsection="$(awk -v want="$proj" '
        /^##[ \t]/ { insec = (tolower($0) ~ ("## *" tolower(want) "$")); next }
        insec { print }
      ' "$SCHED_ROOT/BLOCKERS.md" | md5sum | cut -d" " -f1)"
    fi
    local blabel="-"
    if [ "$bn" -gt 0 ] 2>/dev/null; then
      blabel="$bn"
      any_blockers=1
      local bseen
      bseen="$(get_seen "blockers:$proj")"
      [ -n "$bsection" ] && [ "$bsection" != "$bseen" ] && blabel="*$blabel"
    fi

    # Cheap "what's coming" approximation: total bulleted backlog items
    # under a project's FOCUS.md (what its next run reads first to decide
    # scope -- see each FOCUS.md's own header comment), shown as "1/N" since
    # a run always picks up at the top item, plus that top item's own
    # bolded title as a keyword. NOT a scheduled time or a real "will finish
    # N of these" estimate -- most projects run on usage-gate.sh's paced
    # quota-based rotation, not a fixed cron slot, and one run may finish
    # the top item, partially land it, or reprioritize entirely. Skips
    # HTML-comment blocks (resolved-decision notes, not live scope) so
    # already-settled discussion doesn't inflate the count.
    local next="-" ffile="$SCHED_ROOT/focus/$proj.md"
    if [ -f "$ffile" ]; then
      local f_total f_keyword
      IFS=$'\t' read -r f_total f_keyword <<<"$(awk -F'\t' '
        /<!--/ { incomment=1 }
        /-->/ { incomment=0; next }
        incomment { next }
        # "Ideas (added via `scheduler -i`)" sections are an unprocessed
        # inbox dump, not scoped backlog -- realisateur/the next batch run
        # still has to triage them into real scope, so they should not
        # count or supply the keyword.
        # "backlog" alone is NOT a safe un-exclude signal -- some projects
        # (scheduler'"'"'s own FOCUS.md, aedile) literally name their raw
        # unprocessed-idea intake section "## Backlog (the intake -- ...)",
        # same dump semantics as an "Ideas" heading, just a different word.
        # "feature request" is the narrower, unambiguous phrase actually
        # used (only by home-assistant/realisateur) for a real, already-
        # scoped section -- see docs below for why this stays narrow.
        /^##/ {
          inideas = (tolower($0) ~ /ideas|intake/)
          in_scoped_backlog = (tolower($0) ~ /feature request/)
          in_priority_queue = (tolower($0) ~ /priority queue/)
          next
        }
        inideas { next }
        /^- \*\*/ {
          line=$0
          sub(/^- \*\*/, "", line)
          idx=index(line, "**")
          bullet = (idx>0) ? substr(line,1,idx-1) : line
          rest = (idx>0) ? substr(line, idx+2) : ""
          # Skip raw "YYYY-MM-DD (via `scheduler -i`/realisateur...)"
          # bullets UNLESS they are under a heading confirmed scoped (see
          # in_scoped_backlog above) -- most projects'"'"' FOCUS.md files
          # mix real backlog with a long history of dated DONE/deferred/
          # journal-style bullets (crt.md, scheduler.md itself) that look
          # identical in shape to a real backlog item but are not "what
          # the next run reads first" -- narrowed 2026-07-24 to also fix
          # home-assistant (a properly-sectioned `- ** 2026-07-20 ... (via
          # scheduler -i)` bullet under "## Feature requests / backlog"
          # was being excluded as if it were unsectioned noise) without
          # reopening that flood for every other project.
          if (!in_scoped_backlog && bullet ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}/) next
          total++
          if (total == 1) {
            keyword = bullet
            # A scoped bullet in cmd_idea'"'"'s own `scheduler -i` insertion
            # shape (`- **$ts (via `scheduler -i`):** $text`) bolds ONLY
            # the timestamp+source tag -- the real content sits unbolded
            # right after. If the bold span itself is a bare timestamp,
            # fall back to the first ~28 chars of that unbolded text
            # instead of showing a useless "2026-07-20 19:59 (via..." NEXT
            # UP keyword (found 2026-07-24 on home-assistant'"'"'s row).
            if (keyword ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}/) {
              sub(/^[ \t:]+/, "", rest)
              keyword = substr(rest, 1, 28)
            }
          }
          next
        }
        # Top-level numbered-list backlogs, scoped ONLY to a heading
        # literally named "Priority queue" (currently just chezz) --
        # added 2026-07-24. Deliberately NOT a blanket "any column-0
        # numbered line" rule: crt.md and scheduler.md own FOCUS.md are
        # full of unrelated column-0 numbered lists inside ordinary prose
        # (sequencing steps, roadmap reasoning, DONE-item lists) that are
        # NOT "what the next run reads first" -- a blanket rule silently
        # inflated crt from 11 to 63 and scheduler from 36 to 90 items
        # when first tried, all noise.
        in_priority_queue && /^[0-9]+\. / {
          line=$0
          sub(/^[0-9]+\.[ \t]*/, "", line)
          gsub(/\*\*/, "", line)
          total++
          if (total == 1) keyword = line
        }
        END { printf "%d\t%s\n", total+0, keyword }
      ' "$ffile" 2>/dev/null)"
      if [ -n "$f_total" ] && [ "$f_total" -gt 0 ] 2>/dev/null; then
        local kw="$f_keyword"
        [ "${#kw}" -gt 28 ] && kw="${kw:0:27}…"
        next="1/$f_total: $kw"
      fi
    fi

    # Stranded-push awareness (2026-07-24, closes the "make it loud for
    # ANY project, not just chezz/wtul" half of the credential-gap
    # backlog item -- `cmd_sweep`'s dedicated-clone pass already detects
    # this per-run, but only if you remember to run `scheduler sweep`
    # separately; this surfaces the same signal in the view you actually
    # open daily). Reads the dedicated clone's already-known local refs
    # (no fetch -- same no-network assumption `report_divergence` already
    # makes), so a real credential/push gap (root-caused 2026-07-24 for
    # chezz/wtul: commits succeed, the push silently no-ops) shows up here
    # instead of requiring a separate `sweep` run to notice.
    local job_name
    job_name="$(conf_field "$proj" BATCH_JOB_NAME)"
    [ -n "$job_name" ] || job_name="$(conf_field "$proj" SWEEP_JOB_NAME)"
    if [ -n "$job_name" ] && [ -d "$HOME/.local/share/$job_name/repo/.git" ]; then
      local clone="$HOME/.local/share/$job_name/repo"
      local cbranch cahead
      cbranch="$(git -C "$clone" rev-parse --abbrev-ref HEAD 2>/dev/null)"
      cahead="$(git -C "$clone" rev-list --count "origin/$cbranch..HEAD" 2>/dev/null || echo 0)"
      if [ "${cahead:-0}" -gt 0 ] 2>/dev/null; then
        any_unpushed=1
        unpushed_list="$unpushed_list$proj ($cahead unpushed), "
      fi
    fi

    # LAST RUN: age of ~/reports/<project>/LATEST.md, the same file `scheduler
    # report <project>` opens -- a proxy for "last completed run" (mtime
    # only updates when a run actually writes a report, never a scheduler-
    # tracked dispatch timestamp), added 2026-07-24 per the "add a last-run
    # column" backlog item. Rendered as a coarse age bucket (Xm/Xh/Xd ago) so
    # it's scannable at a glance rather than a raw timestamp.
    local lastrun="-" lfile="$REPORTS_ROOT/$proj/LATEST.md"
    if [ -f "$lfile" ]; then
      local lmtime lnow lage
      lmtime="$(stat -c %Y "$lfile" 2>/dev/null || echo 0)"
      lnow="$(date +%s)"
      lage=$(( lnow - lmtime ))
      if [ "$lage" -lt 3600 ]; then
        lastrun="$(( lage / 60 ))m ago"
      elif [ "$lage" -lt 86400 ]; then
        lastrun="$(( lage / 3600 ))h ago"
      else
        lastrun="$(( lage / 86400 ))d ago"
      fi
    fi

    # ETA: this project's own backlog size x its own recent dispatch cadence
    # (see project_cadence_seconds) -- deliberately per-project, not a share
    # of some global rate, since cadence already reflects this project's
    # rotation weight and how often the gate has actually let it run.
    local etalabel="-"
    if [ -n "$f_total" ] && [ "$f_total" -gt 0 ] 2>/dev/null; then
      local cadence
      cadence="$(project_cadence_seconds "$proj" 2>/dev/null)"
      if [ -n "$cadence" ] && [ "$cadence" -gt 0 ] 2>/dev/null; then
        local proj_eta=$(( cadence * f_total ))
        etalabel="~$(fmt_duration "$proj_eta")"
        if [ "$proj_eta" -gt "$global_eta_secs" ]; then
          global_eta_secs="$proj_eta"; global_eta_proj="$proj"
        fi
      else
        etalabel="no history"
        any_unknown_eta=1
      fi
    fi

    local score=$(( ${q_unanswered:-0} + ${bn:-0} ))
    local row
    row="$(printf '  %-16s %-10s %-9s %-10s %-10s %s' "$proj" "$qlabel" "$blabel" "$lastrun" "$etalabel" "$next")"
    rows="$rows$score"$'\t'"$row"$'\n'
  done < <(projects)
  printf '%s' "$rows" | sort -t $'\t' -k1,1rn | cut -f2-
  echo
  if [ "$global_eta_secs" -gt 0 ]; then
    echo "est. time to burn down every project's current FOCUS.md backlog: ~$(fmt_duration "$global_eta_secs") (bound by $global_eta_proj's own backlog x pace)$([ "$any_unknown_eta" = "1" ] && echo " -- some projects show 'no history' and aren't in this estimate")"
  fi
  if [ "$any_blockers" = "1" ]; then
    echo "-> scheduler blockers   (or: scheduler -b)"
  fi
  if [ "$any_unpushed" = "1" ]; then
    echo "-> stranded local commits in a dedicated clone (push likely failed silently): ${unpushed_list%, }"
    echo "   run 'scheduler sweep' for detail, or push by hand from that clone"
  fi
  echo "-> scheduler focus/questions/report <project> to jump straight in"
}

report_divergence() {
  # Shared by cmd_sweep and cmd_status -- reports (never resolves) how a
  # local branch stands vs its origin. Split out 2026-07-22 so the status
  # deep-dive doesn't reimplement this same ahead/behind/diverged check.
  local name="$1" path="$2"
  local branch ahead behind
  branch="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  ahead="$(git -C "$path" rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo 0)"
  behind="$(git -C "$path" rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)"
  if [ "${ahead:-0}" -gt 0 ] 2>/dev/null && [ "${behind:-0}" -gt 0 ] 2>/dev/null; then
    echo "== $name: ** DIVERGED from origin/$branch ** -- $ahead local-only, $behind remote-only commit(s). Needs a real merge decision -- NOT auto-resolved, ever."
  elif [ "${ahead:-0}" -gt 0 ] 2>/dev/null; then
    echo "== $name: $ahead commit(s) ahead of origin/$branch, not pushed (push always stays a human step)"
  elif [ "${behind:-0}" -gt 0 ] 2>/dev/null; then
    echo "== $name: $behind commit(s) behind origin/$branch"
  fi
}

# extra_branches <repo> -- print $repo's branches (local or on origin)
# beyond its default (main/master), one per line, nothing if there are
# none or it isn't a git repo. Ported from an early morning-report.sh
# draft (paced/2026-07-20, merged into `scheduler sweep` here instead --
# morning-report.sh itself is deprecated in favor of this CLI) so stray
# work like a `paced/<date>` branch that finished its review-gated cycle
# but was never merged doesn't just sit there unnoticed.
extra_branches() {
  local repo="$1"
  # .git is a FILE (not a directory) inside a git worktree -- use -e, not
  # -d, so this also covers this repo's own paced/<date> worktree.
  [ -e "$repo/.git" ] || return 0
  local default
  default="$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"
  default="${default#origin/}"
  [ -n "$default" ] || default="main"
  # refs/remotes/origin/HEAD's short name is bare "origin" (not
  # "origin/HEAD"), so it needs its own exclusion alongside "HEAD" for a
  # plain branch ref.
  git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin 2>/dev/null \
    | sed 's#^origin/##' \
    | sort -u \
    | grep -vx -e "$default" -e "HEAD" -e "origin" -e "main" -e "master" || true
}

cmd_sweep() {
  echo "scheduler sweep -- $(date '+%Y-%m-%d %H:%M')"
  echo "(reactive backstop: catches uncommitted/unpushed/diverged state the vim"
  echo " auto-commit hook may have missed -- e.g. a long-running vim session"
  echo " that predates a ~/.vimrc change never picks up new autocmds)"
  echo

  local repos_seen=0 issues_found=0
  {
    printf 'scheduler|%s\n' "$SCHED_ROOT"
    while IFS= read -r proj; do
      # scheduler is also self-registered (schedule/scheduler.conf, for its
      # own dogfooded paced cycle) -- already covered by the hardcoded line
      # above, skip here to avoid checking the same repo twice.
      [ "$proj" = "scheduler" ] && continue
      local rp
      rp="$(conf_field "$proj" PROJECT_REPO_PATH)"
      [ -n "$rp" ] && printf '%s|%s\n' "$proj" "$rp"
    done < <(projects)
  } | while IFS='|' read -r name path; do
    [ -d "$path/.git" ] || continue
    repos_seen=$((repos_seen + 1))

    # Safe .md files get auto-committed, one file at a time, same tested
    # logic `-i` already uses. Anything else (code, YAML config, etc.) is
    # only ever reported -- see home-assistant's config/automations.yaml
    # divergence (2026-07-20) for exactly why this stays conservative.
    local dirty_md
    dirty_md="$(git -C "$path" status --porcelain -- '*.md' 2>/dev/null | awk '{print $2}')"
    if [ -n "$dirty_md" ]; then
      while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        echo "== $name: auto-committing $rel =="
        cmd_commit_file "$path/$rel"
      done <<< "$dirty_md"
    fi

    local dirty_other
    dirty_other="$(git -C "$path" status --porcelain -- . ':!*.md' 2>/dev/null)"
    if [ -n "$dirty_other" ]; then
      echo "== $name: dirty, NOT auto-committed (only *.md is safe to auto-commit) =="
      echo "$dirty_other" | sed 's/^/  /'
    fi

    report_divergence "$name" "$path"
  done

  # Second pass: every automated job's DEDICATED CLONE
  # (~/.local/share/<JOB_NAME>/repo) -- added 2026-07-20 after realizing
  # the first pass above only ever checks YOUR manual checkouts. That's a
  # real blind spot: the original stranded-commit incident this whole
  # feature exists for (chezz, same day) was found sitting in a dedicated
  # clone, not a human checkout -- the first version of `sweep` could
  # never have caught its own motivating example. Glob-based, not
  # conf-parsed: scans whatever actually exists under ~/.local/share/*/repo
  # rather than trying to reconstruct job names from schedule/*.conf,
  # so it also covers legacy per-tier clones (chezz-bug-sweep,
  # chezz-nightly-batch, etc.) without needing to keep two enumeration
  # paths in sync. Scheduler's own jobs use throwaway worktrees, not this
  # shape (confirmed: no matching repo/ dir), so they're naturally excluded,
  # not special-cased.
  #
  # REPORT ONLY here, never auto-commit -- a dedicated clone gets a fresh
  # `git reset --hard origin/<branch>` before every run, so a human is
  # never expected to be editing inside one directly. Anything dirty or
  # unpushed there is either a genuinely interrupted run (the exact thing
  # worth surfacing) or something unusual enough to deserve a look, not a
  # routine auto-commit that could paper over what actually happened.
  local clone_found=0
  for repo in "$HOME"/.local/share/*/repo; do
    [ -d "$repo/.git" ] || continue
    clone_found=1
    job="$(basename "$(dirname "$repo")")"
    dirty="$(git -C "$repo" status --porcelain 2>/dev/null)"
    branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    ahead="$(git -C "$repo" rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo 0)"
    if [ -n "$dirty" ]; then
      echo "== [clone] $job: dirty in the dedicated clone itself -- unusual, worth a look =="
      echo "$dirty" | sed 's/^/  /'
    fi
    if [ "${ahead:-0}" -gt 0 ] 2>/dev/null; then
      echo "== [clone] $job: $ahead commit(s) ahead of origin/$branch, sitting UNPUSHED in the dedicated clone -- likely a run that got cut off after committing but before pushing (see the stranded-commit backlog item) =="
    fi
  done

  # Third pass: branches beyond main -- this repo's own paced/<date>
  # self-dev branches are the ones most likely to pile up unmerged (they
  # only merge when a live cycle finishes cleanly; a stale deploy or a
  # conflict leaves one stranded), then the same check on every dedicated
  # clone. Read-only, no fetch -- reflects branch state as of each clone's
  # last scheduled run / this repo's current state, not a live network
  # check.
  local sched_extra
  sched_extra="$(extra_branches "$SCHED_ROOT")"
  if [ -n "$sched_extra" ]; then
    echo "== scheduler (this repo): branches beyond main =="
    echo "$sched_extra" | sed 's/^/  /'
  fi
  for repo in "$HOME"/.local/share/*/repo; do
    [ -d "$repo/.git" ] || continue
    job="$(basename "$(dirname "$repo")")"
    extra="$(extra_branches "$repo")"
    [ -n "$extra" ] || continue
    echo "== [clone] $job: branches beyond main =="
    echo "$extra" | sed 's/^/  /'
  done

  # Fourth pass: stale/stranded ~/.local/share/scheduler-registry/*.active
  # markers (lib/sweep-loop-common.sh writes one per PROJECT_KEY on start
  # and `trap ... EXIT` removes it on a normal exit). A marker whose PID is
  # no longer running means that trap never fired -- the run was killed,
  # crashed, or the machine went down before it could clean up. That's the
  # other half of "did a run get cut off" the two passes above can't see:
  # they only catch a run that got far enough to make a commit (dirty repo,
  # unpushed clone). A run cut off BEFORE any commit leaves no git trace at
  # all -- only this marker. Queued in FOCUS.md's stability milestone
  # 2026-07-20, built here.
  local stale_found=0
  local registry_dir="$HOME/.local/share/scheduler-registry"
  if [ -d "$registry_dir" ]; then
    for marker in "$registry_dir"/*.active; do
      [ -f "$marker" ] || continue
      local proj_key pid started_at job_field age_seconds started_epoch
      proj_key="$(basename "$marker" .active)"
      pid="$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$marker")"
      started_at="$(sed -n 's/.*"started_at":"\([^"]*\)".*/\1/p' "$marker")"
      job_field="$(sed -n 's/.*"job":"\([^"]*\)".*/\1/p' "$marker")"
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        started_epoch="$(date -d "$started_at" +%s 2>/dev/null || echo "")"
        if [ -n "$started_epoch" ]; then
          age_seconds=$(( $(date +%s) - started_epoch ))
          if [ "$age_seconds" -ge "${STALE_ACTIVE_MARKER_SECONDS:-7200}" ]; then
            echo "== [registry] $proj_key: marker active ${age_seconds}s (job=$job_field, pid=$pid, started=$started_at) -- process is still alive, but this is longer than any known job normally runs. Worth a look, not auto-flagged as stranded. =="
            stale_found=1
          fi
        fi
      else
        echo "== [registry] $proj_key: STALE marker -- pid ${pid:-?} not running (job=$job_field, started=$started_at). The run that created this never reached its own EXIT trap (killed, crashed, or machine restarted), most likely before making any commit -- that's why the git-based checks above wouldn't catch it. Safe to remove once confirmed dead: rm '$marker' =="
        stale_found=1
      fi
    done
  fi
  if [ "$stale_found" = "0" ]; then
    echo "no stale/stranded registry (.active) markers found"
  fi

  # Fifth pass: verify claimed migration destinations. A project's own
  # schedule/<proj>.conf sometimes documents itself as "MIGRATED to
  # <host>'s own crontab" (aedile, vkv-inventory, both 2026-07-20) --
  # exactly the claim that sat WRONG for 4 days undetected (the migration
  # was never actually completed; see DESIGN-NOTES.md's "silently-orphaned
  # finding", root-caused 2026-07-24). A stranded-commit sweep can't catch
  # this class of drift at all -- there's no local git state to look at,
  # the whole point is the job moved OUTSIDE this scheduler's view. This
  # re-checks the claim every sweep instead of trusting it was ever true.
  # Best-effort only: if the destination host isn't SSH-reachable from
  # HERE (no alias, no network, no creds for that account), that's
  # reported as unverifiable, never silently treated as confirmed --
  # matches the honesty standard the stale-marker pass above already
  # holds itself to.
  local migration_found=0
  for conf in "$SCHED_ROOT"/schedule/*.conf; do
    [ -f "$conf" ] || continue
    local proj dest
    proj="$(basename "$conf" .conf)"
    dest="$(grep -iom1 'MIGRATED to [A-Za-z0-9_-]*' "$conf" | awk '{print $NF}')"
    [ -n "$dest" ] || continue
    migration_found=1
    if ! ssh -o BatchMode=yes -o ConnectTimeout=4 "$dest" true 2>/dev/null; then
      echo "== [migration-check] $proj: claims MIGRATED to '$dest' but that host isn't SSH-reachable from here (no alias/network/creds) -- can't verify the crontab claim from this environment; treat as UNVERIFIED, not confirmed =="
    elif ssh -o BatchMode=yes -o ConnectTimeout=4 "$dest" crontab -l 2>/dev/null | grep -qi "$proj"; then
      echo "== [migration-check] $proj: MIGRATED-to claim for '$dest' verified -- a matching crontab entry exists there =="
    else
      echo "== [migration-check] $proj: ORPHANED -- claims MIGRATED to '$dest' but no matching crontab entry found there. Needs a human/realisateur decision (finish the migration or re-enable it here) =="
    fi
  done
  if [ "$migration_found" = "0" ]; then
    echo "no schedule/*.conf claims a MIGRATED-to destination"
  fi

  echo
  if [ "$clone_found" = "1" ]; then
    echo "swept every registered project + scheduler itself + every job's dedicated clone."
  else
    echo "swept every registered project + scheduler itself. (no dedicated clones found under ~/.local/share/*/repo)"
  fi
}

extract_next_items() {
  # Best-effort, offline (no `claude` call) extraction of "what's next" out
  # of a project's own FOCUS.md -- a rough heuristic, not a real parser
  # (same honesty standard as cmd_glance's question-count awk block): finds
  # a heading matching current focus/priority/backlog, pulls its top-level
  # numbered/bulleted lines, and guesses bug vs feature vs unlabeled by
  # keyword. Projects whose FOCUS.md is mostly prose/HTML-comment design
  # notes (e.g. chezz) will under-match -- that's a real limitation, not a
  # bug in this function; real priority/bug-feature tagging needs a schema
  # decision (see FOCUS.md's 2026-07-22 backlog note), this is the
  # stopgap that works today against well-structured files.
  local focus_path="$1" cadence="${2:-}"
  [ -f "$focus_path" ] || { echo "no FOCUS.md found at $focus_path"; return; }

  local items
  items="$(awk '
    BEGIN{ incomment=0; inscope=0; n=0 }
    {
      line=$0
      if (incomment) {
        if (line ~ /-->/) { incomment=0 }
        next
      }
      if (line ~ /<!--/ && line !~ /-->/) { incomment=1; next }
      if (line ~ /<!--.*-->/) { next }
    }
    /^#+/ {
      inscope = (tolower($0) ~ /current focus|priority queue|priority|backlog/) ? 1 : 0
      next
    }
    inscope && /^[ \t]*([0-9]+\.|-[ \t])/ {
      # only top-level items (<=1 leading space of indent) -- skip nested
      # sub-bullets/notes so this stays a short "next up" list, not a dump
      if ($0 ~ /^[ \t]?([0-9]+\.|-[ \t])/) { print; n++ }
    }
    n>=12 { exit }
  ' "$focus_path")"

  if [ -z "$items" ]; then
    echo "no clearly structured focus/backlog list found -- open the focus file directly (scheduler focus <project>)"
    return
  fi

  local shown=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    shown=$((shown + 1))
    [ "$shown" -gt 8 ] && { echo "... (more in $focus_path -- \`scheduler focus <project>\` for the rest)"; break; }
    local clean tag
    clean="$(printf '%s' "$line" | sed -E 's/^[ \t]*([0-9]+\.|-)[ \t]*//; s/\*\*//g' | cut -c1-110)"
    if printf '%s' "$line" | grep -qiE '\b(bug|fix|broken|crash|regression|error)\b'; then
      tag="[bug]"
    elif printf '%s' "$line" | grep -qiE '\b(feature|implement|add|build|new)\b'; then
      tag="[feature]"
    else
      tag="[item]"
    fi
    # Cumulative ETA assumes strict FIFO (item N clears after N of this
    # project's own cycles) and 1 item clearing per cycle -- both rough;
    # see cmd_glance's ETA-column caveat for the same assumptions spelled
    # out in full. No cadence (fewer than 2 recorded dispatches yet) -> the
    # caller already printed one "no ETA yet" note, so just omit the column
    # here rather than repeating "unknown" on every single line.
    if [ -n "$cadence" ] && [ "$cadence" -gt 0 ] 2>/dev/null; then
      printf '  %-9s %-9s %s\n' "$tag" "~$(fmt_duration "$(( cadence * shown ))")" "$clean"
    else
      printf '  %-9s %s\n' "$tag" "$clean"
    fi
  done <<< "$items"
}

build_status_report() {
  # All plain bash/awk/git -- no `claude` invocation. This is the entire
  # point of `scheduler status`: the common "how's <project> doing" check
  # should cost zero tokens by default. cmd_status prints this directly;
  # --claude/--interactive just layer an AI step on top of the same text.
  local proj="$1" repo_path="$2" job_name="$3"

  echo "scheduler status: $proj -- $(date '+%Y-%m-%d %H:%M')"

  echo
  echo "-- git health ($repo_path) --"
  if [ -d "$repo_path/.git" ]; then
    local dirty divergence
    dirty="$(git -C "$repo_path" status --porcelain 2>/dev/null)"
    if [ -n "$dirty" ]; then
      echo "dirty:"
      echo "$dirty" | sed 's/^/  /'
    fi
    divergence="$(report_divergence "$proj" "$repo_path")"
    [ -n "$divergence" ] && printf '%s\n' "$divergence"
    [ -z "$dirty" ] && [ -z "$divergence" ] && echo "clean, up to date with origin"
  else
    echo "not a git repo (or PROJECT_REPO_PATH is missing on disk)"
  fi

  if [ -n "$job_name" ] && [ -d "$HOME/.local/share/$job_name/repo/.git" ]; then
    echo
    echo "-- dedicated clone vs working checkout --"
    local clone_head repo_head
    clone_head="$(git -C "$HOME/.local/share/$job_name/repo" rev-parse HEAD 2>/dev/null)"
    repo_head="$(git -C "$repo_path" rev-parse HEAD 2>/dev/null)"
    if [ -n "$clone_head" ] && [ "$clone_head" != "$repo_head" ]; then
      echo "clone HEAD ($clone_head) != working checkout HEAD ($repo_head) -- normal if you've committed locally since the clone's last dispatch; only a concern if the CLONE is ahead (that would mean a stranded commit -- see 'scheduler sweep')"
    else
      echo "clone matches working checkout HEAD"
    fi
  fi

  echo
  echo "-- pending feedback (collect-feedback.sh) --"
  local fb="" bb=""
  [ -f "$REPORTS_ROOT/$proj/LATEST.md" ] && fb="$("$SCHED_ROOT/bin/collect-feedback.sh" "$REPORTS_ROOT/$proj/LATEST.md" 2>/dev/null)"
  [ -f "$SCHED_ROOT/BLOCKERS.md" ] && bb="$("$SCHED_ROOT/bin/collect-feedback.sh" "$SCHED_ROOT/BLOCKERS.md" --section "$proj" 2>/dev/null)"
  if [ -z "$fb" ] && [ -z "$bb" ]; then
    echo "none pending"
  else
    [ -n "$fb" ] && printf '%s\n' "$fb"
    [ -n "$bb" ] && printf '%s\n' "$bb"
  fi

  echo
  echo "-- next up ($SCHED_ROOT/focus/$proj.md) --"
  local proj_cadence
  proj_cadence="$(project_cadence_seconds "$proj" 2>/dev/null)"
  if [ -z "$proj_cadence" ]; then
    echo "(no ETA yet -- fewer than 2 recorded paced dispatches for $proj)"
  fi
  extract_next_items "$SCHED_ROOT/focus/$proj.md" "$proj_cadence"

  echo
  echo "-- open questions ($SCHED_ROOT/questions/$proj.md) --"
  local qfile="$SCHED_ROOT/questions/$proj.md"
  if [ -f "$qfile" ]; then
    # Same unanswered/resolved logic as cmd_glance's awk block, but prints
    # the actual bullet text instead of just a count -- a deep-dive on one
    # project should show you the question, not send you to go open it.
    local unanswered
    unanswered="$(awk '
      function flush() { if (started && !is_resolved && !has_reply) print buf }
      BEGIN { infence=0 }
      /^```/ { infence = !infence; next }
      infence { next }
      /^- \*\*[0-9]{4}-[0-9]{2}-[0-9]{2}/ {
        flush()
        started=1
        is_resolved = (tolower($0) ~ /resolved|acknowledged/) ? 1 : 0
        has_reply=0; buf=$0
        next
      }
      started && /^[ \t]*>[ \t]?/ {
        line=$0
        sub(/^[ \t]*>[ \t]?/, "", line)
        if (line !~ /^\(answer inline here\)/) has_reply=1
      }
      END { flush() }
    ' "$qfile")"
    if [ -n "$unanswered" ]; then
      printf '%s\n' "$unanswered"
    else
      echo "none open"
    fi
  else
    echo "no QUESTIONS.md symlink found"
  fi

  echo
  echo "-- last scheduled run ($job_name) --"
  local log="$HOME/.local/share/$job_name/sweep.log"
  if [ -n "$job_name" ] && [ -f "$log" ]; then
    local expires
    if [ -f "$HOME/.local/share/$job_name/expires_at" ]; then
      expires="$(cat "$HOME/.local/share/$job_name/expires_at")"
      if [[ "$(date -Is)" > "$expires" ]]; then
        echo "EXPIRED $expires -- auto-disabled, needs EXPIRY_DAYS bump + bin/sync-crontab.sh to renew"
      else
        echo "expires: $expires"
      fi
    fi
    grep -E '^=== (done|FAILED|skipped)' "$log" | tail -1
    grep '^pushed:' "$log" | tail -1
    grep '^WARNING: local commit made but NOT pushed' "$log" | tail -1
  else
    echo "no log yet at $log"
  fi
}

cmd_status() {
  local proj="$1" mode="${2:-}"
  case "$mode" in
    ""|--claude|--interactive|-I) ;;
    *) echo "scheduler: unknown status flag '$mode' (use --claude or --interactive)" >&2; exit 2 ;;
  esac

  local repo_path
  repo_path="$(conf_field "$proj" PROJECT_REPO_PATH)"
  if [ -z "$repo_path" ]; then
    echo "scheduler: no such project '$proj', or it has no PROJECT_REPO_PATH set" >&2
    exit 1
  fi
  mark_seen "$proj"

  local job_name
  job_name="$(conf_field "$proj" BATCH_JOB_NAME)"
  [ -n "$job_name" ] || job_name="$(conf_field "$proj" SWEEP_JOB_NAME)"

  local report
  report="$(build_status_report "$proj" "$repo_path" "$job_name")"
  printf '%s\n' "$report"

  case "$mode" in
    --claude)
      echo
      echo "--- claude summary (read-only, --allowedTools Read,Grep,Glob) ---"
      (cd "$repo_path" && claude -p "$(cat <<EOF
Here is an offline status report for the "$proj" project, generated by
plain scripts (git status, pending human-feedback tags, open questions,
last automated run's log) -- no code was read yet.

$report

Skim the project's own README/FOCUS.md if useful, then write a short
(5 bullets max) human-readable status note: what's actually going on,
anything that looks off or needs attention, anything safe to ignore.
EOF
)" --allowedTools "Read,Grep,Glob" --max-turns 15)
      ;;
    --interactive|-I)
      echo
      echo "launching interactive claude session in $repo_path, preloaded with the report above..."
      cd "$repo_path" || exit 1
      exec claude "$report

Use this as your starting context for looking into $proj -- feel free to dig into the actual code/repo from here."
      ;;
  esac
}

mark_blockers_seen() {
  # Snapshots every project's own section hash at open-time (see the
  # per-project freshness fix in cmd_glance) so `*` only reappears for a
  # project once ITS section changes again, not on every BLOCKERS.md edit.
  [ -f "$SCHED_ROOT/BLOCKERS.md" ] || return 0
  while IFS= read -r proj; do
    local h
    h="$(awk -v want="$proj" '
      /^##[ \t]/ { insec = (tolower($0) ~ ("## *" tolower(want) "$")); next }
      insec { print }
    ' "$SCHED_ROOT/BLOCKERS.md" | md5sum | cut -d" " -f1)"
    mark_seen "blockers:$proj" "$h"
  done < <(projects)
}

case "${1:-}" in
  ""|glance) cmd_glance ;;
  blockers|-b)
    mark_blockers_seen
    if [ -n "${2:-}" ] && [ -n "${3:-}" ]; then
      cmd_blockers_jump "$2" "$3"
    else
      open_file "$SCHED_ROOT/BLOCKERS.md"
    fi
    ;;
  focus|-f)
    require_project focus "${2:-}"
    open_file "$SCHED_ROOT/focus/$2.md"
    ;;
  questions|-q)
    require_project questions "${2:-}"
    mark_seen "$2"
    if [ -n "${3:-}" ]; then
      cmd_questions_jump "$2" "$3"
    else
      open_file "$SCHED_ROOT/questions/$2.md"
    fi
    ;;
  report|-r)
    require_project report "${2:-}"
    open_file "$REPORTS_ROOT/$2/LATEST.md"
    ;;
  idea|-i) cmd_idea "${2:-}" "${3:-}" ;;
  next|-n) cmd_next "${2:-}" ;;
  run) cmd_run "${2:-}" ;;
  overview|-o)
    require_project overview "${2:-}"
    cmd_overview "$2"
    ;;
  weight) cmd_weight "${2:-}" "${3:-}" ;;
  paced|-p) open_file "$PACED_CONF" ;;
  pacing) shift; cmd_pacing "$@" ;;
  explain|-e) cmd_explain ;;
  _commit-file)
    # Internal, not a documented user-facing verb (leading underscore
    # matches the schedule/_*.conf "meta, not a project" convention) --
    # the vim auto-commit hook's own entrypoint into cmd_commit_file, so
    # there's exactly one implementation of "safely commit one file with
    # a staleness check" for both callers to share.
    cmd_commit_file "${2:-}" "${3:-}"
    ;;
  sweep|-s) cmd_sweep ;;
  status|-c)
    require_project status "${2:-}"
    cmd_status "$2" "${3:-}"
    ;;
  -h|--help|help) usage ;;
  *) echo "scheduler: unknown command '$1'" >&2; usage; exit 2 ;;
esac
