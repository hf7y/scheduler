#!/usr/bin/env bash
# scheduler -- quick navigation into the scheduler's own tracking files, so
# "what's going on / what needs me" doesn't require hunting through nested
# project folders. No args = one-screen glance; subcommands jump straight
# into a file in $EDITOR (vim if unset). Read-only glance, editor commands
# open real files (or symlinks into each project's real .claude/ files) --
# this is a thin wrapper, not a parser/database; see
# .claude/scheduler/FOCUS.md item 3 for the fuller "glance command" design
# this is a first cut of.
set -uo pipefail

# >>> SCHED_ROOT resolution (tests/sched-root-witness.sh extracts this block
# by these two markers -- if you move or rename them, that witness fails loud
# rather than silently testing nothing).
# Resolve the checkout this script belongs to in three steps, in the same
# order and by the same marker file bin/scheduler-dev-cycle.sh already uses
# (see its header, ~line 36): an explicit override, then self-location, then
# mandark's original absolute path for a copied-not-symlinked install.
#
# This was a bare hardcoded path until 2026-07-29. On a host that does not
# have that path -- dexter, where /home/zach/Documents does not exist at all
# -- every one of the 50+ SCHED_ROOT reads below resolved to nothing, the
# `source` on the next line failed, and the glance printed an EMPTY project
# table and exited 0. "Nothing needs you" and "I cannot find the repo" looked
# identical, which is the exit-0 no-op this repo's build discipline forbids.
#
# Identified as a repo by .git PLUS a file only this repo has, so a stray
# parent git repo can never be mistaken for the scheduler checkout. `.git` is
# a FILE, not a directory, in a worktree -- hence -e rather than -d.
SELF_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null)"
[ -n "$SELF_REAL" ] || SELF_REAL="${BASH_SOURCE[0]}"
SELF_REPO="$(cd "$(dirname "$SELF_REAL")/.." 2>/dev/null && pwd)"
: "${SELF_REPO:=}"
if [ -z "${SCHED_ROOT:-}" ]; then
  if [ -n "$SELF_REPO" ] && [ -e "$SELF_REPO/.git" ] && [ -f "$SELF_REPO/bin/usage-paced-runner.sh" ]; then
    SCHED_ROOT="$SELF_REPO"
  else
    SCHED_ROOT="/home/zach/Documents/Projects/scheduler"
  fi
fi
# Refuse loudly rather than rendering an unreadable world as an empty, clean
# one. This is the half that makes the bug above impossible, not just fixed.
if [ ! -f "$SCHED_ROOT/bin/usage-paced-runner.sh" ]; then
  echo "scheduler: cannot locate the scheduler checkout -- tried SCHED_ROOT=$SCHED_ROOT" >&2
  echo "scheduler: an empty glance here would mean 'I cannot read the repo', not 'nothing needs you'." >&2
  echo "scheduler: re-run with SCHED_ROOT=<path to the scheduler repo>." >&2
  exit 1
fi
# <<< SCHED_ROOT resolution
REPORTS_ROOT="$HOME/reports"
# shellcheck disable=SC1091
# shellcheck disable=SC1091
source "$SCHED_ROOT/lib/provenance.sh"   # PROVENANCE_ANSWERED_JQ -- what counts as an answer
EDITOR="${EDITOR:-vim}"
PACED_LOG="$HOME/.local/share/scheduler-paced-runner/run.log"
# WHICH rotation file, resolved per host by the SAME rule the runner uses --
# see lib/paced-conf.sh for the rule and for the dexter bug that made a shared
# resolver necessary (this was a hardcoded `_paced.conf` until 2026-07-29, so
# `next`/`run`/`weight`/`-p` answered about mandark's rotation on dexter, and
# `weight <p> <n>` wrote into it).
# shellcheck disable=SC1091
source "$SCHED_ROOT/lib/paced-conf.sh"
if ! resolve_paced_conf "$SCHED_ROOT"; then
  echo "scheduler: $PACED_CONF_SRC" >&2
  echo "scheduler: this host has no rotation file, so 'what runs here' has no answer --" >&2
  echo "scheduler: refusing rather than reporting an empty rotation as a quiet one." >&2
  exit 1
fi
PACED_PTR="$HOME/.local/share/scheduler-paced-runner/rotation.idx"

# load_paced_pool -- parses PACED_CONF the exact same way
# bin/usage-paced-runner.sh does (name|enabled|[weight|]command, weight
# defaults to 1, repeated N times in the pool for a weight-N participant)
# so `scheduler next`/`run`/`weight` stay in lockstep with what the real
# runner will actually do -- no second source of truth for this parsing.
# Lockstep on WHICH FILE is a separate guarantee and used to be missing
# entirely: see lib/paced-conf.sh, which now resolves PACED_CONF above, and
# tests/paced-conf-witness.sh, which fails if the runner's copy drifts.
# Populates the global arrays POOL_NAMES/POOL_CMDS.
load_paced_pool() {
  POOL_NAMES=(); POOL_CMDS=()
  [ -f "$PACED_CONF" ] || return 1
  local name enabled rest weight maybe_weight cmd _w
  while IFS='|' read -r name enabled rest; do
    case "$name" in ''|\#*) continue ;; esac
    [ "${enabled// /}" = "1" ] || continue
    name="${name// /}"
    rest="${rest#"${rest%%[![:space:]]*}"}"
    weight=1
    case "$rest" in
      [0-9]*'|'*)
        maybe_weight="${rest%%|*}"
        if [[ "$maybe_weight" =~ ^[0-9]+$ ]] && [ "$maybe_weight" -ge 1 ]; then
          weight="$maybe_weight"
          rest="${rest#*|}"
          rest="${rest#"${rest%%[![:space:]]*}"}"
        fi
        ;;
    esac
    cmd="$rest"
    for ((_w=0; _w<weight; _w++)); do
      POOL_NAMES+=("$name"); POOL_CMDS+=("$cmd")
    done
  done < "$PACED_CONF"
  [ "${#POOL_NAMES[@]}" -gt 0 ]
}

# paced_conf_line <proj> -- raw $PACED_CONF line for a project, or
# empty + nonzero exit if it isn't a paced participant (enabled or not).
paced_conf_line() {
  grep -E "^${1}\|" "$PACED_CONF" 2>/dev/null
}

# project_cadence_seconds <proj> -- average real wall-clock gap between this
# project's last few DISPATCH lines in the paced runner's log (see
# bin/usage-paced-runner.sh). This is the ONLY timing signal available:
# there's no scheduled clock to read an ETA off of (paced projects run
# whenever usage-gate.sh reports spare quota, not on a fixed cadence), so an
# estimate has to come from how often this project has actually gotten a
# turn recently. Returns nothing (and a nonzero exit) if there aren't at
# least 2 samples yet -- callers must treat that as "no estimate", not 0.
project_cadence_seconds() {
  local proj="$1"
  [ -f "$PACED_LOG" ] || return 1
  local stamps=() ts
  while IFS= read -r ts; do stamps+=("$ts"); done < <(
    grep -E "DISPATCH \[[0-9]+/[0-9]+\] ${proj} ->" "$PACED_LOG" | awk '{print $1}' | tail -8
  )
  [ "${#stamps[@]}" -ge 2 ] || return 1
  local prev="" cur total=0 count=0
  for ts in "${stamps[@]}"; do
    cur="$(date -d "$ts" +%s 2>/dev/null)" || continue
    if [ -n "$prev" ]; then
      total=$(( total + (cur - prev) ))
      count=$(( count + 1 ))
    fi
    prev="$cur"
  done
  [ "$count" -gt 0 ] || return 1
  echo $(( total / count ))
}

# fmt_duration <seconds> -- human-readable, capped at day/hour/minute
# granularity (this is a rough estimate, not a precise countdown).
fmt_duration() {
  local secs="${1:-0}"
  [ "$secs" -lt 0 ] 2>/dev/null && secs=0
  local days=$(( secs / 86400 )) hours=$(( (secs % 86400) / 3600 )) mins=$(( (secs % 3600) / 60 ))
  if [ "$days" -gt 0 ]; then printf '%dd %dh' "$days" "$hours"
  elif [ "$hours" -gt 0 ]; then printf '%dh %dm' "$hours" "$mins"
  else printf '%dm' "$mins"
  fi
}

usage() {
  cat <<'EOF'
usage: scheduler [command] [project]

  (no args)             one-screen glance: every registered project,
                         sorted by open question count (most pressing
                         first), a `*` marking anything changed since you
                         last opened it via this tool. Also shows a rough
                         per-project ETA (FOCUS.md backlog size x that
                         project's own recent paced-dispatch cadence) and
                         an overall "time to burn down every backlog"
                         estimate -- real history, not a promise.
  focus [project], -f   open a project's FOCUS.md (list projects if omitted)
  questions [project], -q
                         for a project whose conf sets ANSWER_CHANNEL="issues",
                         render every open `question`-labelled GitHub issue
                         into ONE buffer shaped like QUESTIONS.md, open it in
                         $EDITOR, and post each filled `> ` slot as a comment
                         on save -- the comment IS the answer, the issue
                         stays open, no label is involved. The buffer is
                         rendered fresh from the API and deleted on exit --
                         nothing about it persists on disk, which is the whole
                         point: the old symlinked file went stale on every
                         push and the round trip never closed.
                         Otherwise: open a project's QUESTIONS.md. With no
                         project, print the
                         questions overview: every project with any open
                         questions as unanswered/total, `*` where the file
                         changed since you last opened it, unread first, and
                         `?` where the count could not be READ at all (BLIND,
                         which is never the same as nothing open). On the
                         issues channel a question counts as ANSWERED once
                         you have commented on it -- leave it open, no label.
  report [project], -r  open a project's latest report (LATEST.md)
  next [n], -n           what usage-paced-runner.sh will actually dispatch
                         next, in real rotation order (reads its rotation
                         pointer + THIS HOST's rotation-file weights --
                         same round-robin math, and the same host-scoped
                         file, the runner itself uses; no new state).
                         Defaults to the next 8 slots.
  run <project>          dispatch one project's paced wrapper right now,
                         bypassing usage-gate.sh (each wrapper is already
                         self-contained: own flock + logging). Works even
                         if the project is currently disabled in this
                         host's rotation -- runs it once, doesn't re-enable
                         it.
  weight <project> [n]  show (no n) or set (with n) a project's pace weight
                         in THIS HOST's rotation file
                         (schedule/_paced.<host>.conf if it exists, else
                         schedule/_paced.conf). Setting it commits that
                         file, naming the old and new value, so the
                         override has a trace (see docs/priority-weight.md
                         -- the number itself is realisateur's judgment
                         call, this command only edits, never silently).
  paced, -p              open THIS HOST's rotation file directly
                         (enable/disable participants, reorder round-robin
                         tie-breaks). A host with its own
                         schedule/_paced.<host>.conf gets that file, not the
                         shared one -- editing the shared file there would
                         change what the OTHER host runs.
  pacing [show] [-h]     usage-paced-runner.sh's tick interval + max
                         dispatches/tick, the live usage-gate.sh verdict, and
                         a check that every installed ~/.local/bin script is
                         still a symlink into this repo (defaults to `show`).
                         -h/--human: plain-English translation of the gate
                         numbers instead of the raw util/burnline/slack line
  pacing tick '<cron>'  set schedule/_runner.conf's RUNNER_CRON (how often
                         the dispatcher ticks), re-sync + apply the real
                         crontab, and commit
  pacing max <n>         set PACED_MAX_PER_TICK (dispatches allowed per tick
                         before yielding back to cron even if usage-gate.sh
                         still says RUN), re-sync + apply, and commit
  ask <project> "<question>"
                         open ONE question as a GitHub issue on that
                         project's repo. Pass the question text only --
                         the id, date and provenance are stamped for you,
                         and the question becomes the issue title so
                         summary views show it rather than the date.
  idea <project> ["text"], -i
                         drop a new idea/feature-request for a project.
                         Every project, realisateur included, gets ONE
                         GitHub issue on its own repo (labels: idea,
                         from:<calling-project>) -- nothing is written to
                         the local filesystem, so this works from any host
                         holding no clone of the target. Omit "text" to
                         open $EDITOR instead; quitting without typing
                         anything cancels rather than filing an empty
                         issue.
  sweep, -s              reactive backstop for the vim auto-commit hook --
                         scans every registered repo (+ scheduler itself)
                         for uncommitted/unpushed/diverged state the hook
                         may have missed (e.g. a long-running vim session
                         that predates a ~/.vimrc change never fires new
                         autocmds). Safely auto-commits AND pushes dirty
                         *.md files one at a time (same tested logic as
                         `-i`; if the repo is merely behind origin it
                         fast-forwards FIRST so the edit still lands,
                         rather than stranding a local-only commit no
                         dispatch will ever see); never
                         touches non-.md files or attempts to resolve a
                         genuine ahead+behind divergence -- those are only
                         ever reported, never auto-resolved.
  man, -m                open the maintained man page
                         (docs/scheduler-cli.md) in $PAGER -- glance
                         column meanings, the `*` convention, where each
                         number comes from, and the files behind it all.
  <project>              shorthand for `status <project>` below (works
                         with a bare registered project name, no verb)
  status <project>, -c  offline (no AI) deep-dive on one project: git
                         health (dirty/ahead/behind/diverged, + dedicated
                         clone divergence), pending %%TAG/`> ` feedback
                         (via collect-feedback.sh), each FOCUS.md backlog
                         item with a rough cumulative ETA off this
                         project's own recent paced-dispatch cadence, open
                         QUESTIONS.md entries, and the last scheduled run's
                         outcome from its log. Append --claude for a one-shot
                         read-only `claude -p` narrated summary of the
                         same report, or --interactive (-I) to drop into
                         a live `claude` session in the project's repo
                         preloaded with it as starting context.

Examples: scheduler focus crt   |   scheduler questions crt
          scheduler -i realisateur "a browser extension that ..."
          scheduler -i wtul "add a --dry-run flag to wtul-rip"
          scheduler -s
          scheduler status realisateur
          scheduler status realisateur --claude
          scheduler status realisateur --interactive
EOF
}

# cmd_man -- open the maintained man page (docs/scheduler-cli.md, where
# the glance view's former in-screen explanation text moved, 2026-07-25).
# Resolves script-relative first so a dev worktree's copy shows its own
# doc; the deployed ~/.local/bin/scheduler symlink/copy has no ../docs,
# so it falls back to the real checkout via SCHED_ROOT.
cmd_man() {
  local here doc
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
  doc="$here/../docs/scheduler-cli.md"
  [ -f "$doc" ] || doc="$SCHED_ROOT/docs/scheduler-cli.md"
  if [ ! -f "$doc" ]; then
    echo "scheduler: man page not found (expected docs/scheduler-cli.md)" >&2
    return 1
  fi
  "${PAGER:-less}" "$doc"
}

projects() {
  for conf in "$SCHED_ROOT"/schedule/*.conf; do
    # Unmatched glob passes through literally -- without this guard an
    # empty schedule/ dir yields a bogus project named "*" (found
    # 2026-07-26 by the expiry-visibility test fixture, but real for any
    # fresh install too).
    [ -f "$conf" ] || continue
    b="$(basename "$conf" .conf)"
    [[ "$b" == _* ]] && continue
    echo "$b"
  done
}

SEEN_FILE="$HOME/.local/share/scheduler-glance/seen.tsv"

mark_seen() {
  # Records "you looked at this" per project/key so cmd_glance can flag
  # what changed since your last look with `*` (2026-07-22, addressing
  # "questions/blockers view is meaningless to me" -- a bare open count
  # doesn't say whether it's something you've never seen or something
  # you already know about and haven't gotten to). Deliberately a plain
  # tsv, not a database -- same style as everything else here.
  local key="$1" now
  now="${2:-$(date +%s)}"
  mkdir -p "$(dirname "$SEEN_FILE")"
  touch "$SEEN_FILE"
  grep -v "^${key}	" "$SEEN_FILE" > "$SEEN_FILE.tmp" 2>/dev/null || true
  { cat "$SEEN_FILE.tmp" 2>/dev/null; printf '%s\t%s\n' "$key" "$now"; } > "$SEEN_FILE"
  rm -f "$SEEN_FILE.tmp"
}

get_seen() {
  local key="$1"
  [ -f "$SEEN_FILE" ] && awk -F'\t' -v k="$key" '$1==k{print $2; found=1} END{if(!found) print 0}' "$SEEN_FILE" || echo 0
}

# ---- human-presence marker (see realisateur/bin/session-marker.sh) --------
# The ecosystem already represents "a human is working in project X" as
# $REGISTRY_DIR/<project>.interactive, whose LIVENESS IS A PID PROBE, never
# flock: SessionEnd/exit is not guaranteed on crash, and a held lock would
# orphan and wedge that project's batch permanently and silently. Same
# reasoning applies here, so this writes the same marker in the same
# directory rather than inventing a second one -- one place answers "is
# anything writing to this project right now."
#
# What this adds that the session hook could not: the hook keys off the
# SESSION's cwd, but `questions/<p>.md` and `focus/<p>.md` are symlinks into
# each project's own checkout, so answering three projects' questions from
# the scheduler repo marked *scheduler* busy and left all three reading FREE
# (filed 2026-07-26 on the sweep-attribution entry). The front door knows
# exactly which project's file it is about to open, so it keys off the FILE.
REGISTRY_DIR="$HOME/.local/share/scheduler-registry"

# Which registered project owns this path? Resolves symlinks first, so the
# aggregation folders (questions/, focus/) land on the real project rather
# than on scheduler. Reports live outside every checkout, hence the second
# case. Returns 1 for anything cross-project (BLOCKERS.md) or unregistered --
# callers treat that as "nothing to hold", never as an error.
project_for_path() {
  local path="$1" real name repo
  real="$(readlink -f -- "$path" 2>/dev/null)" || return 1
  [ -n "$real" ] || return 1
  while IFS= read -r name; do
    repo="$(conf_field "$name" PROJECT_REPO_PATH)" || true
    [ -n "$repo" ] || continue
    repo="$(readlink -f -- "$repo" 2>/dev/null)" || continue
    case "$real/" in "$repo"/*) printf '%s\n' "$name"; return 0 ;; esac
  done < <(projects)
  case "$real/" in
    "$REPORTS_ROOT"/*)
      name="${real#"$REPORTS_ROOT"/}"; name="${name%%/*}"
      [ -n "$name" ] && { printf '%s\n' "$name"; return 0; }
      ;;
  esac
  return 1
}

# Mark the file's project busy for as long as the editor lives. Called
# immediately before `exec "$EDITOR"`: exec REPLACES this process, so the pid
# written here becomes the editor's own pid -- the marker dies exactly when
# the editor does, with no trap, no cleanup, and no way to leave a lock
# holding after a crash. (An $EDITOR that forks and returns -- a GUI wrapper
# -- makes the marker read free immediately; correct-by-default rather than
# wedging, and the same failure direction the session hook chose.)
hold_project_marker() {
  local path="$1" proj
  proj="$(project_for_path "$path")" || return 0
  mkdir -p "$REGISTRY_DIR" 2>/dev/null || return 0
  {
    echo "pid=${BASHPID:-$$}"
    echo "started_at=$(date -Is)"
    echo "cwd=$path"
    echo "owner=scheduler/bin/scheduler (front door opened this file)"
  } > "$REGISTRY_DIR/$proj.interactive" 2>/dev/null || true
  echo "scheduler: holding '$proj' busy while your editor is open"
}

# Is a live human editing this project right now? Prints the pid, exits 1 if
# not. Field format and the kill -0 rule are set by the marker's other
# reader, realisateur/bin/check-project-busy.sh -- keep them in step.
interactive_holder() {
  # Two statements, deliberately: bash expands every word of a `local`
  # command BEFORE assigning any of them, so `local proj="$1"
  # marker="...$proj..."` reads $proj from the OUTER scope -- unbound under
  # `set -u`, which aborted this function and made sweep read "no holder"
  # and commit anyway. Caught 2026-07-26 by the isolated sweep test.
  local proj="$1" pid
  local marker="$REGISTRY_DIR/$proj.interactive"
  [ -f "$marker" ] || return 1
  pid="$(awk -F= '$1=="pid"{print $2}' "$marker" 2>/dev/null)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

open_file() {
  local path="$1"
  if [ ! -e "$path" ]; then
    echo "scheduler: no file yet at $path" >&2
    exit 1
  fi
  hold_project_marker "$path"

  # NOT `exec` any more (changed 2026-07-28, Zach-directed: "there should
  # be a safety net that also enforces styling on my comments if I drift,
  # or at least one that leaves a noisy exit when I quit vim"). exec
  # REPLACES this process, so nothing could ever run after the editor --
  # there was no seam to hang a post-edit check on.
  #
  # The busy-marker guarantee that motivated exec is preserved: the marker
  # holds ${BASHPID:-$$}, which is THIS process, and this process now lives
  # exactly as long as the editor plus the lint below. The one behavior
  # difference is a wrapper killed out from under a live editor, which
  # makes the marker read free -- the same failure direction exec already
  # chose deliberately (free rather than wedged).
  local rc=0
  "$EDITOR" "$path" || rc=$?

  # Safety net, not a gate. Repairs the drift, says so loudly, and never
  # changes the editor's exit status over it -- a human quitting vim has
  # not failed at anything.
  local lint
  lint="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/lint-replies.sh"
  if [ -x "$lint" ]; then
    "$lint" --fix "$path" || true
  else
    echo "" >&2
    echo "  scheduler: WARNING -- bin/lint-replies.sh is missing or not" >&2
    echo "  executable. Reply formatting in $path went UNCHECKED." >&2
    echo "  A missing guard is a finding, not an inconvenience." >&2
    echo "" >&2
  fi

  exit "$rc"
}

require_project() {
  local kind="$1" proj="${2:-}"
  if [ -z "$proj" ]; then
    echo "available projects:"
    projects | sed 's/^/  /'
    echo
    echo "usage: scheduler $kind <project>"
    exit 1
  fi
}

conf_field() {
  local proj="$1" field="$2" v
  local conf="$SCHED_ROOT/schedule/$proj.conf"
  [ -f "$conf" ] || return 1
  v="$(grep -E "^${field}=" "$conf" | head -1 | cut -d= -f2- | tr -d '"')"

  # TRAP: ONE FILE, TWO READERS. schedule/*.conf is `source`d by sync-crontab.sh and scheduler-run, where PROJECT_REPO_PATH="$HOME/..." expands; THIS reader is grep+cut+tr, so the same line came back as the literal characters `$HOME/...` and every caller below treats it as a real path.
  case "$v" in
    '$HOME'|'$HOME'/*)     v="$HOME${v#\$HOME}" ;;
    '${HOME}'|'${HOME}'/*) v="$HOME${v#\$\{HOME\}}" ;;
    '~'|'~'/*)             v="$HOME${v#\~}" ;;
  esac
  printf '%s\n' "$v"
}

# --- cross-account run state -------------------------------------------
# A job whose conf sets CRON_ACCOUNT runs under ANOTHER unix account, so its
# run state (sweep.log, expires_at, the dedicated clone) lives under THAT
# account's home -- not $HOME. Reading $HOME's path for such a job is not a
# harmless miss: it makes the sensor assert a negative it never probed, and
# it fails toward alarm. Found 2026-07-28: `scheduler status aedile` printed
# "no log yet" while aedile had in fact succeeded every night for a week
# under svc-vaporwave, and `scheduler status vkv-inventory` replayed a
# FAILED from 2026-07-20 as if it were current.
#
# Non-negotiable rule for callers: if the other account's state cannot be
# read, say BLIND and name the account and path that could not be read.
# NEVER fall back to $HOME's path and print that as the job's state -- that
# is the exact defect this exists to retire.
state_account() {
  local acct
  acct="$(conf_field "$1" CRON_ACCOUNT 2>/dev/null)"
  if [ -n "$acct" ] && [ "$acct" != "$(id -un)" ]; then
    printf '%s' "$acct"
  fi
  return 0
}

state_home() {
  local acct="$1"
  if [ -z "$acct" ]; then
    printf '%s' "$HOME"
  else
    getent passwd "$acct" | cut -d: -f6
  fi
}

# Run a read-only command as the state-owning account. Local account: run it
# directly. Another account: `sudo -n` -- never prompts, so an unattended
# `scheduler sweep` can't hang on a password. A non-zero rc means "could not
# read", which callers render as BLIND.
state_run() {
  local acct="$1"; shift
  if [ -z "$acct" ]; then "$@"; else sudo -n -u "$acct" "$@"; fi
}
state_readable() { state_run "$1" true >/dev/null 2>&1; }
state_exists()   { state_run "$1" test -f "$2"; }
state_cat()      { state_run "$1" cat "$2" 2>/dev/null; }

# last_run_verdict <project> <job_name> -- one line, tab-separated:
#   <state>\t<epoch-or-0>\t<detail>
# state is one of: ok FAILED skipped running BLIND nojob nolog
#
# Sprint step 3 (2026-07-28). This is the ONE place that answers "what
# actually happened on this job's last run", read from the job's own run
# log rather than inferred from a report file's mtime. The glance's LAST
# RUN column is `reports/<p>/LATEST.md` mtime, which is a proxy for the
# last SUCCESS: a failed run writes no report, so the column keeps showing
# the last good one and reads as if it were the last run. Step 2's
# measurement (bin/unprinted-facts.sh) found five projects whose report
# mtime and run log disagreed by over an hour, one by nine days.
#
# BLIND is a real answer here, not an error path: a CRON_ACCOUNT job whose
# state this account cannot read must say so and name the account, never
# fall back to $HOME's path (see state_account's own rule above).
last_run_verdict() {
  local proj="$1" job="$2"
  if [ -z "$job" ]; then printf 'nojob\t0\t-\n'; return 0; fi
  local acct dir log slice status ts epoch
  acct="$(state_account "$proj")"
  dir="$(state_home "$acct")/.local/share/$job"
  if [ -n "$acct" ] && ! state_readable "$acct"; then
    printf 'BLIND\t0\truns as %s; cannot read %s (sudo -n -u %s failed)\n' "$acct" "$dir" "$acct"
    return 0
  fi
  log="$dir/sweep.log"
  state_exists "$acct" "$log" || { log="$dir/run.log"; state_exists "$acct" "$log" || {
    printf 'nolog\t0\tno sweep.log or run.log under %s\n' "$dir"; return 0; }; }
  # Same last-run slicing as build_status_report, and the same reason: a
  # WARNING from a since-resolved run must never be re-reported as current.
  slice="$(state_cat "$acct" "$log" | awk '/^===+ [0-9]{4}-[0-9]{2}-[0-9]{2}T/{buf=""} {buf=buf $0 "\n"} END{printf "%s", buf}')"
  ts="$(printf '%s' "$slice" | head -1 | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}' | head -1)"
  epoch="$(date -d "$ts" +%s 2>/dev/null || echo 0)"
  status="$(printf '%s' "$slice" | grep -E '^===+ (done|FAILED|skipped)' | tail -1)"
  if [ -z "$status" ]; then
    printf 'running\t%s\tstarted %s, no completion line yet (running, or cut off -- see scheduler sweep)\n' "$epoch" "${ts:-?}"
  elif grep -qE '^===+ FAILED' <<<"$status"; then
    printf 'FAILED\t%s\t%s\n' "$epoch" "$(sed 's/^===* //; s/ ===*$//' <<<"$status")"
  elif grep -qE '^===+ skipped' <<<"$status"; then
    printf 'skipped\t%s\t%s\n' "$epoch" "$(sed 's/^===* //; s/ ===*$//' <<<"$status")"
  else
    printf 'ok\t%s\t%s\n' "$epoch" "$(sed 's/^===* //; s/ ===*$//' <<<"$status")"
  fi
}

# A literal "$path/.git" directory check is wrong for any PROJECT_REPO_PATH
# that points at a subdirectory of a repo rather than its root (e.g. aedile,
# tracked as a subdir of the shared wavebucks monorepo -- its .git lives at
# the parent, not at aedile/ itself). `git rev-parse` walks up and finds it
# either way. Found 2026-07-24 via realisateur's /ideate on aedile.
is_git_repo() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}


# --- the GitHub-issues answer channel ----------------------------------
# Built 2026-07-28 (Zach: "move the full chezz over to test the github issues
# pipeline"), replacing a `questions/<p>.md` symlink into a local mandark
# working copy that went one commit stale on every push, so the round trip
# never closed -- and that has no answer surface at all on a host with no
# mandark checkout.
# THE RULE THAT MATTERS: the buffer is rendered fresh from the API on every
# invocation and DELETED after, so it can never be the stale copy it replaced.

# Which channel a project's questions live in: "issues" or "file".
# Opt-in per project via ANSWER_CHANNEL in schedule/<proj>.conf. Default
# is "file" -- this migrates one project at a time, deliberately, because
# `hf7y/chezz` is PUBLIC and world-readable questions are fine for chezz
# and NOT automatically fine ecosystem-wide.
answer_channel() {
  local ch
  ch="$(conf_field "$1" ANSWER_CHANNEL 2>/dev/null)" || true
  case "$ch" in
    issues) echo "issues" ;;
    ""|file) echo "file" ;;
    *) echo "scheduler: $1: unknown ANSWER_CHANNEL '$ch' (want: issues|file)" >&2; return 1 ;;
  esac
}

# owner/repo for `gh --repo`, derived from the conf's existing REPO_URL
# rather than retyped as a second field -- one source, per BUILD-DISCIPLINE.
# Handles both the ssh-alias form chezz uses
# (git@github-chezz-deploy:hf7y/chezz.git) and an https remote.
gh_repo_slug() {
  local proj="$1" url slug
  url="$(conf_field "$proj" REPO_URL 2>/dev/null)" || true
  if [ -z "$url" ]; then
    echo "scheduler: $proj has no REPO_URL in its conf -- required to reach GitHub, which is now the front door for both questions and ideas" >&2
    return 1
  fi
  slug="${url##*:}"          # ssh alias form -> owner/repo.git
  slug="${slug##*github.com/}"  # https form  -> owner/repo.git
  slug="${slug%.git}"
  slug="${slug#/}"
  case "$slug" in
    */*) printf '%s\n' "$slug" ;;
    *) echo "scheduler: $proj: could not derive an owner/repo from REPO_URL='$url'" >&2; return 1 ;;
  esac
}

# Fail loud and EARLY, with the actual fix in the message. Every issues
# path calls this before its first API call, so a dead credential is a
# stop, never an empty buffer.
require_gh() {
  if ! command -v gh >/dev/null 2>&1; then
    echo "scheduler: \`gh\` is not installed, and this project's answer channel is GitHub issues." >&2
    echo "  This is a stop, not something to route around -- install gh, or set ANSWER_CHANNEL=file." >&2
    return 1
  fi
  if ! gh auth status >/dev/null 2>&1; then
    echo "scheduler: \`gh\` is not authenticated. Run: gh auth login -h github.com" >&2
    echo "  (Note \`gh auth status\` can show one FAILING account alongside a working one --" >&2
    echo "  read the whole output before concluding the credential is dead. That misreading" >&2
    echo "  cost this ecosystem a phantom blocker for two days, 2026-07-26..28.)" >&2
    return 1
  fi
}

# unanswered/total for the glance + `scheduler -q` overview, from the API.
#
# The 5-minute cache here is ONLY over the two integers, and exists because
# the bare `scheduler` glance calls this once per project and an
# unconditional network round trip would make the ecosystem's most-typed
# command wait on GitHub. The answer BUFFER is never cached -- see the
# header note. A stale count costs you a slightly wrong number in a
# summary view; a stale buffer costs you a lost answer.
#
# UNANSWERED here means "no unstamped comment from the repo owner", never
# "not labelled `answered`" -- see the header note and lib/provenance.sh.
# The QUERY is deliberately not gated on --state: an answer sits on an OPEN
# issue as often as a closed one, and either gate drops half of them. The
# `.state == "OPEN"` filter below is about which questions still occupy the
# queue you are being shown -- it decides what is COUNTED, never what counts
# as an ANSWER.
#
# Every failure path below returns 1 rather than "0 0". A count that reads
# clean when nothing was reached is this ecosystem's named worst case:
# BLIND reported as OK. Callers render `?` for it.
issues_counts() {
  local proj="$1" slug owner cache raw out
  slug="$(gh_repo_slug "$proj")" || return 1
  owner="${slug%%/*}"
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/scheduler/questions-count-$proj"
  if [ -f "$cache" ] && [ "$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))" -lt 300 ]; then
    cat "$cache"; return 0
  fi
  if ! command -v gh >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    echo "scheduler: $proj: gh and/or jq missing -- the question count is BLIND, not zero." >&2
    return 1
  fi
  if ! raw="$(gh issue list --repo "$slug" --label question --state all \
                --limit 200 --json number,state,labels,comments 2>&1)"; then
    printf 'scheduler: %s: `gh issue list` failed against %s -- the question count is BLIND, not zero:\n%s\n' \
      "$proj" "$slug" "$raw" >&2
    return 1
  fi
  if ! out="$(printf '%s' "$raw" | jq -r --arg owner "$owner" \
        "$PROVENANCE_ANSWERED_JQ"'
         [.[] | select(.state == "OPEN")]
         | "\([.[] | select(is_answered($owner) | not)] | length) \([.[] | select(is_answered($owner))] | length)"' 2>&1)"; then
    printf 'scheduler: %s: jq failed over %s issue JSON -- the question count is BLIND, not zero:\n%s\n' \
      "$proj" "$slug" "$out" >&2
    return 1
  fi
  case "$out" in
    [0-9]*' '[0-9]*) ;;
    *) echo "scheduler: $proj: could not derive a question count for $slug -- BLIND, not zero." >&2
       return 1 ;;
  esac
  mkdir -p "$(dirname "$cache")"
  printf '%s\n' "$out" > "$cache"
  printf '%s\n' "$out"
}

# The two labels carry the semantics the file channel encoded in prose.
# `gh label create` is idempotent-by-flag, not by nature -- without
# --force it exits non-zero when the label already exists, which is the
# normal case, so that specific failure is the success path here.
#
# $2, when given, is a `from:<calling-project>` label -- created on demand
# the same way, since the set of callers is open-ended (every registered
# project, plus "zach" for an interactive shell outside any checkout) and
# can't be pre-seeded like the three fixed labels above.
ensure_gh_labels() {
  local slug="$1" from_label="${2:-}"
  gh label create question --repo "$slug" --color FBCA04 \
    --description "Open question for the human; scheduler -q renders these" >/dev/null 2>&1 || true
  gh label create answered --repo "$slug" --color 0E8A16 \
    --description "Human has answered; this project's next run acts, then closes" >/dev/null 2>&1 || true
  gh label create idea --repo "$slug" --color 1D76DB \
    --description "Filed via scheduler -i / notify-senechal; this project's next run triages it" >/dev/null 2>&1 || true
  if [ -n "$from_label" ]; then
    # 100 CHARACTERS, NOT 102. GitHub rejects a label description over 100 with
    # HTTP 422; the description here was 102, so this call ALWAYS failed, `|| true`
    # swallowed it, and the `gh issue create` below then failed with
    # "could not add label: 'from:<p>' not found" and recorded NOTHING.
    #
    # That made notify-senechal -- the front door every project is required to
    # use before changing machine-wide config -- unusable from any checkout,
    # from the moment #69 merged (2026-08-11) until this fix. Found by trying
    # to file a real note through it. Length asserted in
    # tests/from-label-witness.sh so prose is not what keeps it under.
    gh label create "$from_label" --repo "$slug" --color 5319E7 \
      --description "Calling project recorded by scheduler -i; lets an idea be triaged by source" >/dev/null 2>&1 || true
  fi
}

# `scheduler -q <proj>` for an issues-channel project: render every open
# question into ONE buffer shaped like the QUESTIONS.md the fingers know,
# open $EDITOR on it, post each filled `> ` slot as a comment, delete the
# buffer. No merge logic is needed anywhere: there is never a second
# writer to the same bytes, and the worst case is a duplicate comment.
QBUF=""   # deliberately GLOBAL, not local to cmd_questions_issues: the EXIT
          # trap below fires after the function's locals are out of scope, so
          # a `local buf` made the trap expand an unset name -- under `set -u`
          # that aborts the trap and the buffer SURVIVES on disk, which is the
          # one thing this whole design exists to prevent. Caught by running
          # it and then looking for /tmp/scheduler-questions-*, 2026-07-28 --
          # exit status alone said success.
cmd_questions_issues() {
  local proj="$1" slug json count
  require_gh || exit 1
  slug="$(gh_repo_slug "$proj")" || exit 1

  # FAIL LOUD: capture the failure instead of letting an API error become
  # an empty buffer that reads as "no questions".
  if ! json="$(gh issue list --repo "$slug" --label question --state open \
                 --limit 200 --json number,title,body,labels,comments 2>&1)"; then
    echo "scheduler: gh issue list FAILED against $slug -- refusing to render an empty buffer," >&2
    echo "  because an empty buffer is indistinguishable from 'no open questions'." >&2
    printf '%s\n' "$json" >&2
    exit 1
  fi

  count="$(printf '%s' "$json" | jq 'length')"
  if [ "$count" -eq 0 ]; then
    echo "no open questions for $proj (channel: GitHub issues, $slug)"
    exit 0
  fi

  QBUF="$(mktemp -t "scheduler-questions-$proj.XXXXXX.md")"
  # Rendered fresh, deleted on ANY exit including a crash or ^C -- the
  # whole point of a view rather than a file.
  trap 'rm -f "${QBUF:-}"' EXIT INT TERM

  {
    printf '# Questions for %s — GitHub issues (%s)\n\n' "$proj" "$slug"
    printf 'Answer under each question on lines starting with `> `.\n'
    printf 'On save+exit each non-empty answer is posted as a COMMENT on its issue.\n'
    printf 'The comment IS the answer; the issue stays open. Empty slots are skipped.\n\n'
    printf 'This buffer is rendered fresh from the API and DELETED on exit.\n'
    printf 'Editing anything other than a `> ` line changes nothing.\n'
  } > "$QBUF"

  printf '%s' "$json" | jq -r --arg owner "${slug%%/*}" "$PROVENANCE_ANSWERED_JQ"'
    sort_by(.number)[] |
    "\n<!-- scheduler:issue \(.number) -->\n" +
    "## #\(.number) — \(.title)\n" +
    (if is_answered($owner) then "_(you have already answered this one — a further comment just adds to the thread)_\n" else "" end) +
    "\n" + ((.body // "") | rtrimstr("\n")) + "\n" +
    ((.comments // []) | map("\n---\n**\(.author.login // "?") commented:**\n\n" + ((.body // "") | rtrimstr("\n")) + "\n") | join("")) +
    "\n### answer\n> \n"
  ' >> "$QBUF"

  local before after
  before="$(sha1sum "$QBUF" | cut -d" " -f1)"
  "${EDITOR:-vi}" "$QBUF"
  after="$(sha1sum "$QBUF" | cut -d" " -f1)"
  if [ "$before" = "$after" ]; then
    echo "no edits — nothing posted."
    exit 0
  fi

  # Parse: for each issue anchor, the answer is every `>` line after that
  # block's `### answer` marker. Emits NUL-free "<number><TAB><text>" with
  # newlines encoded, because an answer is legitimately multi-line.
  local parsed posted=0 failed=0
  parsed="$(awk '
    function flush() {
      if (num != "" && ans != "") { gsub(/\n+$/, "", ans); if (ans != "") printf "%s\t%s\n", num, ans }
      num=""; ans=""; inans=0
    }
    /^<!-- scheduler:issue [0-9]+ -->$/ { flush(); num=$3; next }
    /^### answer[ \t]*$/ { inans=1; next }
    inans && /^[ \t]*>/ {
      line=$0; sub(/^[ \t]*>[ \t]?/, "", line)
      if (line ~ /[^ \t]/) ans = ans line "\\n"
      next
    }
    END { flush() }
  ' "$QBUF")"

  if [ -z "$parsed" ]; then
    echo "no answers filled in — nothing posted."
    exit 0
  fi

  ensure_gh_labels "$slug"
  local num text cf
  while IFS=$'\t' read -r num text; do
    [ -n "$num" ] || continue
    cf="$(mktemp)"
    printf '%b\n' "$text" > "$cf"
    if gh issue comment "$num" --repo "$slug" --body-file "$cf" >/dev/null 2>&1 \
       && gh issue edit "$num" --repo "$slug" --add-label answered >/dev/null 2>&1; then
      echo "posted: #$num answered"
      posted=$(( posted + 1 ))
    else
      echo "FAILED to post the answer to #$num -- it is NOT recorded. Your text:" >&2
      printf '  %b\n' "$text" >&2
      failed=$(( failed + 1 ))
    fi
    rm -f "$cf"
  done <<< "$parsed"

  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/scheduler/questions-count-$proj"
  echo
  echo "$posted answer(s) posted to $slug; $proj's next run reads the comments."
  [ "$failed" -eq 0 ] || exit 1
}

# Single entry point both summary views use, so they cannot disagree about
# what counts as an open question for a project on either channel.
project_questions_counts() {
  local proj="$1"
  if [ "$(answer_channel "$proj" 2>/dev/null)" = "issues" ]; then
    issues_counts "$proj"
  elif [ ! -d "$SCHED_ROOT/questions" ]; then
    # The local questions/*.md mirror was retired whole by #244. Without
    # this check, questions_counts() below opens a path that can no
    # longer exist, sees no file, and returns a clean "0 0" -- the exact
    # "BLIND reported as OK" failure this function exists to prevent,
    # just for the mirror channel instead of the issues one (#396).
    return 1
  else
    questions_counts "$SCHED_ROOT/questions/$proj.md"
  fi
}

# cmd_ask -- the ONE way an open question gets onto a project's tracker.
#
# Built 2026-07-28 (human-directed, /ideate). This exists because the
# alternative -- a written convention saying "put the question first" --
# had already failed. Every writer hand-typed
#   - **2026-07-26 (via /nightly-batch, paced cycle): <question>**
# and led with the invariant part, so `scheduler status` (which shows an
# entry's opening line) rendered ten different questions as ten
# near-identical stubs of date + provenance. Prose cannot enforce field
# order; a generator can. The caller supplies ONLY the question text.
# Everything else -- id, date, provenance -- is stamped here, which is
# what makes "the question is the first thing on the line" a structural
# fact rather than a thing to remember. #66 (2026-08-07) moved the
# destination from a QUESTIONS.md entry to a GitHub issue titled with the
# question text -- same id/date/provenance stamping, now carried in the
# issue body instead of a bold-span line.
cmd_ask() {
  local proj="${1:-}" text="${2:-}"
  if [ -z "$proj" ] || [ -z "$text" ]; then
    echo "usage: scheduler ask <project> \"<the question, in full>\""
    echo
    echo "  Opens ONE question as a GitHub issue on <project>'s repo. Pass the"
    echo "  question text only -- id, date and provenance are stamped for you,"
    echo "  and the question becomes the issue title so summary views show it."
    echo
    echo "  Provenance defaults to this session's context; override with"
    echo "  SCHEDULER_ASK_VIA=\"<what asked>\"."
    echo
    echo "available projects:"
    projects | sed 's/^/  /'
    exit 1
  fi

  # One line, no embedded newlines: the whole mechanism rests on the bold
  # span closing on the same physical line the entry opens. Fail loud
  # rather than silently flattening -- a squashed multi-line question is
  # exactly the unreadable output this command exists to prevent.
  # NOT `grep -q $'\n'`: a newline in a grep PATTERN is an alternation
  # separator, so that spelling matches every input and rejected every
  # question (caught by running it, 2026-07-28).
  if [ "$text" != "${text%%$'\n'*}" ]; then
    echo "scheduler ask: the question must be a single line (it becomes the entry's" >&2
    echo "  first line, which is what summary views print). Put detail in a follow-up" >&2
    echo "  paragraph by editing the file, or in DESIGN-NOTES.md and link it." >&2
    exit 1
  fi

  local today id via
  today="$(date '+%Y-%m-%d')"
  id="q-$(printf '%s%s' "$today" "$text" | sha1sum | cut -c1-6)"
  via="${SCHEDULER_ASK_VIA:-}"
  if [ -z "$via" ]; then
    if [ -t 0 ] && [ -t 1 ]; then via="interactive session"; else via="unattended run"; fi
  fi

  # Issues channel: the question IS the issue title, for the same reason
  # the generated file entry puts it first -- the title is what every
  # summary view (gh issue list, the notification mail, this tool) prints.
  # The stamped id/date/provenance move to the body, where they stay
  # greppable without crowding the line you actually read.
  if [ "$(answer_channel "$proj")" = "issues" ]; then
    require_gh || exit 1
    local slug url body
    slug="$(gh_repo_slug "$proj")" || exit 1
    # `gh issue create --label question` HARD FAILS on a repo where that
    # label does not exist yet -- which is every repo the first time it is
    # migrated. Creating them here makes the first `ask` on a new project
    # work instead of erroring on a detail nobody would guess.
    ensure_gh_labels "$slug"
    # Line 1 must declare DECISION or NO-DECISION (bin/lib/body-grammar.sh,
    # sourced by gh-sign, which gh itself is wrapped to enforce on every
    # `issue create`) -- an ask IS a decision request, so DECISION is the
    # honest declaration, naming @hf7y as the decider the grammar requires.
    # The DEFERRED/DELIVERS ledgers are genuinely empty at file time: filing
    # a question defers nothing (the question itself isn't deferred work,
    # it's the ask) and ships nothing outside this repo.
    body="$(printf '%s\n' \
      "DECISION: @hf7y -- $text" \
      "" \
      "---" \
      "\`$id\` · filed $today · via $via" \
      "" \
      "Answer by commenting on this issue (\`scheduler -q $proj\` renders every" \
      "open question into one buffer and posts your replies as comments), or" \
      "just reply here. A comment is the answer — leave the issue open, no" \
      "label needed." \
      "" \
      "How an answer binds (the ANSWER CONTRACT, rules A-D, 2026-07-29 — carried" \
      "here since #66 retired the QUESTIONS.md that used to hold it):" \
      "" \
      "- **A. Direction, not instruction.** A reply states standing intent;" \
      "  whoever acts re-derives the concrete action from CURRENT state, not" \
      "  from the state the question described. So a reply never goes stale." \
      "- **B. Re-probe the premise.** An instruction carries state claims;" \
      "  re-probe them. Premise false + action reversible -> act on the intent" \
      "  and flag the correction. Premise false + action irreversible -> stop" \
      "  and surface." \
      "- **C. Extract standing direction silently.** A reply that generalizes" \
      "  past its question is folded into the tracker, quoted and dated," \
      "  without asking first." \
      "- **D. No clean-check reports.** A re-probe that confirms the human was" \
      "  right produces no output at all." \
      "" \
      "<!-- DEFERRED -->" \
      "- none" \
      "<!-- /DEFERRED -->" \
      "" \
      "<!-- DELIVERS -->" \
      "- none" \
      "<!-- /DELIVERS -->")"
    # --body-file, not --body: a question containing a backtick or \$( is a
    # question, not a command. Same reason CLAUDE.md requires `git commit -F`.
    local bf; bf="$(mktemp)"; printf '%s\n' "$body" > "$bf"
    if ! url="$(gh issue create --repo "$slug" --title "$text" \
                  --label question --body-file "$bf" 2>&1)"; then
      rm -f "$bf"
      echo "scheduler ask: gh issue create FAILED against $slug -- nothing was recorded." >&2
      printf '%s\n' "$url" >&2
      exit 1
    fi
    rm -f "$bf"
    echo "filed as a GitHub issue on $slug (label: question)"
    echo "  $text"
    printf '  %s\n' "$url"
    return 0
  fi


  # NO FILE FALLBACK. Until hf7y/realisateur#293 this branch created a
  # QUESTIONS.md in the target project -- which RECREATED the retired file in
  # repos that had none, on every ask. #66 (2026-08-07) moved open questions to
  # GitHub issues; a project that has not been migrated is a config gap to fix,
  # not a reason to re-grow the channel.
  echo "scheduler ask: $proj's ANSWER_CHANNEL is not \`issues\`, and the markdown" >&2
  echo "  channel is retired (#66) -- nothing was recorded. Set ANSWER_CHANNEL=\"issues\"" >&2
  echo "  (and REPO_URL) in its conf, then ask again." >&2
  exit 1
}

# cmd_idea_editor -- the no-text-argument path (`scheduler -i <project>`
# with nothing after the project name). Built 2026-07-25: open $EDITOR
# instead of failing with a usage message. Collects the text and hands it
# to cmd_idea, which owns the filing for every project.
cmd_idea_editor() {
  local proj="$1"

  # Capture the text, then hand it to cmd_idea, which files a GitHub issue.
  # This branch used to build a whole FOCUS.md in a temp file and mv it over
  # the real one -- so the editor path pinned the clone exactly as the text
  # path did. Fixing only the text path would have left `scheduler -i <proj>`
  # with no argument still writing to disk: a front door that is GitHub only
  # when you pass your note on the command line is not a front door, and the
  # half that still wrote locally is the half `notify-senechal` does not use,
  # so nothing would have noticed. realisateur kept a `.idea`-file exception
  # here until 2026-08-29; it is gone for the same reason (see cmd_idea).
  local tmp content
  tmp="$(mktemp)"
  printf '%s\n' \
    "# Idea for $proj -- type below, then save+quit to submit." \
    "# It is filed as a GitHub issue (label: idea) on $proj's repository." \
    "# Leave this empty (comment lines only) and quit to cancel." \
    "" > "$tmp"
  "${EDITOR:-vi}" "$tmp"
  content="$(grep -v '^#' "$tmp" | sed '/^[[:space:]]*$/d')"
  rm -f "$tmp"
  if [ -z "$content" ]; then
    echo "scheduler: idea cancelled (nothing typed)"
    return 0
  fi
  # One line becomes the issue title; more than one keeps its shape, with
  # the first line as the title. cmd_idea owns the filing either way, so
  # there is one gh issue create in this file and not two.
  cmd_idea "$proj" "$content"
  return 0
}

cmd_idea() {
  local proj="${1:-}" text="${2:-}"
  if [ -z "$proj" ]; then
    echo "usage: scheduler idea <project> [\"idea text\"]"
    echo
    echo "  (omit the idea text to open \$EDITOR instead)"
    echo
    echo "available projects:"
    projects | sed 's/^/  /'
    exit 1
  fi

  if [ -z "$text" ]; then
    cmd_idea_editor "$proj"
    return
  fi

  # realisateur used to be excepted here: its note was written as a bare
  # `<slug>-<ts>.idea` file into `conf_field realisateur PROJECT_REPO_PATH`,
  # resolved against the CALLER's $HOME. Retired 2026-08-29. It was the last
  # write path in this file that required the caller to hold a clone of
  # someone else's project, and it addressed a channel the estate stopped
  # reading on 2026-08-06 ("Vault gets narrative. Issues get work" --
  # realisateur/PROSE-REAPING.md 3). Worse, its two unattended callers are
  # escalations -- usage-paced-runner.sh's PULL FROZEN and GAVE-UP -- so a
  # pull freeze filed its own alarm into the stale clone that the freeze had
  # already made unreadable. Those callers pass text and read the exit
  # status; both still work, and now land somewhere a human can count.
  # TRAP: THE FRONT DOOR IS GITHUB (Zach, 2026-08-05). This used to append to a LOCAL .scheduler/FOCUS.md and push it, which pinned every registered project to a checkout on whatever host the note was typed on -- senechal most of all, since notify-senechal wraps `scheduler -i senechal`.
  require_gh || exit 1
  local slug url body today
  slug="$(gh_repo_slug "$proj")" || exit 1

  # WHO IS CALLING, not just who this is FOR: until now the calling project
  # was only ever embedded as free prose by the calling agent's own
  # discipline (e.g. "vim-arcade: relinked 14 verbs..." as the note's first
  # words), never captured as data -- every issue was untriage-able by
  # source without reading the full body. `project_for_path` already
  # answers "which registered project owns this filesystem path" for the
  # busy-marker machinery above; reused here against $PWD so filing a note
  # gains a `from:<calling-project>` label for free. A shell outside every
  # checkout (Zach typing interactively) is not a defect to route around --
  # it is the "zach" source.
  local from_proj from_label
  from_proj="$(project_for_path "$PWD")" || from_proj="zach"
  from_label="from:$from_proj"

  ensure_gh_labels "$slug" "$from_label"
  today="$(date '+%Y-%m-%d %H:%M')"

  # THE TITLE IS NOT THE NOTE. GitHub caps an issue title at 256 characters
  # and rejects the whole call above it -- found 2026-08-05 by filing the
  # first real note through this path:
  #   scheduler idea: gh issue create FAILED against hf7y/scheduler
  #   GraphQL: Title is too long (maximum is 256 characters)
  # It failed loud and recorded nothing, which is right, but it made the
  # front door unusable for any note longer than a sentence -- and a note
  # longer than a sentence is the normal case for `notify-senechal`, which
  # describes what changed, where, and how to retire it.
  #
  # cmd_ask gets away with title=text because a question IS one line. An
  # idea is not. So: first line, truncated on a word boundary, and the FULL
  # text always goes in the body -- the title is an index entry, never the
  # record. Truncation is marked, so a reader can tell a shortened title
  # from a short one.
  local title first
  first="$(printf '%s\n' "$text" | head -1)"
  if [ "${#first}" -gt 200 ]; then
    title="$(printf '%s' "${first:0:200}" | sed 's/[[:space:]][^[:space:]]*$//')..."
  else
    title="$first"
  fi
  # A multi-line note whose first line is already the whole title would
  # otherwise look complete in every summary view while carrying more.
  case "$text" in *$'\n'*) [ "$title" = "$first" ] && title="$title [...]" ;; esac
  body="$(printf '%s\n' \
    "$text" \
    "" \
    "---" \
    "filed $today via \`scheduler -i $proj\` on $(hostname -s)" \
    "" \
    "Triage this on ${proj}'s next run: fold it into FOCUS.md if it is work," \
    "answer and close it if it is a note. Closing IS the acknowledgement --" \
    "there is no separate label to add.")"
  # --body-file, not --body: a note containing a backtick or $( is a note,
  # not a command. Same reason CLAUDE.md requires `git commit -F`.
  local bf; bf="$(mktemp)"; printf '%s\n' "$body" > "$bf"
  if ! url="$(gh issue create --repo "$slug" --title "$title" \
                --label idea --label "$from_label" --body-file "$bf" 2>&1)"; then
    rm -f "$bf"
    echo "scheduler idea: gh issue create FAILED against $slug -- NOTHING was recorded." >&2
    printf '%s\n' "$url" >&2
    exit 1
  fi
  rm -f "$bf"
  echo "filed as a GitHub issue on $slug (labels: idea, $from_label)"
  echo "  $text"
  printf '  %s\n' "$url"
  return 0
}

RUNNER_CONF="$SCHED_ROOT/schedule/_runner.conf"

runner_conf_field() {
  local field="$1"
  [ -f "$RUNNER_CONF" ] || return 1
  grep -E "^${field}=" "$RUNNER_CONF" | tail -1 | cut -d= -f2- | tr -d '"'
}

# installed_scripts -- every repo bin/ file that also has a counterpart at
# the same basename under ~/.local/bin (symlink or real file, both).
#
# RETIRES `deployable_scripts()` + `scheduler pacing deploy` (removed
# 2026-07-27): all four installed counterparts are now symlinks into the
# repo, so there is no copy left to re-deploy and no drift for a `deploy`
# verb to fix. What remains worth checking is the PRECONDITION -- that
# each one is still a symlink and still resolves -- because a stray `cp`
# over a symlink silently re-creates the whole drift class this retires
# (it already bit once: usage-paced-runner.sh ran two days stale as a
# copy, 2026-07-26). realisateur/PLAYBOOK.md Play 2.
installed_scripts() {
  local f b dep
  for f in "$SCHED_ROOT"/bin/*.sh "$SCHED_ROOT/bin/scheduler"; do
    b="$(basename "$f")"
    dep="$HOME/.local/bin/$b"
    [ -e "$dep" ] || [ -L "$dep" ] || continue
    echo "$b"
  done
}

# pacing_show_human -- translate usage-gate.sh's key=val + summary lines
# into plain English. Takes the gate's stdout+stderr as $1.
pacing_show_human() {
  local out="$1" verdict window
  verdict="$(printf '%s\n' "$out" | grep -oE 'verdict=[A-Z]+' | cut -d= -f2)"
  if [ "$verdict" = "RUN" ]; then
    echo "Jobs are allowed to run right now -- you're using less than your fair"
    echo "share of quota for this point in the billing window."
  elif [ "$verdict" = "HOLD" ]; then
    echo "Jobs are paused right now -- either you're on pace to spend the"
    echo "window's quota already, or a safety ceiling/rejection kicked in."
  else
    echo "Couldn't read live usage (probe failed) -- treated as paused, just in case."
  fi
  echo
  while IFS= read -r window; do
    [ -n "$window" ] || continue
    local label util burnline slack resets
    label="$(printf '%s\n' "$window" | grep -oE '^window=\S+' | cut -d= -f2)"
    util="$(printf '%s\n' "$window" | grep -oE 'util=[0-9.]+' | cut -d= -f2)"
    burnline="$(printf '%s\n' "$window" | grep -oE 'burnline=[0-9.]+' | cut -d= -f2)"
    slack="$(printf '%s\n' "$window" | grep -oE 'slack=[-+0-9.]+' | cut -d= -f2)"
    resets="$(printf '%s\n' "$window" | grep -oE 'resets_in_min=[0-9]+' | cut -d= -f2)"
    [ -n "$label" ] || continue
    local util_pct burnline_pct verb amount
    util_pct="$(awk -v u="$util" 'BEGIN{printf "%.0f", u*100}')"
    burnline_pct="$(awk -v b="$burnline" 'BEGIN{printf "%.0f", b*100}')"
    if awk -v s="$slack" 'BEGIN{exit !(s>=0)}'; then verb="under"; else verb="over"; fi
    amount="$(awk -v s="$slack" 'BEGIN{v=s; if(v<0)v=-v; printf "%.0f", v*100}')"
    local win_name="$label window"
    [ "$label" = "5h" ] && win_name="rolling 5-hour window"
    [ "$label" = "7d" ] && win_name="rolling 7-day window"
    echo "  $win_name: ${util_pct}% used, expected ~${burnline_pct}% by now -- ${amount}pts $verb pace"
    [ -n "$resets" ] && echo "    resets in ${resets} min"
  done < <(printf '%s\n' "$out" | grep '^window=')
  local drift
  drift="$(printf '%s\n' "$out" | grep '^hold_reasons=')"
  [ -n "$drift" ] && { echo; echo "  ($drift)"; }
}

cmd_pacing_show() {
  local human=0
  case "${1:-}" in -h|--human) human=1 ;; esac
  local cron env max
  cron="$(runner_conf_field RUNNER_CRON)"
  env="$(runner_conf_field RUNNER_ENV)"
  max="$(printf '%s\n' "$env" | grep -oE 'PACED_MAX_PER_TICK=[0-9]+' | cut -d= -f2)"
  [ -n "$max" ] || max="8 (default -- not overridden in RUNNER_ENV)"
  echo "scheduler pacing -- usage-paced-runner.sh dispatch cadence"
  echo
  if [ "$human" = 1 ]; then
    echo "  Background jobs get checked every ${cron:-<unset -- no tick installed>} for whether"
    echo "  they're allowed to run, and up to $max can fire per check."
  else
    echo "  tick interval:       ${cron:-<unset -- no _runner.conf tick installed>}"
    echo "  max dispatches/tick: $max"
  fi
  echo
  echo "live gate (usage-gate.sh, account-wide):"
  if [ -x "$HOME/.local/bin/usage-gate.sh" ]; then
    local gate_out
    gate_out="$("$HOME/.local/bin/usage-gate.sh" 2>&1)"
    if [ "$human" = 1 ]; then
      pacing_show_human "$gate_out" | sed 's/^/  /'
    else
      printf '%s\n' "$gate_out" | sed 's/^/  /'
    fi
  else
    echo "  (no ~/.local/bin/usage-gate.sh -- not deployed)"
  fi
  echo
  echo "installed scripts (~/.local/bin -> repo bin/, must be symlinks):"
  local b dep tgt any=0
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    any=1
    dep="$HOME/.local/bin/$b"
    if [ ! -L "$dep" ]; then
      echo "  COPY   $b   (a real file, not a symlink -- CAN GO STALE; fix:"
      echo "               ln -sfn '$SCHED_ROOT/bin/$b' '$dep')"
      continue
    fi
    tgt="$(readlink -f "$dep" 2>/dev/null || true)"
    if [ -z "$tgt" ] || [ ! -e "$tgt" ]; then
      echo "  BROKEN $b   (symlink resolves to nothing: $(readlink "$dep"))"
    elif [ "$(basename "$tgt")" != "$b" ]; then
      echo "  FOREIGN $b  (symlink points at a different script: $tgt)"
    else
      echo "  OK     $b -> $tgt"
    fi
  done < <(installed_scripts)
  [ "$any" = 1 ] || echo "  (no repo bin/ script is installed under ~/.local/bin)"
}

cmd_pacing_tick() {
  local newcron="$*"
  [ -n "$newcron" ] || { echo "usage: scheduler pacing tick '<cron-expr>'" >&2; exit 1; }
  local nf; nf="$(awk '{print NF}' <<<"$newcron")"
  [ "$nf" -eq 5 ] || { echo "scheduler: cron expr needs exactly 5 fields, got: $newcron" >&2; exit 1; }
  [ -f "$RUNNER_CONF" ] || { echo "scheduler: no $RUNNER_CONF -- pacing isn't set up" >&2; exit 1; }
  local old; old="$(runner_conf_field RUNNER_CRON)"
  if [ "$old" = "$newcron" ]; then
    echo "RUNNER_CRON already $newcron -- nothing to change"
    return 0
  fi
  sed -i "s|^RUNNER_CRON=.*|RUNNER_CRON=\"$newcron\"|" "$RUNNER_CONF"
  echo "RUNNER_CRON: ${old:-<unset>} -> $newcron"
  "$SCHED_ROOT/bin/sync-crontab.sh" --apply
  cmd_commit_file "$RUNNER_CONF" "scheduler pacing: tick interval ${old:-<unset>} -> $newcron"
}

cmd_pacing_max() {
  local n="${1:-}"
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] || { echo "usage: scheduler pacing max <positive integer>" >&2; exit 1; }
  [ -f "$RUNNER_CONF" ] || { echo "scheduler: no $RUNNER_CONF -- pacing isn't set up" >&2; exit 1; }
  local old_env old_max
  old_env="$(runner_conf_field RUNNER_ENV)"
  old_max="$(printf '%s\n' "$old_env" | grep -oE 'PACED_MAX_PER_TICK=[0-9]+' | cut -d= -f2)"
  [ -n "$old_max" ] || old_max="8 (default)"
  if [ "$old_max" = "$n" ]; then
    echo "PACED_MAX_PER_TICK already $n -- nothing to change"
    return 0
  fi
  if grep -q '^RUNNER_ENV=' "$RUNNER_CONF"; then
    sed -i "s|^RUNNER_ENV=.*|RUNNER_ENV=\"PACED_MAX_PER_TICK=$n\"|" "$RUNNER_CONF"
  else
    sed -i "/^RUNNER_CRON=/a RUNNER_ENV=\"PACED_MAX_PER_TICK=$n\"" "$RUNNER_CONF"
  fi
  echo "PACED_MAX_PER_TICK: $old_max -> $n"
  "$SCHED_ROOT/bin/sync-crontab.sh" --apply
  cmd_commit_file "$RUNNER_CONF" "scheduler pacing: max dispatches/tick $old_max -> $n"
}

cmd_pacing() {
  case "${1:-}" in
    ""|-h|--human) cmd_pacing_show "${1:-}" ;;
    show) shift; cmd_pacing_show "${1:-}" ;;
    tick) shift; cmd_pacing_tick "$@" ;;
    max) cmd_pacing_max "${2:-}" ;;
    deploy)
      # retired 2026-07-27: installed scripts are symlinks into the repo,
      # so there is no copy to re-deploy. Stub, not silence -- a `cp`-era
      # habit should fail loud, not look like it worked.
      echo "scheduler: 'pacing deploy' is retired -- ~/.local/bin entries are symlinks into the repo, so the repo IS what runs. \`scheduler pacing\` reports any that reverted to a copy." >&2
      exit 1
      ;;
    *)
      echo "usage: scheduler pacing [show|-h|tick '<cron-expr>'|max <n>]" >&2
      exit 1
      ;;
  esac
}

# oneline <text> -- collapse a multi-line git error into one readable line.
# Reporting only the FIRST line loses the part that matters (git puts the
# summary first and the offending filenames after it, e.g. "The following
# untracked working tree files would be overwritten by merge:" / "<file>"),
# and the callers below print these inside a single "reason:" line.
oneline() {
  printf '%s' "$1" | tr '\n\t' '  ' | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//' | cut -c1-300
}

cmd_commit_file() {
  # THE single implementation of "safely auto-commit one file, with a
  # staleness warning first" -- shared by `scheduler -i` (calls this
  # directly, in-process) AND the vim auto-commit hook (shells out to
  # `scheduler _commit-file`, backgrounded, instead of re-implementing
  # this same git logic a second time in vimscript). Change behavior
  # here once, both callers get it. (Renamed from cmd_idea_push_reminder
  # 2026-07-20 when this stopped being idea-specific.)
  #
  # Auto-COMMITS and, as of 2026-07-22, auto-PUSHES too (changed from
  # "never automatic" -- Zach's own call: every commit through this path
  # is a single markdown file, exactly the "trivially revertible" class
  # already named in FOCUS.md's auto-push backlog note, and every
  # registered project's scheduled jobs run against a dedicated clone
  # that resets hard to origin before each dispatch -- a commit sitting
  # local-only is exactly as invisible to that clone as an uncommitted
  # edit, so withholding the push bought no real safety, just latency).
  # Still safe by construction: push is only attempted when NOT behind
  # origin (a real fast-forward), and a push failure here never forces or
  # rewrites anything -- it just falls back to the old "commit locally,
  # push by hand" message.
  local path="$1" msg="${2:-}" repo
  repo="$(git -C "$(dirname "$path")" rev-parse --show-toplevel 2>/dev/null)"
  [ -n "$repo" ] || return 0
  # `git diff --quiet` only sees changes to ALREADY-TRACKED files -- it is
  # silent (exit 0, "no differences") for a brand-new untracked file, which
  # made this bail out and skip committing entirely for exactly the case
  # (a newly created file, e.g. the sweep backstop below adopting one) it
  # most needed to handle. `git status --porcelain` catches both untracked
  # and modified.
  if [ -z "$(git -C "$repo" status --porcelain -- "$path" 2>/dev/null)" ]; then
    return 0
  fi
  # Refuse a file this path cannot safely adopt, rather than committing it
  # under the human's name (2026-07-27, from realisateur /ideate's proposal
  # 1: the 0e9b6a6 live exhibit -- a `~:30` tick caught BLOCKERS.md mid
  # vimdiff-merge and committed two unresolved conflict blocks plus a
  # verbatim duplicate "## realisateur" section under Zach's name; a dirty
  # tree the human returns to is strictly better than a corrupt commit).
  # Both checks are cheap and offline -- a literal conflict marker at line
  # start, and a duplicate "## <heading>" (fence-skipped, same convention
  # bin/blockers-freshness-check.sh already uses so the two can't drift
  # about what "outside a fenced block" means). Runs before EITHER commit
  # path below (focus-commit for multi-writer files, or the bare path for
  # everything else) so it guards whichever one a given file takes.
  if [ -f "$path" ]; then
    if grep -qE '^(<<<<<<<( |$)|=======$|>>>>>>>( |$))' "$path" 2>/dev/null; then
      echo "REFUSED: $path contains an unresolved conflict marker (<<<<<<<, =======, or >>>>>>> at line start) -- left as an uncommitted edit, resolve by hand" >&2
      return 1
    fi
    local dup_headings
    dup_headings="$(awk '
      BEGIN{fence=0}
      /^[[:space:]]*(```|~~~)/{fence=!fence; next}
      !fence && /^##[[:space:]]+.+$/{print}
    ' "$path" | sort | uniq -d)"
    if [ -n "$dup_headings" ]; then
      echo "REFUSED: $path has a duplicate heading -- left as an uncommitted edit, resolve by hand:" >&2
      printf '  %s\n' "$dup_headings" >&2
      return 1
    fi
  fi
  # --- multi-writer files go through the atomic guard, not bare git ---------
  # FOCUS.md / QUESTIONS.md are written by independent systems (this tool,
  # the vim auto-commit hook, nightly-batch, and interactive sessions)
  # with no coordination between them. Five divergences in three days
  # (realisateur, home-assistant, scheduler, bibliothecaire, wtul), most
  # of them "clean" -- different sections, silent merge, nobody notices until
  # someone re-probes. The fetch/ff/commit/push below is exactly the bare
  # sequence that loses those races; `focus-commit` (realisateur-owned, on
  # PATH) is the same operation made indivisible: stage exactly the named
  # file, rebase on rejection, and VERIFY the rebase did not change what the
  # commit means. Everything that is not one of these two files stays on
  # the path below -- it is safe for single-writer state.
  case "$(basename "$path")" in
    FOCUS.md|QUESTIONS.md)
      local rel fc_msgfile fc_rc
      if ! command -v focus-commit >/dev/null 2>&1; then
        # A missing guard is a finding, not an excuse to hand-roll the racy
        # sequence anyway. Keep the edit (commit locally, no push -- an
        # unpushed commit is recoverable; a lost race is not) and say so.
        echo "WARNING: focus-commit is NOT on PATH -- refusing to auto-push a multi-writer file ($path) with the bare git sequence it exists to replace." >&2
        [ -n "$msg" ] || msg="Human edit via scheduler: $(basename "$path") ($(date '+%Y-%m-%dT%H:%M'))"
        if git -C "$repo" add -- "$path" && git -C "$repo" commit -q -m "$msg" -- "$path"; then
          echo "  committed locally in $repo but NOT pushed. Install realisateur's focus-commit shim, then: focus-commit \"$repo\" <msgfile> \"$path\"" >&2
        else
          echo "  (auto-commit failed -- left as an uncommitted edit at $path)" >&2
        fi
        return 0
      fi
      rel="$(git -C "$repo" ls-files --full-name -- "$path" 2>/dev/null | head -1)"
      [ -n "$rel" ] || rel="$(realpath --relative-to="$repo" -- "$path" 2>/dev/null)" || rel="$path"
      [ -n "$msg" ] || msg="Human edit via scheduler: $(basename "$path") ($(date '+%Y-%m-%dT%H:%M'))"
      fc_msgfile="$(mktemp)" || { echo "(mktemp failed -- left as an uncommitted edit at $path)" >&2; return 0; }
      printf '%s\n' "$msg" >"$fc_msgfile"
      focus-commit "$repo" "$fc_msgfile" "$rel"; fc_rc=$?
      rm -f "$fc_msgfile"
      if [ "$fc_rc" -ne 0 ]; then
        echo "WARNING: focus-commit exited $fc_rc for $path (reason above) -- the edit is NOT on origin. A scheduled run resets its clone --hard to origin, so it stays invisible to dispatch until this is resolved by hand." >&2
      fi
      return 0
      ;;
  esac
  # Freshness check BEFORE committing -- the actual fix for "do I need to
  # git fetch && git status by hand before every edit" (2026-07-20): no,
  # the tool checks instead. Doesn't block the commit (the file content is
  # always safe to keep locally regardless), just warns loudly if this
  # commit is about to land on a stale base, which is exactly the failure
  # mode that caused a real divergence (home-assistant, same day). `git
  # fetch` against a local bare remote (~/git-remotes/*.git, most projects
  # here) is effectively instant; against a real GitHub remote it's a
  # normal network round-trip -- worth it for what it catches.
  #
  # 2026-07-26: the check used to STOP at warning -- it printed a NOTE,
  # committed onto the stale base anyway, then skipped the push. That is
  # not a warning about a stranded commit, it is the thing that MANUFACTURES
  # one: a scheduled run resets its own dedicated clone `--hard` to origin
  # before every dispatch, so a local-only commit is exactly as invisible to
  # dispatch as an uncommitted edit, and the NOTE scrolls past in cron
  # output. Real cost, twice over: vim-arcade and wtul both carried
  # `Idea added via 'scheduler -i'` commits that no dispatch ever saw
  # (FOCUS.md, 2026-07-25 propagation findings -- "the freshness check is a
  # warning where it needs to be a stop or a fix"). It is now a FIX for the
  # only case that can be fixed automatically, and a loud stop otherwise.
  local branch behind ahead ff_out stall_reason=""
  branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  timeout 20 git -C "$repo" fetch --quiet 2>/dev/null
  behind="$(git -C "$repo" rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)"
  ahead="$(git -C "$repo" rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo 0)"
  if [ "${behind:-0}" -gt 0 ] 2>/dev/null; then
    if [ "${ahead:-0}" -gt 0 ] 2>/dev/null; then
      # Genuinely diverged. Never automatic -- same rule report_divergence
      # already states ("NOT auto-resolved, ever").
      stall_reason="DIVERGED from origin/$branch ($ahead local-only, $behind remote-only commit(s)) -- reconciling that is a merge decision, never an automatic one"
      echo "WARNING: $repo has DIVERGED from origin/$branch -- $ahead local-only, $behind remote-only commit(s). Committing your edit locally, but NOT fast-forwarding or pushing: that needs a real merge decision."
    elif ff_out="$(git -C "$repo" merge --ff-only "origin/$branch" 2>&1)"; then
      # Pure fast-forward: no merge decision exists to get wrong, and
      # --ff-only refuses rather than inventing a merge commit or
      # clobbering local changes, so this can only succeed when it is
      # safe. The edit itself is untracked/modified in the worktree at
      # this point, so it survives the fast-forward and then commits on
      # top of origin's current state -- and can push.
      echo "$repo was $behind commit(s) behind origin/$branch -- fast-forwarded first so this edit lands on origin's current state"
      behind=0
    else
      stall_reason="behind origin/$branch by $behind commit(s) and NOT fast-forwardable -- git said: $(oneline "$ff_out")"
      echo "WARNING: $repo is $behind commit(s) behind origin/$branch and could NOT fast-forward -- committing locally (your edit is safe) but the push will be skipped. Reason: $(oneline "$ff_out")"
    fi
  fi
  [ -n "$msg" ] || msg="Human edit via scheduler: $(basename "$path") ($(date '+%Y-%m-%dT%H:%M'))"
  if git -C "$repo" add -- "$path" && git -C "$repo" commit -q -m "$msg" -- "$path"; then
    local push_out="" push_rc=0
    if [ "${behind:-0}" -gt 0 ] 2>/dev/null; then
      echo "WARNING: committed locally in $repo but NOT pushed -- a scheduled run resets its own clone --hard to origin, so this edit stays invisible to dispatch until it lands on origin."
      echo "  push reason: $stall_reason"
      echo "  recover with: git -C \"$repo\" pull --rebase && git -C \"$repo\" push"
      return 0
    fi
    # Was `push --quiet 2>/dev/null`, which threw the failure away and then
    # GUESSED at the cause ("check credentials/network"). Same lesson as
    # lib/sweep-loop-common.sh's `push reason:` line: say WHY, from the
    # command's own output, rather than offering a plausible diagnosis
    # nobody verified.
    push_out="$(timeout 20 git -C "$repo" push 2>&1)"; push_rc=$?
    if [ "$push_rc" -eq 0 ]; then
      echo "committed + pushed in $repo"
    else
      echo "WARNING: committed locally in $repo but NOT pushed -- a scheduled run resets its own clone --hard to origin, so this edit stays invisible to dispatch until it lands on origin."
      echo "  push reason: git push exited $push_rc -- $(oneline "$push_out")"
      echo "  recover with: git -C \"$repo\" push"
    fi
  else
    echo "(auto-commit failed -- left as an uncommitted edit at $path; commit by hand)" >&2
  fi
}

cmd_next() {
  local count="${1:-8}"
  case "$count" in ''|*[!0-9]*) count=8 ;; esac
  load_paced_pool || { echo "scheduler: no enabled participants in $PACED_CONF" >&2; exit 1; }
  local n="${#POOL_NAMES[@]}"
  local last=-1
  [ -f "$PACED_PTR" ] && last="$(cat "$PACED_PTR" 2>/dev/null || echo -1)"
  case "$last" in ''|*[!0-9-]*) last=-1 ;; esac
  echo "scheduler next -- real usage-paced-runner.sh rotation order (dispatched whenever"
  echo "usage-gate.sh reports spare weekly quota, NOT a fixed clock -- see run.log for when)"
  echo
  local i idx
  for ((i=1; i<=count && i<=n; i++)); do
    idx=$(( (last + i) % n ))
    printf '  %2d. %s\n' "$i" "${POOL_NAMES[$idx]}"
  done
  echo
  echo "(rotation pool size $n, incl. weight-repeats -- from $PACED_CONF [$PACED_CONF_SRC];"
  echo " last actually dispatched pool slot: $last -- see ~/.local/share/scheduler-paced-runner/run.log)"
}

cmd_run() {
  local proj="${1:-}"
  if [ -z "$proj" ]; then
    echo "usage: scheduler run <project>"
    echo
    echo "paced participants:"
    awk -F'|' '$1!~/^#/ && $1!="" {print "  "$1}' "$PACED_CONF" 2>/dev/null
    exit 1
  fi
  local line
  line="$(paced_conf_line "$proj")"
  if [ -z "$line" ]; then
    echo "scheduler: '$proj' is not a participant in $PACED_CONF" >&2
    exit 1
  fi
  local name enabled rest maybe_weight cmd
  IFS='|' read -r name enabled rest <<<"$line"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  case "$rest" in
    [0-9]*'|'*)
      maybe_weight="${rest%%|*}"
      if [[ "$maybe_weight" =~ ^[0-9]+$ ]]; then rest="${rest#*|}"; fi
      ;;
  esac
  cmd="${rest%%#*}"
  cmd="$(printf '%s' "$cmd" | sed -e 's/[[:space:]]*$//')"
  if [ "${enabled// /}" != "1" ]; then
    echo "NOTE: $proj is disabled (enabled=0) in $PACED_CONF -- running it once anyway;"
    echo "it stays out of the automatic rotation until you re-enable it there."
  fi
  echo "scheduler run: dispatching $proj -> $cmd (bypassing usage-gate.sh, one cycle, right now)"
  # shellcheck disable=SC2086
  exec $cmd
}

cmd_weight() {
  local proj="${1:-}" newval="${2:-}"
  if [ -z "$proj" ]; then
    echo "usage: scheduler weight <project> [n]"
    exit 1
  fi
  local line
  line="$(paced_conf_line "$proj")"
  if [ -z "$line" ]; then
    echo "scheduler: '$proj' is not a participant in $PACED_CONF" >&2
    exit 1
  fi
  local name enabled rest maybe_weight cur_weight=1 tail_field
  IFS='|' read -r name enabled rest <<<"$line"
  tail_field="${rest#"${rest%%[![:space:]]*}"}"
  case "$tail_field" in
    [0-9]*'|'*)
      maybe_weight="${tail_field%%|*}"
      if [[ "$maybe_weight" =~ ^[0-9]+$ ]]; then
        cur_weight="$maybe_weight"
        tail_field="${tail_field#*|}"
      fi
      ;;
  esac

  if [ -z "$newval" ]; then
    echo "$proj: weight=$cur_weight enabled=$enabled"
    return
  fi
  if ! [[ "$newval" =~ ^[0-9]+$ ]] || [ "$newval" -lt 1 ]; then
    echo "scheduler: weight must be a positive integer" >&2
    exit 1
  fi
  if [ "$newval" = "$cur_weight" ]; then
    echo "$proj: weight already $cur_weight, nothing to change"
    return
  fi

  local newline="${name}|${enabled}|${newval}|${tail_field}"
  awk -v proj="$proj" -v newline="$newline" -F'|' '
    $1==proj { print newline; next } { print }
  ' "$PACED_CONF" > "$PACED_CONF.tmp" && mv "$PACED_CONF.tmp" "$PACED_CONF"
  echo "set $proj weight: $cur_weight -> $newval"
  cmd_commit_file "$PACED_CONF" "scheduler weight: $proj $cur_weight -> $newval in $PACED_CONF_SRC (human override via \`scheduler weight\`)"

  # The commit above IS the trace. This used to ALSO drop a
  # `weight-override-<proj>-<ts>.idea` file into realisateur's checkout, to
  # tell its next pass a human had overridden the value (docs/priority-weight.md
  # -- the weight VALUE is realisateur's judgment call, this command only edits
  # + flags, never silently). Retired 2026-08-29 with the rest of the `.idea`
  # channel: the flag carried nothing the commit does not already carry -- it
  # named the project, both values, and which host's rotation file (that is
  # $PACED_CONF_SRC, recorded in the commit) -- and it bought that redundancy
  # by requiring a clone of realisateur under the caller's own $HOME.
  echo "recorded in $PACED_CONF_SRC's history -- no separate flag file"
}

# Prints "<unanswered> <answered>" for one QUESTIONS.md. One
# implementation shared by cmd_glance and cmd_questions_list -- these two
# views disagreeing about what counts as an open question is exactly the
# "meaningless count" complaint that drove the counting rules below.
#
# Distinguishes genuinely unanswered questions from ones you've already
# replied to inline but the project's next run hasn't yet processed --
# added 2026-07-20 so the count reflects your own inline edits instead of
# only updating once a run clears the block. A bullet counts as answered
# if a real `> ` reply (not the "(answer inline here)" placeholder)
# appears before the next bullet/heading; RESOLVED/ACKNOWLEDGED bullets
# are excluded entirely either way (case-insensitive via tolower(), not
# just the first letter -- a plain-ASCII "resolved|acknowledged" regex
# match silently missed full-caps "RESOLVED" during testing).
# Real question bullets always start `- **YYYY-MM-DD` (the format every
# command is told to append) -- requiring that date prefix, plus skipping
# fenced ``` code blocks, excludes the template's own "How to answer"
# boilerplate (an example bullet inside a code fence, plus prose bullets
# like "- **`/nightly-batch` owns answer-processing.**") which a bare
# `/^- \*\*/` match was wrongly counting as real open questions on every
# project using the standard QUESTIONS.md template (found 2026-07-22:
# every project showed 2-4 phantom "open questions" from this).
questions_counts() {
  local qfile="$1"
  [ -f "$qfile" ] || { echo "0 0"; return 0; }
  local out
  out="$(awk '
    BEGIN{unanswered=0; answered=0; is_resolved=0; has_reply=0; started=0; infence=0}
    /^```/ { infence = !infence; next }
    infence { next }
    # Ledger sections are archive, not open questions (2026-07-28).
    /^## / {
      if (started) { if (!is_resolved) { if (has_reply) answered++; else unanswered++ } }
      started=0
      dead = (tolower($0) ~ /consumed|resolved|archive/) ? 1 : 0
      next
    }
    dead { next }
    # A real question bullet is one that carries EITHER a generated
    # `q-xxxxxx` id (scheduler ask, 2026-07-28) OR the legacy
    # `YYYY-MM-DD` prefix. Requiring one of the two still excludes the
    # template boilerplate bullets that the bare /^- \*\*/ match wrongly
    # counted in 2026-07-22 -- but no longer silently counts a generated,
    # question-first entry as nothing at all, which is what a plain
    # date-prefix requirement did to the first one filed.
    /^- \*\*/ && ($0 ~ /`q-[0-9a-f]+`/ || $0 ~ /^- \*\*[0-9]{4}-[0-9]{2}-[0-9]{2}/) {
      if (started) { if (!is_resolved) { if (has_reply) answered++; else unanswered++ } }
      started=1
      if ($0 ~ /`q-[0-9a-f]+`/)
        is_resolved = 0
      else
        is_resolved = (tolower($0) ~ /resolved|acknowledged/) ? 1 : 0
      has_reply=0
      next
    }
    started && /^[ \t]*>[ \t]?/ {
      line=$0
      sub(/^[ \t]*>[ \t]?/, "", line)
      if (line !~ /^\(answer inline here\)/) has_reply=1
    }
    END { if (started) { if (!is_resolved) { if (has_reply) answered++; else unanswered++ } }
          print unanswered, answered }
  ' "$qfile" 2>/dev/null)"
  echo "${out:-0 0}"
}

# True when this project's QUESTIONS.md changed since you last opened it
# via `scheduler questions`/`status` -- the `*` in both question views,
# added 2026-07-22 so an open count doesn't read the same whether it's
# brand new or something you've already seen and just haven't gotten to.
# Approximate (file mtime vs a per-project "last opened" timestamp), not
# a real read-receipt. Only meaningful when something is still
# unanswered, so a zero count is never starred.
questions_unopened() {
  local proj="$1" q_unanswered="${2:-0}"
  [ "$q_unanswered" -gt 0 ] 2>/dev/null || return 1
  local qmtime qseen
  qmtime="$(stat -c %Y "$SCHED_ROOT/questions/$proj.md" 2>/dev/null || echo 0)"
  qseen="$(get_seen "$proj")"
  [ "$qmtime" -gt "$qseen" ] 2>/dev/null
}

cmd_questions_list() {
  # `scheduler -q` with no project. Was a bare "available projects:" dump
  # from require_project, which made you re-run the full glance (or open
  # files one by one) just to find out which project actually wanted
  # something from you. Same n/m + `*` vocabulary as the glance's
  # QUESTIONS column, no new state -- this is the glance filtered to the
  # one question "does anything need my answer", nothing more.
  echo "scheduler questions — $(date '+%Y-%m-%d %H:%M')"
  echo
  local rows="" quiet="" blind="" n_unanswered=0 n_unopened=0 n_projects=0 n_blind=0
  while IFS= read -r proj; do
    local qfile="$SCHED_ROOT/questions/$proj.md"
    local qu qa counts
    # A project we could not COUNT is not a project with nothing open. It
    # gets its own row and its own tally line -- BLIND reported as OK is
    # the failure this whole channel exists to avoid.
    if ! counts="$(project_questions_counts "$proj")"; then
      blind="$blind $proj"; n_blind=$(( n_blind + 1 ))
      continue
    fi
    read -r qu qa <<<"$counts"
    local total=$(( qu + qa ))
    if [ "$total" -eq 0 ]; then
      quiet="$quiet $proj"
      continue
    fi
    n_projects=$(( n_projects + 1 ))
    n_unanswered=$(( n_unanswered + qu ))
    # Note only where the row is NOT the ordinary "waiting on you" case:
    # printing that on 17 of 18 rows is column noise, and the `*` already
    # carries the one distinction that matters at a glance.
    local star=" " note="" score=$qu
    if questions_unopened "$proj" "$qu"; then
      star="*"; n_unopened=$(( n_unopened + 1 ))
      score=$(( score + 1000 ))
    elif [ "$qu" -eq 0 ]; then
      note="all replied — waiting on ${proj}'s next run to process them"
    fi
    rows="$rows$(printf '%06d\t  %s %-20s %-7s %s' \
      "$score" "$star" "$proj" "$qu/$total" "$note")"$'\n'
  done < <(projects)

  if [ "$n_projects" -eq 0 ] && [ "$n_blind" -eq 0 ]; then
    # Nothing open anywhere: the counts and the n/m legend below would all
    # be zeroes explaining a table that isn't there.
    echo "  no open questions on any project."
    echo
    echo "-> scheduler -q <project>   open one anyway (answered/resolved history)"
    return 0
  elif [ "$n_projects" -eq 0 ]; then
    echo "  no open questions on any project this could READ -- see BLIND below."
  else
    # sed trims the trailing pad left by the fixed-width count column on
    # rows with no note -- invisible in a terminal, but it turns a copied
    # row into whitespace junk when you paste one into a file.
    printf '%s' "$rows" | sort -rn | cut -f2- | sed 's/[[:space:]]*$//'
  fi
  echo
  # Counts before the legend: the numbers are the point, the vocabulary
  # note is the footnote.
  echo "  $n_unanswered unanswered across $n_projects project(s); $n_unopened with unread changes (*)."
  echo "  n/m = unanswered/total; total includes replies your project run hasn't processed yet."
  [ -n "$quiet" ] && echo "  nothing open:$quiet"
  [ -n "$blind" ] && echo "  BLIND — could not read (see the errors above), NOT 'nothing open':$blind"
  echo
  echo "-> scheduler -q <project>   open one"
  # Exit status carries it too, so a script that only reads $? still learns
  # this overview was incomplete.
  [ "$n_blind" -eq 0 ]
}

cmd_glance() {
  echo "scheduler — $(date '+%Y-%m-%d %H:%M') (paced rotation, dispatched whenever usage-gate.sh has spare quota)"
  echo
  # The full column-by-column explanation that used to print here every
  # time moved to docs/scheduler-cli.md (`scheduler man`) -- flagged
  # 2026-07-22: "move all this text to a man page, reduce to a single
  # line summary above the column headers."
  echo "  (* = new since you last opened it here; column details: scheduler man)"
  printf '  %-16s %-10s %-10s %-10s %s\n' "PROJECT" "QUESTIONS" "LAST RUN" "ETA" "NEXT UP"
  local global_eta_secs=0 global_eta_proj="" any_unknown_eta=0
  local any_unpushed=0
  local unpushed_list=""
  # The local focus/*.md mirror sync-crontab.sh --apply used to symlink was
  # retired whole (#244) with no replacement read path (every other
  # project's home is 0700, so this account cannot read FOCUS.md by path --
  # verified 2026-08-20). NEXT UP/ETA must render `?` (BLIND), never `-`,
  # while that is true -- `-` already means "read fine, genuinely nothing
  # there" for the QUESTIONS column above, and reusing it here for "could
  # not look at all" is exactly the "BLIND reported as OK" failure this
  # file's own QUESTIONS column comment warns against.
  local focus_mirror_available=0
  [ -d "$SCHED_ROOT/focus" ] && focus_mirror_available=1
  # Rows are collected as "<score>\t<rendered line>" and sorted by score
  # descending after the loop, so projects with open questions float to
  # the top instead of showing in registration/conf-file order (flagged
  # 2026-07-22: "why hasn't anything run" shouldn't require reading
  # top-to-bottom hunting for the one row that needs you). Score is just
  # q_unanswered -- a rough stand-in for the fuller quota/ETA-aware
  # ordering still queued in FOCUS.md's backlog.
  local rows=""
  while IFS= read -r proj; do
    local qfile="$SCHED_ROOT/questions/$proj.md"
    local qlabel="-"
    # An issues-channel project has no local file to gate on -- gating the
    # count on one is exactly how it would silently render "-" forever.
    local q_blind=0 q_counts
    if [ -f "$qfile" ] || [ "$(answer_channel "$proj" 2>/dev/null)" = "issues" ]; then
      # Could-not-look renders `?`, never `-`. `-` means "nothing open".
      if ! q_counts="$(project_questions_counts "$proj")"; then
        q_blind=1; q_counts="0 0"
      fi
      read -r q_unanswered q_answered <<<"$q_counts"
      local q_total=$(( q_unanswered + q_answered ))
      local q_star=""
      if [ "$q_total" -gt 0 ] 2>/dev/null; then
        qlabel="$q_unanswered/$q_total"
      fi
      # `*` = this file changed since you last opened it via `scheduler
      # questions`/`status` -- added 2026-07-22 so an open count doesn't
      # read the same whether it's brand new or something you've already
      # seen and just haven't gotten to. Approximate (file mtime vs a
      # per-project "last opened" timestamp), not a real read-receipt.
      questions_unopened "$proj" "$q_unanswered" && q_star="*"
    fi
    # Fixed-shape render: a reserved 1-char `*` slot + right-aligned
    # numerator, so every row's `/` lands in the same column whether or
    # not the star is present (flagged 2026-07-22: "formatting should
    # leave blank spaces so asterisks don't nudge fractions over ...
    # try to get all the / to line up").
    if [ "$q_blind" -eq 1 ]; then
      qlabel="  ?"
    elif [ "$qlabel" = "-" ]; then
      qlabel="  -"
    else
      qlabel="$(printf '%1s%2s/%s' "$q_star" "$q_unanswered" "$q_total")"
    fi

    # Cheap "what's coming" approximation: total bulleted backlog items
    # under a project's FOCUS.md (what its next run reads first to decide
    # scope -- see each FOCUS.md's own header comment), shown as "1/N" since
    # a run always picks up at the top item, plus that top item's own
    # bolded title as a keyword. NOT a scheduled time or a real "will finish
    # N of these" estimate -- most projects run on usage-gate.sh's paced
    # quota-based rotation, not a fixed cron slot, and one run may finish
    # the top item, partially land it, or reprioritize entirely. Skips
    # HTML-comment blocks (resolved-decision notes, not live scope) so
    # already-settled discussion doesn't inflate the count.
    # f_total/f_keyword reset EVERY iteration, not declared inside the
    # [ -f "$ffile" ] branch below (fixed 2026-07-26): locals persist
    # across loop iterations, so a project with no focus/<proj>.md either
    # crashed the whole glance under set -u (if it came first) or silently
    # inherited the PREVIOUS project's backlog count for its own ETA.
    local next="-" ffile="$SCHED_ROOT/focus/$proj.md" f_total="" f_keyword=""
    [ "$focus_mirror_available" -eq 0 ] && next="?"
    if [ -f "$ffile" ]; then
      IFS=$'\t' read -r f_total f_keyword <<<"$(awk -F'\t' '
        /<!--/ { incomment=1 }
        /-->/ { incomment=0; next }
        incomment { next }
        # "Ideas (added via `scheduler -i`)" sections are an unprocessed
        # inbox dump, not scoped backlog -- realisateur/the next batch run
        # still has to triage them into real scope, so they should not
        # count or supply the keyword.
        # "backlog" alone is NOT a safe un-exclude signal -- some projects
        # (scheduler'"'"'s own FOCUS.md, aedile) literally name their raw
        # unprocessed-idea intake section "## Backlog (the intake -- ...)",
        # same dump semantics as an "Ideas" heading, just a different word.
        # "feature request" is the narrower, unambiguous phrase actually
        # used (only by home-assistant/realisateur) for a real, already-
        # scoped section -- see docs below for why this stays narrow.
        /^##/ {
          inideas = (tolower($0) ~ /ideas|intake/)
          in_scoped_backlog = (tolower($0) ~ /feature request/)
          in_priority_queue = (tolower($0) ~ /priority queue/)
          next
        }
        inideas { next }
        /^- \*\*/ {
          line=$0
          sub(/^- \*\*/, "", line)
          idx=index(line, "**")
          bullet = (idx>0) ? substr(line,1,idx-1) : line
          rest = (idx>0) ? substr(line, idx+2) : ""
          # Skip raw "YYYY-MM-DD (via `scheduler -i`/realisateur...)"
          # bullets UNLESS they are under a heading confirmed scoped (see
          # in_scoped_backlog above) -- most projects'"'"' FOCUS.md files
          # mix real backlog with a long history of dated DONE/deferred/
          # journal-style bullets (crt.md, scheduler.md itself) that look
          # identical in shape to a real backlog item but are not "what
          # the next run reads first" -- narrowed 2026-07-24 to also fix
          # home-assistant (a properly-sectioned `- ** 2026-07-20 ... (via
          # scheduler -i)` bullet under "## Feature requests / backlog"
          # was being excluded as if it were unsectioned noise) without
          # reopening that flood for every other project.
          if (!in_scoped_backlog && bullet ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}/) next
          total++
          if (total == 1) {
            keyword = bullet
            # A scoped bullet in cmd_idea'"'"'s own `scheduler -i` insertion
            # shape (`- **$ts (via `scheduler -i`):** $text`) bolds ONLY
            # the timestamp+source tag -- the real content sits unbolded
            # right after. If the bold span itself is a bare timestamp,
            # fall back to the first ~28 chars of that unbolded text
            # instead of showing a useless "2026-07-20 19:59 (via..." NEXT
            # UP keyword (found 2026-07-24 on home-assistant'"'"'s row).
            if (keyword ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}/) {
              sub(/^[ \t:]+/, "", rest)
              keyword = substr(rest, 1, 28)
            }
          }
          next
        }
        # Top-level numbered-list backlogs, scoped ONLY to a heading
        # literally named "Priority queue" (currently just chezz) --
        # added 2026-07-24. Deliberately NOT a blanket "any column-0
        # numbered line" rule: crt.md and scheduler.md own FOCUS.md are
        # full of unrelated column-0 numbered lists inside ordinary prose
        # (sequencing steps, roadmap reasoning, DONE-item lists) that are
        # NOT "what the next run reads first" -- a blanket rule silently
        # inflated crt from 11 to 63 and scheduler from 36 to 90 items
        # when first tried, all noise.
        in_priority_queue && /^[0-9]+\. / {
          line=$0
          sub(/^[0-9]+\.[ \t]*/, "", line)
          gsub(/\*\*/, "", line)
          total++
          if (total == 1) keyword = line
        }
        END { printf "%d\t%s\n", total+0, keyword }
      ' "$ffile" 2>/dev/null)"
      if [ -n "$f_total" ] && [ "$f_total" -gt 0 ] 2>/dev/null; then
        local kw="$f_keyword"
        [ "${#kw}" -gt 28 ] && kw="${kw:0:27}…"
        # Right-aligned total so the `/` and `:` line up down the column
        # (same 2026-07-22 formatting ask as the QUESTIONS column).
        next="$(printf '1/%2s: %s' "$f_total" "$kw")"
      fi
    fi

    # Stranded-push awareness (2026-07-24, closes the "make it loud for
    # ANY project, not just chezz/wtul" half of the credential-gap
    # backlog item -- `cmd_sweep`'s dedicated-clone pass already detects
    # this per-run, but only if you remember to run `scheduler sweep`
    # separately; this surfaces the same signal in the view you actually
    # open daily). Reads the dedicated clone's already-known local refs
    # (no fetch -- same no-network assumption `report_divergence` already
    # makes), so a real credential/push gap (root-caused 2026-07-24 for
    # chezz/wtul: commits succeed, the push silently no-ops) shows up here
    # instead of requiring a separate `sweep` run to notice.
    local job_name
    job_name="$(conf_field "$proj" BATCH_JOB_NAME)"
    [ -n "$job_name" ] || job_name="$(conf_field "$proj" SWEEP_JOB_NAME)"
    if [ -n "$job_name" ] && [ -d "$HOME/.local/share/$job_name/repo/.git" ]; then
      local clone="$HOME/.local/share/$job_name/repo"
      local cbranch cahead
      cbranch="$(git -C "$clone" rev-parse --abbrev-ref HEAD 2>/dev/null)"
      cahead="$(git -C "$clone" rev-list --count "origin/$cbranch..HEAD" 2>/dev/null || echo 0)"
      if [ "${cahead:-0}" -gt 0 ] 2>/dev/null; then
        any_unpushed=1
        unpushed_list="$unpushed_list$proj ($cahead unpushed), "
      fi
    fi

    # LAST RUN: age of ~/reports/<project>/LATEST.md, the same file `scheduler
    # report <project>` opens -- a proxy for "last completed run" (mtime
    # only updates when a run actually writes a report, never a scheduler-
    # tracked dispatch timestamp), added 2026-07-24 per the "add a last-run
    # column" backlog item. Rendered as a coarse age bucket (Xm/Xh/Xd ago) so
    # it's scannable at a glance rather than a raw timestamp.
    local lastrun="-" lfile="$REPORTS_ROOT/$proj/LATEST.md"
    if [ -f "$lfile" ]; then
      local lmtime lnow lage
      lmtime="$(stat -c %Y "$lfile" 2>/dev/null || echo 0)"
      lnow="$(date +%s)"
      lage=$(( lnow - lmtime ))
      if [ "$lage" -lt 3600 ]; then
        lastrun="$(( lage / 60 ))m ago"
      elif [ "$lage" -lt 86400 ]; then
        lastrun="$(( lage / 3600 ))h ago"
      else
        lastrun="$(( lage / 86400 ))d ago"
      fi
    fi

    # ETA: this project's own backlog size x its own recent dispatch cadence
    # (see project_cadence_seconds) -- deliberately per-project, not a share
    # of some global rate, since cadence already reflects this project's
    # rotation weight and how often the gate has actually let it run.
    local etalabel="-"
    [ "$focus_mirror_available" -eq 0 ] && etalabel="?"
    if [ -n "$f_total" ] && [ "$f_total" -gt 0 ] 2>/dev/null; then
      local cadence
      cadence="$(project_cadence_seconds "$proj" 2>/dev/null)"
      if [ -n "$cadence" ] && [ "$cadence" -gt 0 ] 2>/dev/null; then
        local proj_eta=$(( cadence * f_total ))
        etalabel="~$(fmt_duration "$proj_eta")"
        if [ "$proj_eta" -gt "$global_eta_secs" ]; then
          global_eta_secs="$proj_eta"; global_eta_proj="$proj"
        fi
      else
        etalabel="no history"
        any_unknown_eta=1
      fi
    fi

    local score=$(( ${q_unanswered:-0} ))
    local row
    row="$(printf '  %-16s %-10s %-10s %-10s %s' "$proj" "$qlabel" "$lastrun" "$etalabel" "$next")"
    rows="$rows$score"$'\t'"$row"$'\n'
  done < <(projects)
  printf '%s' "$rows" | sort -t $'\t' -k1,1rn | cut -f2-
  echo
  if [ "$global_eta_secs" -gt 0 ]; then
    echo "est. time to burn down every project's current FOCUS.md backlog: ~$(fmt_duration "$global_eta_secs") (bound by $global_eta_proj's own backlog x pace)$([ "$any_unknown_eta" = "1" ] && echo " -- some projects show 'no history' and aren't in this estimate")"
  fi
  if [ "$any_unpushed" = "1" ]; then
    echo "-> stranded local commits in a dedicated clone (push likely failed silently): ${unpushed_list%, }"
    echo "   run 'scheduler sweep' for detail, or push by hand from that clone"
  fi
  # Tripped dead-man switches, surfaced in the view actually opened daily
  # (same reasoning as the stranded-commits block above -- `sweep` finds
  # these too now, but only if you remember to run it). Job-level, not
  # per-project-row: a project can have several jobs (bug-sweep + batch)
  # and the state dirs are keyed by JOB_NAME, so a footer list keyed the
  # same way stays truthful without guessing a job->project mapping.
  local any_expired=0 expired_list=""
  local stamp eat
  for stamp in "$HOME"/.local/share/*/expires_at; do
    [ -f "$stamp" ] || continue
    eat="$(cat "$stamp" 2>/dev/null)"
    if [ -n "$eat" ] && [[ "$(date -Is)" > "$eat" ]]; then
      any_expired=1
      expired_list="$expired_list$(basename "$(dirname "$stamp")") (since ${eat%%T*}), "
    fi
  done
  if [ "$any_expired" = "1" ]; then
    echo "-> expired jobs (dead-man switch tripped -- these no-op until renewed): ${expired_list%, }"
    echo "   renew: rm ~/.local/share/<job>/expires_at (next run re-stamps); 'scheduler sweep' for detail"
  fi
  # Branches beyond main sitting on a dedicated clone (e.g. a finished
  # nightly/<date> or paced/<date> cycle that never got merged) -- the
  # same signal cmd_sweep's third pass already finds, but that requires
  # remembering to run `sweep` separately; surfaced here too so it shows
  # up in the view actually opened daily (target UX, FOCUS.md "Current
  # focus" item 3(c) -- same reasoning already applied to the stranded
  # local commits block right above).
  local any_extra_branch=0
  local extra_branch_list=""
  local b ahead
  while IFS=$'\t' read -r b ahead; do
    [ -n "$b" ] || continue
    any_extra_branch=1
    extra_branch_list="$extra_branch_list  scheduler        $b  $ahead commit(s), not merged\n"
  done < <(extra_branches_detail "$SCHED_ROOT")
  for repo in "$HOME"/.local/share/*/repo; do
    [ -d "$repo/.git" ] || continue
    job="$(basename "$(dirname "$repo")")"
    while IFS=$'\t' read -r b ahead; do
      [ -n "$b" ] || continue
      any_extra_branch=1
      extra_branch_list="$extra_branch_list  $job  $b  $ahead commit(s), not merged\n"
    done < <(extra_branches_detail "$repo")
  done
  if [ "$any_extra_branch" = "1" ]; then
    echo "-> branches awaiting review:"
    printf '%b' "$extra_branch_list"
    echo "   run 'scheduler sweep' for full detail, or 'git log <default>..<branch>' / merge by hand"
  fi
  glance_run_ledger
  echo "-> scheduler focus/questions/report <project> to jump straight in"
}

# The absence-surface (sprint step 3, 2026-07-28), designed against step
# 2's measurement (bin/unprinted-facts.sh) rather than against memory.
#
# The bar it is built to: `scheduler` noargs should be a complete and
# falsifiable account of the system -- if a dispatch was predicted and did
# not happen it says so, and if it cannot know it says BLIND, never
# silence. Three consequences of taking that literally:
#
#  - It prints EVERY run, always, including the boring "all ok" case.
#    A surface that only appears when something is wrong cannot be
#    distinguished from a surface that is broken.
#  - Its facts come from each job's own run log, not from report mtimes.
#    The LAST RUN column above is a proxy for the last SUCCESS (a failed
#    run writes no report); this block is what makes that recoverable
#    rather than invisible.
#  - The one thing nothing on this disk records -- whether a dispatch was
#    DUE and did not fire -- is printed as an explicit BLIND line instead
#    of being left out. Silence would read as "nothing was missed."
glance_run_ledger() {
  local proj job state epoch detail bad="" okn=0 total=0
  while IFS= read -r proj; do
    job="$(conf_field "$proj" BATCH_JOB_NAME)"
    [ -n "$job" ] || job="$(conf_field "$proj" SWEEP_JOB_NAME)"
    [ -n "$job" ] || continue
    total=$((total+1))
    IFS=$'\t' read -r state epoch detail <<<"$(last_run_verdict "$proj" "$job")"
    local when="-"
    if [ "${epoch:-0}" -gt 0 ] 2>/dev/null; then
      when="$(fmt_duration "$(( $(date +%s) - epoch ))") ago"
    fi
    # A record old enough to predate the current dispatch arrangement is
    # NOT evidence of an outage, and rendering it as one is how a sensor
    # earns being ignored. scheduler's own row is the live example: its
    # conf still names scheduler-nightly-batch, whose log ends at a FAILED
    # on 2026-07-19, while the project is in fact dispatched by the paced
    # runner and sync-crontab emits no line for that job at all. Say the
    # record is stale and let the reader judge; do not assert 9 days of
    # silence that did not happen.
    if [ "${epoch:-0}" -gt 0 ] 2>/dev/null && [ $(( $(date +%s) - epoch )) -gt $((5*86400)) ]; then
      state="stale-$state"
      detail="$detail  [record is $when -- may be an orphaned job; the paced runner may dispatch this project instead]"
    fi
    case "$state" in
      ok) okn=$((okn+1)) ;;
      *)  bad="$bad$(printf '     %-18s %-14s %-12s %s' "$proj" "$state" "$when" "$detail")\n" ;;
    esac
  done < <(projects)

  echo "-> run ledger (each job's OWN log, not the report mtime in LAST RUN above):"
  if [ -n "$bad" ]; then
    printf '%b' "$bad"
  fi
  echo "     $okn of $total job(s) last ran clean$([ -n "$bad" ] && echo "; the rest are listed above")"
  # The BLIND line is unconditional and load-bearing. Dropping it on a
  # quiet night is exactly the failure mode this whole surface exists for.
  echo "   BLIND: whether a dispatch was DUE and did not fire. Nothing records expected-vs-actual;"
  echo "          a job that silently stopped being dispatched looks identical to one with nothing to do."
  local rl="$HOME/.local/share/scheduler-paced-runner/run.log"
  if [ -f "$rl" ]; then
    local lastd lde
    lastd="$(grep -E 'DONE .* rc=' "$rl" 2>/dev/null | tail -1 | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}')"
    if [ -n "$lastd" ]; then
      lde="$(date -d "$lastd" +%s 2>/dev/null || echo 0)"
      [ "$lde" -gt 0 ] && echo "   last actual dispatch: $(fmt_duration "$(( $(date +%s) - lde ))") ago ($lastd) -- 'scheduler pacing show' for why"
    else
      echo "   last actual dispatch: BLIND -- no DONE line in $rl"
    fi
  else
    echo "   last actual dispatch: BLIND -- the dispatcher's own log is missing at $rl"
  fi
}

report_divergence() {
  # Shared by cmd_sweep and cmd_status -- reports (never resolves) how a
  # local branch stands vs its origin. Split out 2026-07-22 so the status
  # deep-dive doesn't reimplement this same ahead/behind/diverged check.
  local name="$1" path="$2"
  local branch ahead behind
  branch="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  ahead="$(git -C "$path" rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo 0)"
  behind="$(git -C "$path" rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)"
  if [ "${ahead:-0}" -gt 0 ] 2>/dev/null && [ "${behind:-0}" -gt 0 ] 2>/dev/null; then
    echo "== $name: ** DIVERGED from origin/$branch ** -- $ahead local-only, $behind remote-only commit(s). Needs a real merge decision -- NOT auto-resolved, ever."
  elif [ "${ahead:-0}" -gt 0 ] 2>/dev/null; then
    echo "== $name: $ahead commit(s) ahead of origin/$branch, not pushed (push always stays a human step)"
  elif [ "${behind:-0}" -gt 0 ] 2>/dev/null; then
    echo "== $name: $behind commit(s) behind origin/$branch"
  fi
}

# extra_branches <repo> -- print $repo's branches (local or on origin)
# beyond its default (main/master), one per line, nothing if there are
# none or it isn't a git repo. Ported from an early morning-report.sh
# draft (paced/2026-07-20, merged into `scheduler sweep` here instead --
# morning-report.sh itself is deprecated in favor of this CLI) so stray
# work like a `paced/<date>` branch that finished its review-gated cycle
# but was never merged doesn't just sit there unnoticed.
extra_branches() {
  local repo="$1"
  # .git is a FILE (not a directory) inside a git worktree -- use -e, not
  # -d, so this also covers this repo's own paced/<date> worktree.
  [ -e "$repo/.git" ] || return 0
  local default
  default="$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"
  default="${default#origin/}"
  [ -n "$default" ] || default="main"
  # refs/remotes/origin/HEAD's short name is bare "origin" (not
  # "origin/HEAD"), so it needs its own exclusion alongside "HEAD" for a
  # plain branch ref.
  git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin 2>/dev/null \
    | sed 's#^origin/##' \
    | sort -u \
    | grep -vx -e "$default" -e "HEAD" -e "origin" -e "main" -e "master" || true
}

# extra_branches_detail <repo> -- like extra_branches, but each line is
# "<branch>\t<ahead-count>" (commits ahead of that repo's own default
# branch) instead of a bare name. Built for cmd_glance's footer, which
# needs the count to be worth surfacing in the view you actually open
# daily (target UX in FOCUS.md's "Current focus" item 3(c): "branches
# awaiting review" in the glance screen, not just in a separate `sweep`
# run) -- a branch with 0 commits ahead (e.g. a stale feature branch
# already merged and left around) isn't actually awaiting review, so it's
# filtered out here rather than just reusing extra_branches' bare list.
extra_branches_detail() {
  local repo="$1"
  [ -e "$repo/.git" ] || return 0
  local default
  default="$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"
  default="${default#origin/}"
  [ -n "$default" ] || default="main"
  local b ref ahead
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    # extra_branches strips the "origin/" prefix for display, so a
    # branch that exists ONLY on origin (no local tracking branch --
    # e.g. chezz's dedicated clone has origin/readable-html but never
    # checked it out locally) has no ref resolvable under its bare
    # short name. Resolve against the local branch if it exists, else
    # fall back to origin/<name> -- a bare `rev-list default..$b` on a
    # name that doesn't resolve just fails silently and would have
    # under-counted this as 0-ahead (found live: chezz's readable-html/
    # chezz-classic went missing from the list until this fallback was
    # added).
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$b"; then
      ref="$b"
    elif git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$b"; then
      ref="origin/$b"
    else
      continue
    fi
    ahead="$(git -C "$repo" rev-list --count "$default..$ref" 2>/dev/null)"
    [ -n "$ahead" ] && [ "$ahead" -gt 0 ] 2>/dev/null || continue
    printf '%s\t%s\n' "$b" "$ahead"
  done < <(extra_branches "$repo")
}

cmd_sweep() {
  echo "scheduler sweep -- $(date '+%Y-%m-%d %H:%M')"
  echo "(reactive backstop: catches uncommitted/unpushed/diverged state the vim"
  echo " auto-commit hook may have missed -- e.g. a long-running vim session"
  echo " that predates a ~/.vimrc change never picks up new autocmds)"
  echo

  local repos_seen=0 issues_found=0
  {
    printf 'scheduler|%s\n' "$SCHED_ROOT"
    while IFS= read -r proj; do
      # scheduler is also self-registered (schedule/scheduler.conf, for its
      # own dogfooded paced cycle) -- already covered by the hardcoded line
      # above, skip here to avoid checking the same repo twice.
      [ "$proj" = "scheduler" ] && continue
      local rp
      rp="$(conf_field "$proj" PROJECT_REPO_PATH)"
      [ -n "$rp" ] && printf '%s|%s\n' "$proj" "$rp"
    done < <(projects)
  } | while IFS='|' read -r name path; do
    is_git_repo "$path" || continue
    repos_seen=$((repos_seen + 1))

    # Safe .md files get auto-committed, one file at a time, same tested
    # logic `-i` already uses. Anything else (code, YAML config, etc.) is
    # only ever reported -- see home-assistant's config/automations.yaml
    # divergence (2026-07-20) for exactly why this stays conservative.
    local dirty_md holder_pid
    dirty_md="$(git -C "$path" status --porcelain -- '*.md' 2>/dev/null | awk '{print $2}')"
    if [ -n "$dirty_md" ]; then
      # Honor the human-presence marker (item 3 of the sweep-attribution
      # regulator). Sweep has NO provenance -- it merely found a dirty file
      # on a 15-minute clock -- so when a human is demonstrably editing this
      # project right now, its edits are work in flight, not an abandoned
      # save to rescue. Deferring costs nothing: sweep runs again in 15
      # minutes, and the vim hook still commits the human's own saves
      # meanwhile (that path HAS provenance and is deliberately unaffected).
      # No starvation cap needed here, unlike the batch-side probe: sweep
      # only ever commits, so a deferral leaves the file exactly as the
      # human has it.
      if holder_pid="$(interactive_holder "$name")"; then
        echo "== $name: deferring auto-commit -- a human is editing it (pid $holder_pid) =="
        echo "$dirty_md" | sed 's/^/  held: /'
      else
        while IFS= read -r rel; do
          [ -n "$rel" ] || continue
          echo "== $name: auto-committing $rel =="
          # Honest attribution: this branch adopts whatever dirty .md a repo
          # happens to have, which is NOT necessarily scheduler's own edit or
          # even a human's -- it could be a live interactive session's
          # in-progress work that the vim auto-commit hook hasn't caught yet
          # (a hook that predates a ~/.vimrc change, or a non-vim editor).
          # cmd_commit_file's own fallback message ("Human edit via
          # scheduler: ...") asserts authorship this call site cannot know,
          # which is exactly what mis-attributed a live session's edit under
          # Zach's own name in realisateur (93ad456, 2026-07-26) -- see
          # .scheduler/QUESTIONS.md same date. Pass an explicit message that
          # names this as the reactive sweep backstop, not a human or
          # scheduler-authored edit.
          cmd_commit_file "$path/$rel" "scheduler sweep: adopted dirty $rel (reactive backstop -- author unknown, possibly a live session not yet auto-committed) ($(date '+%Y-%m-%dT%H:%M'))"
        done <<< "$dirty_md"
      fi
    fi

    local dirty_other
    dirty_other="$(git -C "$path" status --porcelain -- . ':!*.md' 2>/dev/null)"
    if [ -n "$dirty_other" ]; then
      echo "== $name: dirty, NOT auto-committed (only *.md is safe to auto-commit) =="
      echo "$dirty_other" | sed 's/^/  /'
    fi

    report_divergence "$name" "$path"
  done

  # Second pass: every automated job's DEDICATED CLONE
  # (~/.local/share/<JOB_NAME>/repo) -- added 2026-07-20 after realizing
  # the first pass above only ever checks YOUR manual checkouts. That's a
  # real blind spot: the original stranded-commit incident this whole
  # feature exists for (chezz, same day) was found sitting in a dedicated
  # clone, not a human checkout -- the first version of `sweep` could
  # never have caught its own motivating example. Glob-based, not
  # conf-parsed: scans whatever actually exists under ~/.local/share/*/repo
  # rather than trying to reconstruct job names from schedule/*.conf,
  # so it also covers legacy per-tier clones (chezz-bug-sweep,
  # chezz-nightly-batch, etc.) without needing to keep two enumeration
  # paths in sync. Scheduler's own jobs use throwaway worktrees, not this
  # shape (confirmed: no matching repo/ dir), so they're naturally excluded,
  # not special-cased.
  #
  # REPORT ONLY here, never auto-commit -- a dedicated clone gets a fresh
  # `git reset --hard origin/<branch>` before every run, so a human is
  # never expected to be editing inside one directly. Anything dirty or
  # unpushed there is either a genuinely interrupted run (the exact thing
  # worth surfacing) or something unusual enough to deserve a look, not a
  # routine auto-commit that could paper over what actually happened.
  local clone_found=0
  for repo in "$HOME"/.local/share/*/repo; do
    [ -d "$repo/.git" ] || continue
    clone_found=1
    job="$(basename "$(dirname "$repo")")"
    dirty="$(git -C "$repo" status --porcelain 2>/dev/null)"
    branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    ahead="$(git -C "$repo" rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo 0)"
    if [ -n "$dirty" ]; then
      echo "== [clone] $job: dirty in the dedicated clone itself -- unusual, worth a look =="
      echo "$dirty" | sed 's/^/  /'
    fi
    if [ "${ahead:-0}" -gt 0 ] 2>/dev/null; then
      echo "== [clone] $job: $ahead commit(s) ahead of origin/$branch, sitting UNPUSHED in the dedicated clone -- likely a run that got cut off after committing but before pushing (see the stranded-commit backlog item) =="
    fi
  done

  # Third pass: branches beyond main -- this repo's own paced/<date>
  # self-dev branches are the ones most likely to pile up unmerged (they
  # only merge when a live cycle finishes cleanly; a stale deploy or a
  # conflict leaves one stranded), then the same check on every dedicated
  # clone. Read-only, no fetch -- reflects branch state as of each clone's
  # last scheduled run / this repo's current state, not a live network
  # check.
  # Uses extra_branches_detail (built 2026-07-25 for cmd_glance's own
  # "branches awaiting review" footer) instead of the bare-name
  # extra_branches here too, so `sweep`'s output carries the same
  # ahead-count every other surfacing of this signal already shows --
  # previously this pass printed bare branch names only, forcing a
  # separate `git rev-list --count` to tell "1 stray commit" from
  # "23 commits, needs real review."
  local sched_extra=""
  local b ahead
  while IFS=$'\t' read -r b ahead; do
    [ -n "$b" ] || continue
    sched_extra="$sched_extra  $b  $ahead commit(s), not merged\n"
  done < <(extra_branches_detail "$SCHED_ROOT")
  if [ -n "$sched_extra" ]; then
    echo "== scheduler (this repo): branches beyond main =="
    printf '%b' "$sched_extra"
  fi
  for repo in "$HOME"/.local/share/*/repo; do
    [ -d "$repo/.git" ] || continue
    job="$(basename "$(dirname "$repo")")"
    local extra=""
    while IFS=$'\t' read -r b ahead; do
      [ -n "$b" ] || continue
      extra="$extra  $b  $ahead commit(s), not merged\n"
    done < <(extra_branches_detail "$repo")
    [ -n "$extra" ] || continue
    echo "== [clone] $job: branches beyond main =="
    printf '%b' "$extra"
  done

  # Fourth pass: stale/stranded ~/.local/share/scheduler-registry/*.active
  # markers (lib/sweep-loop-common.sh writes one per PROJECT_KEY on start
  # and `trap ... EXIT` removes it on a normal exit). A marker whose PID is
  # no longer running means that trap never fired -- the run was killed,
  # crashed, or the machine went down before it could clean up. That's the
  # other half of "did a run get cut off" the two passes above can't see:
  # they only catch a run that got far enough to make a commit (dirty repo,
  # unpushed clone). A run cut off BEFORE any commit leaves no git trace at
  # all -- only this marker. Queued in FOCUS.md's stability milestone
  # 2026-07-20, built here.
  local stale_found=0
  local registry_dir="$HOME/.local/share/scheduler-registry"
  if [ -d "$registry_dir" ]; then
    for marker in "$registry_dir"/*.active; do
      [ -f "$marker" ] || continue
      local proj_key pid started_at job_field age_seconds started_epoch
      proj_key="$(basename "$marker" .active)"
      pid="$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$marker")"
      started_at="$(sed -n 's/.*"started_at":"\([^"]*\)".*/\1/p' "$marker")"
      job_field="$(sed -n 's/.*"job":"\([^"]*\)".*/\1/p' "$marker")"
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        started_epoch="$(date -d "$started_at" +%s 2>/dev/null || echo "")"
        if [ -n "$started_epoch" ]; then
          age_seconds=$(( $(date +%s) - started_epoch ))
          if [ "$age_seconds" -ge "${STALE_ACTIVE_MARKER_SECONDS:-7200}" ]; then
            echo "== [registry] $proj_key: marker active ${age_seconds}s (job=$job_field, pid=$pid, started=$started_at) -- process is still alive, but this is longer than any known job normally runs. Worth a look, not auto-flagged as stranded. =="
            stale_found=1
          fi
        fi
      else
        echo "== [registry] $proj_key: STALE marker -- pid ${pid:-?} not running (job=$job_field, started=$started_at). The run that created this never reached its own EXIT trap (killed, crashed, or machine restarted), most likely before making any commit -- that's why the git-based checks above wouldn't catch it. Safe to remove once confirmed dead: rm '$marker' =="
        stale_found=1
      fi
    done
  fi
  if [ "$stale_found" = "0" ]; then
    echo "no stale/stranded registry (.active) markers found"
  fi

  # Fifth pass: verify claimed migration destinations. A project's own
  # schedule/<proj>.conf sometimes documents itself as "MIGRATED to
  # <host>'s own crontab" (aedile, vkv-inventory, both 2026-07-20) --
  # exactly the claim that sat WRONG for 4 days undetected (the migration
  # was never actually completed; see vault:scheduler/DESIGN-NOTES.md's
  # "silently-orphaned finding", root-caused 2026-07-24). A stranded-commit sweep can't catch
  # this class of drift at all -- there's no local git state to look at,
  # the whole point is the job moved OUTSIDE this scheduler's view. This
  # re-checks the claim every sweep instead of trusting it was ever true.
  # Best-effort only: if the destination host isn't SSH-reachable from
  # HERE (no alias, no network, no creds for that account), that's
  # reported as unverifiable, never silently treated as confirmed --
  # matches the honesty standard the stale-marker pass above already
  # holds itself to.
  local migration_found=0
  for conf in "$SCHED_ROOT"/schedule/*.conf; do
    [ -f "$conf" ] || continue
    local proj dest
    proj="$(basename "$conf" .conf)"
    dest="$(grep -iom1 'MIGRATED to [A-Za-z0-9_-]*' "$conf" | awk '{print $NF}')"
    [ -n "$dest" ] || continue
    migration_found=1
    if ! ssh -o BatchMode=yes -o ConnectTimeout=4 "$dest" true 2>/dev/null; then
      echo "== [migration-check] $proj: claims MIGRATED to '$dest' but that host isn't SSH-reachable from here (no alias/network/creds) -- can't verify the crontab claim from this environment; treat as UNVERIFIED, not confirmed =="
    elif ssh -o BatchMode=yes -o ConnectTimeout=4 "$dest" crontab -l 2>/dev/null | grep -qi "$proj"; then
      echo "== [migration-check] $proj: MIGRATED-to claim for '$dest' verified -- a matching crontab entry exists there =="
    else
      echo "== [migration-check] $proj: ORPHANED -- claims MIGRATED to '$dest' but no matching crontab entry found there. Needs a human/realisateur decision (finish the migration or re-enable it here) =="
    fi
  done
  if [ "$migration_found" = "0" ]; then
    echo "no schedule/*.conf claims a MIGRATED-to destination"
  fi

  # Seventh pass: tripped dead-man switches (expires_at stamps). FOCUS.md
  # EXPIRY_DAYS finding 3 (2026-07-25): 5 of 14 jobs sat expired,
  # discoverable only by hand-scanning ~/.local/share/*/expires_at or by
  # opening each project's own `scheduler status` one at a time -- neither
  # view a human opens daily showed it. Glob-based like the dedicated-clone
  # pass above (scans what exists, doesn't reconstruct job names from
  # confs), so it also reports jobs expired ON PURPOSE (a parked tier, a
  # project migrated off this scheduler) -- one calm line each is the
  # honest output: the switch genuinely is tripped, and whether that's
  # intended is the human's call, never silently guessed here.
  local expired_found=0
  for stamp in "$HOME"/.local/share/*/expires_at; do
    [ -f "$stamp" ] || continue
    local ejob eat
    ejob="$(basename "$(dirname "$stamp")")"
    eat="$(cat "$stamp" 2>/dev/null)"
    if [ -n "$eat" ] && [[ "$(date -Is)" > "$eat" ]]; then
      echo "== [expiry] $ejob: EXPIRED $eat -- dead-man switch tripped, job no-ops until renewed. Renew: rm $stamp (next run re-stamps now+EXPIRY_DAYS; bumping EXPIRY_DAYS alone does not renew) =="
      expired_found=1
    fi
  done
  if [ "$expired_found" = "0" ]; then
    echo "no tripped dead-man switches (expires_at stamps) found"
  fi

  # Eighth pass: managed config that isn't committed. The passive half of
  # the committed-config gate added to bin/sync-crontab.sh 2026-07-27 --
  # that one refuses to DEPLOY from a dirty schedule/, this one notices a
  # schedule/ that has been sitting dirty since some earlier session, which
  # is the state the human never sees until a `--apply` months later
  # silently ships (or silently drops) an edit nobody remembers making.
  # Calls sync-crontab.sh's own --check-clean rather than re-deriving the
  # rule here, so the two halves can never disagree: it writes nothing and
  # reads no crontab. Same discipline as every pass above -- a signal, not
  # an auto-fix; committing someone's half-finished config edit for them is
  # exactly the sweep-attribution mistake this repo is already unpicking.
  if [ -x "$SCHED_ROOT/bin/sync-crontab.sh" ]; then
    local conf_check_out conf_check_rc
    conf_check_out="$("$SCHED_ROOT/bin/sync-crontab.sh" --check-clean 2>&1)"
    conf_check_rc=$?
    # rc 2 is the gate's own "dirty/unverifiable" verdict. Any OTHER
    # nonzero rc means the check itself did not run (e.g. an installed
    # sync-crontab.sh predating --check-clean) -- say that, don't report a
    # tool mismatch as a config finding.
    if [ "$conf_check_rc" -eq 2 ]; then
      echo "== [managed-config] scheduler's own schedule/ is NOT committed -- sync-crontab.sh --apply will refuse until it is =="
      echo "$conf_check_out" | sed 's/^/  /'
    elif [ "$conf_check_rc" -ne 0 ]; then
      echo "== [managed-config] could not check (sync-crontab.sh --check-clean exited $conf_check_rc) -- config committed-ness is UNKNOWN, not clean =="
      echo "$conf_check_out" | sed 's/^/  /'
    else
      echo "managed config clean ($conf_check_out)"
    fi
  fi

  # Ninth pass: installed-vs-git drift (bin/deploy-drift-check.sh). Found
  # live 2026-07-26: ~/.local/bin/usage-paced-runner.sh -- the file cron
  # actually runs every 5 minutes -- is a hand-made COPY, one commit behind
  # the repo, and being a copy ALSO silently disabled its own auto-pull
  # (that block derives the repo from its own path, which under a copy
  # install is ~/.local, not a checkout: 0 PULL lines in its whole run.log).
  # So "the improvement we committed is live" was an assumed external
  # dependency that had quietly stopped being true -- the milestone's own
  # failure class, and BUILD-DISCIPLINE's "deploy verified against a git
  # ref; drift fails loud." Read-only like every pass above: it reports,
  # a human runs the `ln -sfn` (installed wrappers stay outside this
  # repo's write scope).
  if [ -x "$SCHED_ROOT/bin/deploy-drift-check.sh" ]; then
    local deploy_check_out
    deploy_check_out="$("$SCHED_ROOT/bin/deploy-drift-check.sh" 2>&1)"
    if [ $? -ne 0 ]; then
      echo "== [deploy-drift] installed scripts do not match git =="
      echo "$deploy_check_out" | sed 's/^/  /'
    fi
  fi

  # Tenth pass: one project, two dispatchers (bin/rotation-lint.sh, built
  # 2026-07-29). The host split gives each machine its own
  # schedule/_paced.<host>.conf, so moving a project between hosts is a
  # two-file edit -- enable here, park there -- and until this pass the only
  # thing holding the two halves together was the editor remembering both.
  # A project enabled in two rotations is dispatched by two machines into one
  # git history with no shared lock. Offline, read-only, zero `claude` cost,
  # like every pass above; exit 3 is BLIND, not clean.
  if [ -x "$SCHED_ROOT/bin/rotation-lint.sh" ]; then
    local rotlint_out rotlint_rc
    rotlint_out="$("$SCHED_ROOT/bin/rotation-lint.sh" 2>&1)"
    rotlint_rc=$?
    if [ "$rotlint_rc" -eq 3 ]; then
      echo "== [rotation-lint] cannot read any schedule/_paced*.conf -- check is BLIND =="
      echo "$rotlint_out" | sed 's/^/  /'
    elif [ "$rotlint_rc" -ne 0 ]; then
      echo "== [rotation-lint] a project is enabled in more than one rotation =="
      echo "$rotlint_out" | sed 's/^/  /'
    fi
  else
    echo "== [rotation-lint] MISSING or not executable -- a wired check vanished =="
  fi

  # Eleventh pass: checks that exist but nothing runs (bin/check-witness-lint.sh,
  # built 2026-07-28 -- FOCUS.md step 1b). Answers "how do we make a
  # built-but-unwired check fail noisily?", which static analysis cannot: a
  # call site inside a branch that never executes greps identically to a live
  # one. Every check touches a witness file as its first act; this pass reads
  # them back. Same dead-man-switch shape as the EXPIRY_DAYS pass above,
  # applied to checks instead of jobs.
  #
  # LAST on purpose: the passes above have already invoked the other checks
  # this run, so each of them has just refreshed its own witness and a wired
  # check can never be reported stale by the sweep that ran it.
  if [ -x "$SCHED_ROOT/bin/check-witness-lint.sh" ]; then
    local witness_out witness_rc
    witness_out="$("$SCHED_ROOT/bin/check-witness-lint.sh" 2>&1)"
    witness_rc=$?
    if [ "$witness_rc" -eq 3 ]; then
      echo "== [check-witness] cannot read the witnesses -- check is BLIND =="
      echo "$witness_out" | sed 's/^/  /'
    elif [ "$witness_rc" -ne 0 ]; then
      echo "== [check-witness] a check exists that nothing is running =="
      echo "$witness_out" | sed 's/^/  /'
    fi
  else
    echo "== [check-witness] MISSING or not executable -- a wired check vanished =="
  fi

  echo
  if [ "$clone_found" = "1" ]; then
    echo "swept every registered project + scheduler itself + every job's dedicated clone."
  else
    echo "swept every registered project + scheduler itself. (no dedicated clones found under ~/.local/share/*/repo)"
  fi
}

extract_next_items() {
  # Best-effort, offline (no `claude` call) extraction of "what's next" out
  # of a project's own FOCUS.md -- a rough heuristic, not a real parser
  # (same honesty standard as cmd_glance's question-count awk block): finds
  # a heading matching current focus/priority/backlog, pulls its top-level
  # numbered/bulleted lines, and guesses bug vs feature vs unlabeled by
  # keyword. Projects whose FOCUS.md is mostly prose/HTML-comment design
  # notes (e.g. chezz) will under-match -- that's a real limitation, not a
  # bug in this function; real priority/bug-feature tagging needs a schema
  # decision (see FOCUS.md's 2026-07-22 backlog note), this is the
  # stopgap that works today against well-structured files.
  local focus_path="$1" cadence="${2:-}"
  [ -f "$focus_path" ] || { echo "no FOCUS.md found at $focus_path"; return; }

  local items
  items="$(awk '
    BEGIN{ incomment=0; inscope=0; n=0 }
    {
      line=$0
      if (incomment) {
        if (line ~ /-->/) { incomment=0 }
        next
      }
      if (line ~ /<!--/ && line !~ /-->/) { incomment=1; next }
      if (line ~ /<!--.*-->/) { next }
    }
    /^#+/ {
      inscope = (tolower($0) ~ /current focus|priority queue|priority|backlog/) ? 1 : 0
      next
    }
    inscope && /^[ \t]*([0-9]+\.|-[ \t])/ {
      # only top-level items (<=1 leading space of indent) -- skip nested
      # sub-bullets/notes so this stays a short "next up" list, not a dump
      if ($0 ~ /^[ \t]?([0-9]+\.|-[ \t])/) { print; n++ }
    }
    n>=12 { exit }
  ' "$focus_path")"

  if [ -z "$items" ]; then
    echo "no clearly structured focus/backlog list found -- open the focus file directly (scheduler focus <project>)"
    return
  fi

  local shown=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    shown=$((shown + 1))
    [ "$shown" -gt 8 ] && { echo "... (more in $focus_path -- \`scheduler focus <project>\` for the rest)"; break; }
    local clean tag
    clean="$(printf '%s' "$line" | sed -E 's/^[ \t]*([0-9]+\.|-)[ \t]*//; s/\*\*//g' | cut -c1-110)"
    if printf '%s' "$line" | grep -qiE '\b(bug|fix|broken|crash|regression|error)\b'; then
      tag="[bug]"
    elif printf '%s' "$line" | grep -qiE '\b(feature|implement|add|build|new)\b'; then
      tag="[feature]"
    else
      tag="[item]"
    fi
    # Cumulative ETA assumes strict FIFO (item N clears after N of this
    # project's own cycles) and 1 item clearing per cycle -- both rough;
    # see cmd_glance's ETA-column caveat for the same assumptions spelled
    # out in full. No cadence (fewer than 2 recorded dispatches yet) -> the
    # caller already printed one "no ETA yet" note, so just omit the column
    # here rather than repeating "unknown" on every single line.
    if [ -n "$cadence" ] && [ "$cadence" -gt 0 ] 2>/dev/null; then
      printf '  %-9s %-9s %s\n' "$tag" "~$(fmt_duration "$(( cadence * shown ))")" "$clean"
    else
      printf '  %-9s %s\n' "$tag" "$clean"
    fi
  done <<< "$items"
}

build_status_report() {
  # All plain bash/awk/git -- no `claude` invocation. This is the entire
  # point of `scheduler status`: the common "how's <project> doing" check
  # should cost zero tokens by default. cmd_status prints this directly;
  # --claude/--interactive just layer an AI step on top of the same text.
  local proj="$1" repo_path="$2" job_name="$3"

  echo "scheduler status: $proj -- $(date '+%Y-%m-%d %H:%M')"

  echo
  echo "-- git health ($repo_path) --"
  if is_git_repo "$repo_path"; then
    local dirty divergence
    dirty="$(git -C "$repo_path" status --porcelain 2>/dev/null)"
    if [ -n "$dirty" ]; then
      echo "dirty:"
      echo "$dirty" | sed 's/^/  /'
    fi
    divergence="$(report_divergence "$proj" "$repo_path")"
    [ -n "$divergence" ] && printf '%s\n' "$divergence"
    [ -z "$dirty" ] && [ -z "$divergence" ] && echo "clean, up to date with origin"
  else
    echo "not a git repo (or PROJECT_REPO_PATH is missing on disk)"
  fi

  if [ -n "$job_name" ] && [ -d "$HOME/.local/share/$job_name/repo/.git" ]; then
    echo
    echo "-- dedicated clone vs working checkout --"
    local clone_head repo_head
    clone_head="$(git -C "$HOME/.local/share/$job_name/repo" rev-parse HEAD 2>/dev/null)"
    repo_head="$(git -C "$repo_path" rev-parse HEAD 2>/dev/null)"
    if [ -n "$clone_head" ] && [ "$clone_head" != "$repo_head" ]; then
      echo "clone HEAD ($clone_head) != working checkout HEAD ($repo_head) -- normal if you've committed locally since the clone's last dispatch; only a concern if the CLONE is ahead (that would mean a stranded commit -- see 'scheduler sweep')"
    else
      echo "clone matches working checkout HEAD"
    fi
  fi

  echo
  echo "-- pending feedback (collect-feedback.sh) --"
  local fb=""
  [ -f "$REPORTS_ROOT/$proj/LATEST.md" ] && fb="$("$SCHED_ROOT/bin/collect-feedback.sh" "$REPORTS_ROOT/$proj/LATEST.md" 2>/dev/null)"
  if [ -z "$fb" ]; then
    echo "none pending"
  else
    [ -n "$fb" ] && printf '%s\n' "$fb"
  fi

  echo
  echo "-- next up ($SCHED_ROOT/focus/$proj.md) --"
  if [ ! -d "$SCHED_ROOT/focus" ]; then
    echo "BLIND -- the local focus/*.md mirror was retired with sync-crontab.sh's"
    echo "  symlink farm (#244) and nothing replaced the cross-account read; this"
    echo "  is not the same as $proj having no backlog. See $proj's own repo."
  else
    local proj_cadence
    proj_cadence="$(project_cadence_seconds "$proj" 2>/dev/null)"
    if [ -z "$proj_cadence" ]; then
      echo "(no ETA yet -- fewer than 2 recorded paced dispatches for $proj)"
    fi
    extract_next_items "$SCHED_ROOT/focus/$proj.md" "$proj_cadence"
  fi

  echo
  if [ "$(answer_channel "$proj" 2>/dev/null)" = "issues" ]; then
    # Fixed 2026-08-20: this used to fall straight into the file branch
    # below against $SCHED_ROOT/questions/$proj.md, a path that has not
    # existed since #244 retired the local symlink mirror -- so an
    # issues-channel project's real open questions (there is no other
    # source for them; they were never a local file) silently rendered
    # as "no QUESTIONS.md symlink found" here, in the one view meant to
    # surface them. Same slug/label query cmd_questions_issues uses, read
    # only -- no editor, no posting, this is a summary.
    local slug
    if slug="$(gh_repo_slug "$proj" 2>/dev/null)" && command -v gh >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
      local json
      echo "-- open questions (GitHub issues, $slug) --"
      if json="$(gh issue list --repo "$slug" --label question --state open \
                    --limit 200 --json number,title,comments 2>&1)"; then
        local lines
        lines="$(printf '%s' "$json" | jq -r --arg owner "${slug%%/*}" \
          "$PROVENANCE_ANSWERED_JQ"'
           .[] | "#\(.number) \(.title)" + (if is_answered($owner) then "  [already answered — awaiting the next run]" else "" end)')"
        if [ -n "$lines" ]; then printf '%s\n' "$lines"; else echo "none open"; fi
      else
        echo "BLIND -- gh issue list failed against $slug:" >&2
        printf '%s\n' "$json" >&2
      fi
    else
      echo "-- open questions (GitHub issues) --"
      echo "BLIND -- gh and/or jq unavailable to query $proj's issues" >&2
    fi
  elif [ ! -d "$SCHED_ROOT/questions" ]; then
    echo "-- open questions ($SCHED_ROOT/questions/$proj.md) --"
    echo "BLIND -- the local questions/*.md mirror was retired with"
    echo "  sync-crontab.sh's symlink farm (#244); $proj's ANSWER_CHANNEL is"
    echo "  not 'issues' so there is no other source here. Not the same as"
    echo "  nothing being open -- check $proj's own QUESTIONS.md directly."
  else
  echo "-- open questions ($SCHED_ROOT/questions/$proj.md) --"
  local qfile="$SCHED_ROOT/questions/$proj.md"
  if [ -f "$qfile" ]; then
    # Same unanswered/resolved logic as cmd_glance's awk block, but prints
    # the actual bullet text instead of just a count -- a deep-dive on one
    # project should show you the question, not send you to go open it.
    #
    # What it prints is the entry's BOLD SPAN, not its opening line
    # (fixed 2026-07-28). The old code did `buf=$0` at the bullet header
    # and never appended, so it printed line 1 and nothing else -- which
    # under the old hand-typed convention was the date and provenance,
    # rendering every question as an indistinguishable stub. `scheduler
    # ask` now generates entries with the question inside a bold span
    # that closes on the opening line, so the span IS the question.
    # A legacy entry whose `**` never closes on that line is printed
    # as-is and LABELLED, so the shortfall is visible here rather than
    # looking like a question that just happens to read badly.
    local unanswered
    unanswered="$(awk '
      function flush() {
        if (!started || is_resolved || has_reply) return
        if (match(buf, /^- \*\*.*\*\*/)) {
          span = substr(buf, 5, RLENGTH - 6)
          if (match(buf, /`q-[0-9a-f]+`/))
            print span "  [" substr(buf, RSTART + 1, RLENGTH - 2) "]"
          else
            print span
        } else {
          print buf "   <-- hand-written entry: question not in a closing bold span"
        }
      }
      BEGIN { infence=0; dead=0 }
      /^```/ { infence = !infence; next }
      infence { next }
      # Section-aware (2026-07-28). A `## Consumed` / `## Recently
      # resolved` ledger is ARCHIVE, not open questions -- without this
      # every one-line ledger entry rendered as an open question whose
      # text was just a date. Caught by running it, not by reading it.
      /^## / {
        flush()
        dead = (tolower($0) ~ /consumed|resolved|archive/) ? 1 : 0
        started=0
        next
      }
      dead { next }
      /^- \*\*/ {
        flush()
        started=1
        # Keyword sniffing applies to LEGACY entries only. A generated
        # entry (`q-xxxxxx`) is deleted on resolution, so its presence
        # already means open -- and sniffing broke it: the first question
        # filed through `scheduler ask` disappeared from this view because
        # the question itself contained the word "resolved".
        if ($0 ~ /`q-[0-9a-f]+`/)
          is_resolved = 0
        else
          is_resolved = (tolower($0) ~ /resolved|acknowledged/) ? 1 : 0
        has_reply=0; buf=$0
        next
      }
      started && /^[ \t]*>[ \t]?/ {
        line=$0
        sub(/^[ \t]*>[ \t]?/, "", line)
        if (line !~ /^\(answer inline here\)/) has_reply=1
      }
      END { flush() }
    ' "$qfile")"
    if [ -n "$unanswered" ]; then
      printf '%s\n' "$unanswered"
    else
      echo "none open"
    fi
  else
    echo "no QUESTIONS.md symlink found"
  fi
  fi

  echo
  local state_acct state_dir
  state_acct="$(state_account "$proj")"
  state_dir="$(state_home "$state_acct")/.local/share/$job_name"
  if [ -n "$state_acct" ]; then
    echo "-- last scheduled run ($job_name, runs as $state_acct) --"
  else
    echo "-- last scheduled run ($job_name) --"
  fi
  local log="$state_dir/sweep.log"
  # sweep.log is what lib/sweep-loop-common.sh writes. Older per-project
  # wrappers (aedile's, on svc-vaporwave) write run.log with `==== `
  # markers instead -- read that rather than reporting "never run".
  if [ -n "$job_name" ] && [ -n "$state_acct" ] && ! state_readable "$state_acct"; then
    echo "BLIND: this job runs as '$state_acct' (CRON_ACCOUNT) and this account cannot read its state under $state_dir -- 'sudo -n -u $state_acct' failed. Nothing is claimed here about whether it ran; check from $state_acct."
  elif [ -n "$job_name" ] && { state_exists "$state_acct" "$log" || { log="$state_dir/run.log"; state_exists "$state_acct" "$log"; }; }; then
    local expires
    if state_exists "$state_acct" "$state_dir/expires_at"; then
      expires="$(state_cat "$state_acct" "$state_dir/expires_at")"
      if [[ "$(date -Is)" > "$expires" ]]; then
        echo "EXPIRED $expires -- dead-man switch tripped; renew: rm $state_dir/expires_at (next run re-stamps now+EXPIRY_DAYS; bumping EXPIRY_DAYS alone does not renew)"
      else
        echo "expires: $expires"
      fi
    fi
    # $log accumulates every run. Scope ALL per-run greps to the LAST run's
    # slice -- from the final "=== <timestamp> ===" start marker onward --
    # so a WARNING/push-reason from an old, since-resolved run is never
    # re-reported as current (that stale re-report cost real diagnosis time
    # twice on 2026-07-25), and so the lines shown always come from the
    # same run instead of a mix of runs. If no start marker exists (never
    # true for logs sweep-loop-common.sh wrote), the slice is the whole log.
    #
    # `===+` (not a literal `=== `) so both marker dialects are read: the
    # engine's `=== <ts> ===` and the older wrappers' `==== <ts> ... ====`.
    local last_run
    last_run="$(state_cat "$state_acct" "$log" | awk '/^===+ [0-9]{4}-[0-9]{2}-[0-9]{2}T/{buf=""} {buf=buf $0 "\n"} END{printf "%s", buf}')"
    if ! printf '%s' "$last_run" | grep -qE '^===+ (done|FAILED|skipped)'; then
      # Start marker but no completion line: still running, or cut off
      # before its EXIT trap could write one (scheduler sweep's stranded-run
      # pass tells those apart). Say so rather than silently showing an
      # older run's lines as if they were current.
      echo "last run started $(printf '%s' "$last_run" | head -1 | sed 's/^===* //; s/ ===*$//') -- no completion line yet (still running, or cut off; see scheduler sweep)"
    fi
    printf '%s' "$last_run" | grep -E '^===+ (done|FAILED|skipped)' | tail -1
    printf '%s' "$last_run" | grep '^pushed:' | tail -1
    printf '%s' "$last_run" | grep '^WARNING: local commit made but NOT pushed' | tail -1
    printf '%s' "$last_run" | grep '^push reason:' | tail -1
    # Only meaningful for the CURRENT state of the job, so gate it on the
    # last run's status line also being FAILED -- a CRITICAL auth line from
    # a long-fixed lapse shouldn't keep showing.
    if printf '%s' "$last_run" | grep -E '^===+ (done|FAILED|skipped)' | tail -1 | grep -qE '^===+ FAILED'; then
      printf '%s' "$last_run" | grep '^CRITICAL: claude authentication failure' | tail -1
    fi
  elif [ -n "$job_name" ]; then
    echo "no log yet at $state_dir/sweep.log (nor run.log)"
  else
    echo "no BATCH job name in this project's conf -- nothing to read"
  fi
}

cmd_status() {
  local proj="$1" mode="${2:-}"
  case "$mode" in
    ""|--claude|--interactive|-I) ;;
    *) echo "scheduler: unknown status flag '$mode' (use --claude or --interactive)" >&2; exit 2 ;;
  esac

  local repo_path
  repo_path="$(conf_field "$proj" PROJECT_REPO_PATH)"
  if [ -z "$repo_path" ]; then
    echo "scheduler: no such project '$proj', or it has no PROJECT_REPO_PATH set" >&2
    exit 1
  fi
  mark_seen "$proj"

  local job_name
  job_name="$(conf_field "$proj" BATCH_JOB_NAME)"
  [ -n "$job_name" ] || job_name="$(conf_field "$proj" SWEEP_JOB_NAME)"

  local report
  report="$(build_status_report "$proj" "$repo_path" "$job_name")"
  printf '%s\n' "$report"

  case "$mode" in
    --claude)
      echo
      echo "--- claude summary (read-only, --allowedTools Read,Grep,Glob) ---"
      (cd "$repo_path" && claude -p "$(cat <<EOF
Here is an offline status report for the "$proj" project, generated by
plain scripts (git status, pending human-feedback tags, open questions,
last automated run's log) -- no code was read yet.

$report

Skim the project's own README/FOCUS.md if useful, then write a short
(5 bullets max) human-readable status note: what's actually going on,
anything that looks off or needs attention, anything safe to ignore.
EOF
)" --allowedTools "Read,Grep,Glob" --max-turns 15)
      ;;
    --interactive|-I)
      echo
      echo "launching interactive claude session in $repo_path, preloaded with the report above..."
      cd "$repo_path" || exit 1
      exec claude "$report

Use this as your starting context for looking into $proj -- feel free to dig into the actual code/repo from here."
      ;;
  esac
}

case "${1:-}" in
  ""|glance) cmd_glance ;;
  focus|-f)
    require_project focus "${2:-}"
    if [ ! -d "$SCHED_ROOT/focus" ]; then
      # Same BLIND framing as cmd_next: the local focus/*.md
      # mirror was retired with sync-crontab.sh's symlink farm (#244) and
      # nothing replaced the cross-account read, so this call site fails
      # unconditionally now -- fail loud with the reason instead of
      # open_file's generic "no file yet", which reads as "$2 has no
      # backlog" rather than "this command can no longer see one".
      echo "scheduler focus: cannot read -- the local focus/*.md mirror was" >&2
      echo "  retired with sync-crontab.sh's symlink farm (#244); this is BLIND," >&2
      echo "  not '$2 has no FOCUS.md'. See $2's own repo directly." >&2
      exit 1
    fi
    open_file "$SCHED_ROOT/focus/$2.md"
    ;;
  questions|-q)
    # No project = the questions overview, not require_project's bare
    # name dump (see cmd_questions_list). Deliberately does NOT mark_seen:
    # reading a count is not reading the questions, so `*` survives until
    # you actually open the file.
    if [ -z "${2:-}" ]; then cmd_questions_list; exit $?; fi
    mark_seen "$2"
    # Same command, same fingers: a project whose answer channel is GitHub
    # issues gets the rendered-fresh buffer instead of the stale symlink.
    if [ "$(answer_channel "$2")" = "issues" ]; then
      cmd_questions_issues "$2"
      exit $?
    fi
    if [ ! -d "$SCHED_ROOT/questions" ]; then
      # Same BLIND framing as the focus verb above: the local
      # questions/*.md mirror was retired with sync-crontab.sh's symlink
      # farm (#244), so falling through to open_file's generic "no file
      # yet at ..." reads as "$2 has no QUESTIONS.md" rather than "this
      # command can no longer see one" (#396).
      echo "scheduler questions: cannot read -- the local questions/*.md mirror" >&2
      echo "  was retired with sync-crontab.sh's symlink farm (#244); this is" >&2
      echo "  BLIND, not '$2 has no QUESTIONS.md'. See $2's own repo directly." >&2
      exit 1
    fi
    open_file "$SCHED_ROOT/questions/$2.md"
    ;;
  report|-r)
    require_project report "${2:-}"
    open_file "$REPORTS_ROOT/$2/LATEST.md"
    ;;
  idea|-i) cmd_idea "${2:-}" "${3:-}" ;;
  ask) cmd_ask "${2:-}" "${3:-}" ;;
  next|-n) cmd_next "${2:-}" ;;
  run) cmd_run "${2:-}" ;;
  weight) cmd_weight "${2:-}" "${3:-}" ;;
  paced|-p) open_file "$PACED_CONF" ;;
  pacing) shift; cmd_pacing "$@" ;;
  man|-m) cmd_man ;;
  _commit-file)
    # Internal, not a documented user-facing verb (leading underscore
    # matches the schedule/_*.conf "meta, not a project" convention) --
    # the vim auto-commit hook's own entrypoint into cmd_commit_file, so
    # there's exactly one implementation of "safely commit one file with
    # a staleness check" for both callers to share.
    cmd_commit_file "${2:-}" "${3:-}"
    ;;
  sweep|-s) cmd_sweep ;;
  status|-c)
    require_project status "${2:-}"
    cmd_status "$2" "${3:-}"
    ;;
  -h|--help|help) usage ;;
  *)
    # Bare project name shorthand (2026-07-25, FOCUS.md backlog "direct
    # shorthand" item): `scheduler <project>` == `scheduler status
    # <project>` -- so a truncated combined view doesn't require
    # remembering `-f`/`-q`/`-r`/`status` separately. Only takes over when
    # $1 is an actually-registered project name; anything else still hits
    # the same "unknown command" error as before.
    # Capture first (not `projects | grep -qx`) -- under `set -o
    # pipefail`, grep -q's early exit on a match sends SIGPIPE to
    # `projects`' still-writing `echo`, and pipefail then reports the
    # pipeline as failed even though grep matched. Same SIGPIPE-guard
    # class of bug this repo's build discipline calls out elsewhere.
    all_projects="$(projects)"
    if grep -qx -- "$1" <<<"$all_projects"; then
      cmd_status "$1" "${2:-}"
    else
      echo "scheduler: unknown command '$1'" >&2; usage; exit 2
    fi
    ;;
esac
