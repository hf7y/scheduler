#!/usr/bin/env bash
# Generic entrypoint -- run one project/tier's job entirely from its
# schedule/<project>.conf, with NO per-project wrapper script.
#
#   scheduler-run <project> <sweep|batch>
#
# Replaces the old ~/.local/bin/<project>-<tier>-loop.sh files: those did
# nothing but set a handful of variables and `source` the shared engine.
# That handful of variables now lives in schedule/<project>.conf (the same
# file bin/sync-crontab.sh already reads for scheduling), so a project is
# ONE file again -- the conf -- instead of a conf here plus a wrapper in
# ~/.local/bin whose JOB_NAME had to be kept in sync by hand.
#
# BACKWARDS COMPATIBLE: a tier whose conf still sets <TIER>_SCRIPT keeps
# using that legacy wrapper (bin/sync-crontab.sh points cron straight at it
# and never calls this script for that tier). This entrypoint only runs for
# a tier that has moved its runtime config into the conf. See MIGRATION.md.

set -uo pipefail

SCHED_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PROJECT="${1:?usage: scheduler-run <project> <sweep|batch>}"
TIER_ARG="${2:?usage: scheduler-run <project> <sweep|batch>}"

case "$TIER_ARG" in
  sweep) PREFIX="SWEEP"; TIER="bug-sweep" ;;
  batch) PREFIX="BATCH"; TIER="nightly-batch" ;;
  *) echo "scheduler-run: tier must be 'sweep' or 'batch', got '$TIER_ARG'" >&2; exit 2 ;;
esac

# Migration abort handle (2026-07-29, M1(a)). Checked HERE as well as in the
# paced runner, deliberately: M1(a) requires the freeze be honoured at DISPATCH
# by each consumer, "not merely honored by the runner, or a directly-invoked
# wrapper bypasses it". This is the path a hand-run or cron-run job takes.
if ! "$SCHED_ROOT/bin/freeze-check.sh" "$PROJECT"; then
  echo "scheduler-run: refusing to run $PROJECT $TIER_ARG -- dispatch is FROZEN" >&2
  exit 3
fi

CONF="$SCHED_ROOT/schedule/$PROJECT.conf"
[ -f "$CONF" ] || { echo "scheduler-run: no such conf: $CONF" >&2; exit 2; }
# shellcheck disable=SC1090
source "$CONF"

# Indirect fetch of a <PREFIX>_<NAME> conf field; empty string if unset.
field() { local v="${PREFIX}_$1"; printf '%s' "${!v:-}"; }

JOB_NAME="$(field JOB_NAME)"
[ -n "$JOB_NAME" ] || { echo "scheduler-run: ${PREFIX}_JOB_NAME not set in $CONF -- tier '$TIER_ARG' isn't enabled for $PROJECT" >&2; exit 2; }

# If this tier still has a legacy wrapper, running it through scheduler-run
# would double up the config. sync-crontab.sh already avoids this (it points
# cron at the wrapper directly), but guard anyway in case of a manual call.
if [ -n "$(field SCRIPT)" ]; then
  echo "scheduler-run: ${PREFIX}_SCRIPT is set in $CONF -- that legacy wrapper is authoritative for tier '$TIER_ARG'; run it directly, or remove ${PREFIX}_SCRIPT to migrate onto scheduler-run (see MIGRATION.md)" >&2
  exit 2
fi

PROMPT="$(field PROMPT)"
[ -n "$PROMPT" ] || { echo "scheduler-run: ${PREFIX}_PROMPT not set in $CONF (required once ${PREFIX}_SCRIPT is removed)" >&2; exit 2; }

# Standing rules: prepended here, not retyped into each conf's PROMPT.
# Witness: tests/standing-rules-witness.sh.
#
# Commit 9cfd130 (2026-08-07) hand-typed an identical "STANDING RULES"
# block (rules 0-5) into THREE separate BATCH_PROMPT strings -- ecosim,
# vim-arcade, bibliothecaire -- as independent copy-pasted text. There was
# no single source of truth: changing a rule meant re-typing it into every
# conf again, by hand or by another one-off script, and hoping nobody
# missed one. schedule/_standing-rules.md is now that one place.
#
# AT THE TRUE HEAD, which is a behaviour change from 9cfd130 and an
# intended one. That commit inserted the block mid-sentence, splitting
# ecosim's "Your role in the backlog-as-sensor build is" from its own
# predicate "MONITORING THE NUMBERS AND THE FEEDBACK" -- a dangling
# sentence in a dispatched agent's prompt. Removing the inlined copy
# rejoins it. And the block's first line reads "These override everything
# below": prepending is the only position at which that sentence is true,
# so the old placement did not merely read badly, it made rule text lie.
#
# EDITING IT NEEDS NO SPECIAL DOOR, and that is deliberate. Branch, edit,
# PR against main, `gh pr merge --auto --squash` -- the same path as any
# other file here. #71 originally shipped a 263-line `bin/propage` verb to
# wrap exactly that; it was cut before merge because its first live
# `--dry-run` printed "OK", exited 0, and left the caller on the throwaway
# branch it made with the edit still staged (both git errors were sent to
# /dev/null), and because the two jobs it did for real -- run the witness
# before pushing, then poll mergeability -- are what CI (#91) and the
# required `suites` check do on the merge result, which is the thing that
# actually matters. See #72.
#
# WHY THIS IS SAFER THAN THE PROSE IT REPLACED, not just tidier: inside a
# conf this text was the right-hand side of BATCH_PROMPT="...", so a
# backtick or $(...) in it EXECUTED at `source` time -- the hazard
# tests/conf-sources-clean-witness.sh exists to catch. Read from a .md by
# $(cat ...) into a variable, the same characters are inert; nothing here
# evals PROMPT. The extraction removed a code-execution surface.
#
# PER-TIER, FALLING BACK TO PER-PROJECT. <PREFIX>_USES_STANDING_RULES wins
# if the conf sets it, else the unprefixed project-level field (like
# AUTONOMY_TIER). Project-level alone was correct only by accident: no conf
# arms SWEEP today, so "applies to whichever tier is dispatching" and
# "applies to batch" are the same sentence right now. The day a project
# arms SWEEP, they stop being, and the wrong answer would be silent. Three
# lines to make the distinction expressible beats a comment promising to
# revisit it.
#
# Opt-IN, never automatic: chezz, crt, baudin and friends never had this
# text and prepending it to them would change their prompt's meaning as a
# side effect of an unrelated engine change. Only a conf that asks gets it.
#
# NOT REACHABLE from the legacy <TIER>_SCRIPT path -- that wrapper never
# sources the conf, so it has no field to read. One tier is affected,
# scheduler.conf's own BATCH_SCRIPT, and it does not want these rules; it
# is the dev-cycle job, whose prompt lives in the wrapper. Accepted as a
# known gap rather than papered over: the fix is migrating that tier off
# the wrapper (MIGRATION.md), not a second hook into a path being retired.
RULES_OPT="$(field USES_STANDING_RULES)"
[ -n "$RULES_OPT" ] || RULES_OPT="${USES_STANDING_RULES:-0}"
if [ "$RULES_OPT" = "1" ]; then
  RULES_FILE="$SCHED_ROOT/schedule/_standing-rules.md"
  if [ -f "$RULES_FILE" ]; then
    PROMPT="$(cat "$RULES_FILE")

$PROMPT"
  else
    echo "scheduler-run: $CONF sets USES_STANDING_RULES=1 but $RULES_FILE is missing" >&2
    exit 2
  fi
fi

# Fragment markers: @@FRAGMENT:<name>@@ anywhere in PROMPT is replaced with
# the verbatim contents of schedule/_<name>.md. Additive alongside
# USES_STANDING_RULES above, not a replacement for it -- that mechanism only
# PREPENDS at the true head, which is right for a block whose own first line
# claims "These override everything below" but wrong for #98's two blocks
# (ecosim.conf/vim-arcade.conf's triage rules and verdict semantics), which
# sit mid-prompt wrapped in project-specific prose on both sides. A boolean
# cannot say where in the middle of a string a block goes; a marker can.
# Witness: tests/fragment-marker-witness.sh.
while [[ "$PROMPT" == *'@@FRAGMENT:'*'@@'* ]]; do
  marker="$(printf '%s' "$PROMPT" | grep -oE '@@FRAGMENT:[A-Za-z0-9_-]+@@' | head -1)"
  frag_name="${marker#@@FRAGMENT:}"; frag_name="${frag_name%@@}"
  FRAG_FILE="$SCHED_ROOT/schedule/_$frag_name.md"
  if [ -f "$FRAG_FILE" ]; then
    frag_body="$(cat "$FRAG_FILE")"
    PROMPT="${PROMPT//$marker/$frag_body}"
  else
    echo "scheduler-run: $CONF references $marker but $FRAG_FILE is missing" >&2
    exit 2
  fi
done

# Project-level runtime config (shared by both tiers).
PROJECT_KEY="${PROJECT_KEY:-$PROJECT}"
: "${REPO_URL:?scheduler-run: REPO_URL must be set in $CONF}"
REPO_SUBDIR="${REPO_SUBDIR:-.}"
# SECRETS_SRC_DIR / SECRETS_DEST_SUBDIR (optional) are already in scope from
# sourcing the conf, if it set them; the engine defaults them otherwise.

# Optional per-tier knobs -- only keep them set when the conf actually gave
# a value, so the engine's own defaults apply otherwise.
for knob in MAX_TURNS MODEL ALLOWED_TOOLS PRECHECK_CMD EXPIRY_DAYS BRANCH; do
  val="$(field "$knob")"
  if [ -n "$val" ]; then
    printf -v "$knob" '%s' "$val"
  else
    unset "$knob" 2>/dev/null || true
  fi
done

# AUTONOMY_TIER (see lib/autonomy-merge.sh) is project-level, not per-tier
# like the knobs above -- it comes straight from the conf's own unprefixed
# field, already in scope from `source "$CONF"`. PREFIX is exported too so
# sweep-loop-common.sh doesn't have to re-derive it from TIER's free-form
# label -- only the legacy-wrapper path (which never sources the conf, and
# so never has PREFIX) needs that fallback.
: "${AUTONOMY_TIER:=}"

# ---------------------------------------------------------------------------
# GH_TOKEN -- mint a one-hour GitHub App installation token, when this account
# is wired for one. Witness: tests/gh-app-token-witness.sh.
#
# WHY THIS IS HERE AND NOT LEFT TO `gh`. Without it, `gh` uses whatever
# long-lived token happens to sit in the account's own ~/.config/gh/hosts.yml,
# and those drift per account with nothing comparing them. Measured on monkey
# 2026-08-11, three armed accounts, three different answers:
#
#     vim-arcade      gho_...            pulls API works
#     bibliothecaire  gho_...            pulls API works
#     ecosim          github_pat_11A...  403 on the ENTIRE Pull-requests API
#
# ecosim's fine-grained PAT was missing the Pull requests permission, so it was
# refused on READ as well as write. It did correct work on 2026-08-09 and again
# on 08-11, pushed branch `port-self-dev-checks` with green tests, and could
# not open a pull request for any of it.
#
# THE PART WORTH FIXING IS THE SILENCE, not the permission. `gh issue list`
# kept working, so the brief's first step succeeded and every run looked
# healthy right up to the step that mattered. Nothing in the engine had an
# opinion about which credential an account carried, so the account whose token
# had rotted was the last to find out.
#
# An installation token expires in an hour and is minted from a key on demand
# -- see realisateur's bin/selfdev-gh-app.sh and its own "WHY A TOKEN AND NOT A
# PAT". Minting here means every account draws the same credential from the
# same source, once per dispatch, instead of from ten files nobody diffs.
#
# FAIL-OPEN WHEN UNCONFIGURED, FAIL-LOUD WHEN BROKEN. An account with no
# gh-app.conf keeps whatever auth it already had: this must never take a
# working credential away from an account that has one, which today is every
# account but ecosim. But a mint that is CONFIGURED and then FAILS says so on
# stderr instead of silently falling back, because a silent fallback is
# indistinguishable from the unconfigured case -- and that indistinguishability
# is precisely what cost ecosim two days.
# ---------------------------------------------------------------------------
GH_APP_HELPER="${SELFDEV_GH_APP_SH:-$HOME/.local/libexec/selfdev/selfdev-gh-app.sh}"
GH_APP_CONF="${SELFDEV_APP_CONF:-$HOME/.config/selfdev/gh-app.conf}"
if [ -z "${GH_TOKEN:-}" ] && [ -f "$GH_APP_CONF" ] && [ -x "$GH_APP_HELPER" ]; then
  if _gh_tok="$(SELFDEV_APP_CONF="$GH_APP_CONF" "$GH_APP_HELPER" --token 2>/dev/null)" \
     && [ -n "$_gh_tok" ]; then
    # ------------------------------------------------------------------
    # A MINTED TOKEN IS NOT A USEFUL TOKEN, and the first version of this
    # block confused the two. It checked only that the helper printed
    # something -- which is "it produced output", not "it works", and that
    # is the exact conflation this whole day was spent removing elsewhere.
    #
    # Found within an hour of arming, by the account it broke, and filed as
    # hf7y/realisateur#175. The App `unattended-monkey` is installed on TEN
    # repositories -- the ten product projects -- and hf7y/realisateur and
    # hf7y/scheduler are NOT among them:
    #
    #   $ gh api /installation/repositories -q '.repositories[].full_name'
    #   chezz baudin gardien bibliothecaire crt ecosim groc-mangr
    #   nine-speakers sequestria vim-arcade
    #
    # So on realisateur@monkey and scheduler@monkey the mint SUCCEEDS and
    # hands back a token that 404s on the account's own repository. Exporting
    # it OVERRODE a working stored credential and made every `gh` call fail,
    # until the agent unset it by hand. The mint was a regression for exactly
    # the two accounts added the same day.
    #
    # scheduler being PUBLIC is what made it hard to see: public-repo reads
    # do not need installation scope, so scheduler@monkey's reads 200 by
    # accident while its writes would not. realisateur is private and 404s
    # outright. One symptom, two different lies.
    #
    # So: probe the account's OWN repo before exporting. Fail-open to the
    # stored credential, loudly. This cannot fix the scope -- widening the
    # installation is a browser click only Zach can make (#175) -- but it
    # stops the mint from being worse than not minting.
    # ------------------------------------------------------------------
    _gh_own="${GH_OWN_REPO:-hf7y/$PROJECT}"
    if GH_TOKEN="$_gh_tok" gh api "repos/$_gh_own" --jq .full_name >/dev/null 2>&1; then
      GH_TOKEN="$_gh_tok"
      export GH_TOKEN
      echo "scheduler-run: minted a GitHub App installation token for $(id -un) (verified against $_gh_own)" >&2
    else
      echo "scheduler-run: WARNING -- minted an App token for $(id -un), but it cannot see $_gh_own, so it was NOT exported. The App installation does not cover that repository; widening it is a browser click (hf7y/realisateur#175). Falling back to this account's stored gh auth, which is what the account was using before." >&2
    fi
    unset _gh_own
  else
    echo "scheduler-run: WARNING -- $GH_APP_CONF exists but '$GH_APP_HELPER --token' produced nothing. Falling back to this account's stored gh auth, which is the credential shape that stranded ecosim's work for two days. Check it before trusting this run's PR steps." >&2
  fi
  unset _gh_tok
fi

export JOB_NAME PROJECT_KEY TIER PREFIX REPO_URL REPO_SUBDIR PROMPT AUTONOMY_TIER

# shellcheck disable=SC1091
source "$SCHED_ROOT/lib/sweep-loop-common.sh"
