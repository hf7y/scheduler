# Schedule entry template -- copy to ../schedule/<project>.conf, fill in.
#
# ONE FILE per project. This conf is the single source of truth for *how*
# each job runs (the runtime fields) -- ../bin/scheduler-run reads them and
# sources ../lib/sweep-loop-common.sh, so there is no separate per-project
# wrapper script to write or keep in sync.
#
# It is NOT the source of truth for *when*/*whether* Tier 2 fires any more --
# ../bin/sync-crontab.sh, which used to read the CRON fields below and write
# per-project crontab lines, was retired (#454/#488). "Registering" a Tier 2
# project today is dropping this file, landing it, enrolling it into the
# paced rotation (../bin/enrole-selfdev.sh <project> --apply), a human
# adding its "<project>|account@host|rate|parked" row to ../schedule/ROSTER
# by hand (dose --arm below only flips an EXISTING row -- it exits GAP for
# a project the roster doesn't name yet), then ../bin/dose-project.sh
# <project> --arm (human-only, opens a self-merging PR) and --apply once
# that merges. See ../README.md's "Registering a project" section for the
# full sequence. Deregistering: dose --park, then delete this file and
# enrole-selfdev.sh --retire.
#
# Tier 1 (SWEEP_CRON below) has no automated installer at all since
# sync-crontab.sh's retirement -- add its crontab line by hand, tagged
# "# scheduler:<project>:SWEEP".
#
# Two registries, don't conflate (see README):
#   - THIS file = the config-time "which hours does this project run"
#     registry.
#   - lib/sweep-loop-common.sh's ~/.local/share/scheduler-registry/ =
#     the runtime PROJECT_KEY mutex that stops a project's own Tier 1 and
#     Tier 2 from racing each other's git push if both are already running.

PROJECT="<project-name>"

# Optional -- this project's real working copy, if it has one. Leave blank
# for a project with no local working copy in this shape.
PROJECT_REPO_PATH="/home/zach/Documents/Project Archive/<project>"

# Subdirectory (within PROJECT_REPO_PATH) holding this project's own
# scheduler-owned files. Retired surface: the FOCUS.md/QUESTIONS.md channel
# it named was sunset by #66/#234 and the queue is the repo's GitHub issues.
# Kept only so an old conf still parses.
SCHEDULER_SUBDIR=".scheduler"

# ===========================================================================
# RUNTIME CONFIG (read by bin/scheduler-run; ignored for a tier that still
# sets a legacy *_SCRIPT below).
# ===========================================================================

# Short, unique PER PROJECT (not per tier). A project's Tier 1 and Tier 2
# share this key -- that's what lets them detect and skip around each other.
# Defaults to PROJECT if left blank.
PROJECT_KEY="<project-name>"

# git clone URL (SSH -- cron has no ssh-agent, so use a passphrase-less
# per-repo deploy key + a ~/.ssh/config host alias) for the dedicated,
# disposable clone the job runs in.
REPO_URL="git@github-<project>-deploy:<owner>/<repo>.git"

# Subdirectory within the clone to cd into before invoking claude. "." if
# the project IS the repo root.
REPO_SUBDIR="."

# Optional -- a local dir of non-git secrets (tokens, keypairs) gitignored
# by design, copied into the clone every run so a fresh clone still has
# them. Leave blank/omit to disable.
# SECRETS_SRC_DIR="/home/zach/Documents/Project Archive/<project>/.session-handoff"
# SECRETS_DEST_SUBDIR=".session-handoff"

# ===========================================================================
# TIER 1 -- bug sweeper. Leave SWEEP_JOB_NAME blank to skip this tier.
# ===========================================================================

SWEEP_JOB_NAME="<project>-bug-sweep"   # names this job's state/expiry dir
                                         # (~/.local/share/$SWEEP_JOB_NAME)
SWEEP_CRON="*/15 9-21 * * *"           # fixed daytime window -- fill in real
                                         # hours, don't ship the placeholder.
                                         # Nothing installs this into a
                                         # crontab any more (sync-crontab.sh
                                         # is gone, #488) -- add the line by
                                         # hand, tagged
                                         # "# scheduler:<project>:SWEEP".

# --- new-style runtime config (used when SWEEP_SCRIPT is blank) ---
SWEEP_PROMPT="/bug-sweep

This is a fully unattended run with no human review step. Commit and push
your fixes yourself. Never resolve or reclassify a report you are not
confident about; leave it open with a note instead."
SWEEP_MAX_TURNS=40
# SWEEP_MODEL="claude-sonnet-5"                       # cheaper model for a mechanical sweep
# SWEEP_PRECHECK_CMD="/home/zach/.local/bin/<project>-bug-sweep-precheck.sh"
# SWEEP_ALLOWED_TOOLS="Bash,Read,Write,Edit,Glob,Grep"
# SWEEP_EXPIRY_DAYS=7
# SWEEP_BRANCH="main"

# --- LEGACY (backwards-compat): if set, this wins and the runtime fields
# above are ignored for Tier 1. Drop it to migrate onto scheduler-run. ---
# SWEEP_SCRIPT="/home/zach/.local/bin/<project>-bug-sweep-loop.sh"

# ===========================================================================
# TIER 2 -- overnight batch. Leave BATCH_JOB_NAME blank to skip this tier.
# ===========================================================================

BATCH_JOB_NAME="<project>-nightly-batch"
BATCH_CRON="auto"                       # vestigial: "auto" used to let
                                         # bin/sync-crontab.sh assign a
                                         # staggered slot. That script is gone
                                         # (#488) and nothing installs a batch
                                         # tier into cron any more -- dispatch
                                         # is via bin/scheduler-run under the
                                         # paced runner, which ignores this
                                         # field entirely.

# --- new-style runtime config (used when BATCH_SCRIPT is blank) ---
BATCH_PROMPT="/nightly-batch

This is a fully unattended overnight run. Read the open issues FIRST --
\`gh issue list --repo hf7y/<project> --state open\` is the queue, and
everything tonight is scoped by it. Write your report to
~/reports/<project>/\$(date +%Y-%m-%dT%H%M).md, then symlink
~/reports/<project>/LATEST.md to point at that exact file instead of
writing a second copy. Confirm everything is committed and
pushed before finishing."
BATCH_MAX_TURNS=200
# BATCH_MODEL="claude-opus-4-8"
# BATCH_PRECHECK_CMD="..."
# BATCH_ALLOWED_TOOLS="Bash,Read,Write,Edit,Glob,Grep"
# BATCH_EXPIRY_DAYS=7
# BATCH_BRANCH="main"

# --- LEGACY (backwards-compat): drop to migrate onto scheduler-run. ---
# BATCH_SCRIPT="/home/zach/.local/bin/<project>-nightly-batch-loop.sh"

# ===========================================================================
# DEPLOY FRESHNESS (optional) -- for a project whose nightly commits + pushes
# but whose *live* deploy is a step a human runs by hand (e.g. an interactive
# clasp/publish auth the unattended job can't do). Without this, a
# code-shipping night that files no question leaves the live site silently
# behind origin. Set all three and bin/morning-report.sh will probe each
# morning and, when stale, print a prominent "DEPLOY PENDING" line.
# ===========================================================================
# DEPLOY_FRESH_CMD is the probe: it must exit 0 when live is up to date and
# NON-ZERO when a deploy is pending. Keep it cheap (a single HTTP GET). E.g.
# vkv-inventory's ?scope=sweep-status returns JSON when fresh, HTML when stale:
# DEPLOY_FRESH_CMD="curl -fsS 'https://.../exec?scope=sweep-status' | grep -q '^[[:space:]]*{'"
# DEPLOY_CMD is the exact command to run to deploy, printed in that line:
# DEPLOY_CMD="cd /path/to/<project> && tools/deploy.sh"
# LIVE_URL is optional context printed alongside:
# LIVE_URL="https://script.google.com/.../exec"
